  [hidden] {
    display: none !important;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (max-width: 48rem) {
    .field-grid--two,
    .choice-grid,
    .choice-grid--two {
      grid-template-columns: 1fr;
