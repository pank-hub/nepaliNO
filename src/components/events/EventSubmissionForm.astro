  .field input:not([type='checkbox']):not([type='radio']), .field select { min-height: 2.9rem; padding: .6rem .75rem; }
  .field textarea { min-height: 6.5rem; padding: .7rem .75rem; resize: vertical; }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: var(--civic); }
