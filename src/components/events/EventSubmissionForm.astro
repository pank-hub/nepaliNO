    .submit-button { width: 100%; }
  }
  @media (max-width: 32rem) {
    .form-section { padding: 1rem; }
    .form-section legend { align-items: flex-start; font-size: 1.15rem; }
    .before-you-begin { grid-template-columns: 1fr; }
  }
</style>
