  .form-alert--error ul { margin-block-start: .65rem; }
  .form-alert--error a { color: #7a271a; font-weight: 700; }
  .form-alert--success { border-color: #a6e2bd; background: #ecfdf3; }
  .success-symbol { display: grid; width: 2.6rem; height: 2.6rem; place-items: center; border-radius: 999px; background: var(--success); color: #fff; font-weight: 800; }
  .form-alert p { margin-block-start: .4rem; }
  .success-reference { font-weight: 760; overflow-wrap: anywhere; }
  .honeypot { position: absolute !important; width: 1px !important; height: 1px !important; overflow: hidden !important; clip: rect(0 0 0 0) !important; white-space: nowrap !important; }
