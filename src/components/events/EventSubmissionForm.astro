---
import type {
  EventSubmissionCopy,
  EventSubmissionInterfaceLanguage,
} from '../../i18n/eventSubmission'

interface Props {
  language: EventSubmissionInterfaceLanguage
  copy: EventSubmissionCopy
  categories: Readonly<Record<string, string>>
  eventLanguages: Readonly<Record<string, string>>
  registrationRequirements: Readonly<Record<string, string>>
  registrationStatuses: Readonly<Record<string, string>>
}

const {
  language,
  copy,
  categories,
  eventLanguages,
  registrationRequirements,
  registrationStatuses,
} = Astro.props

const idPrefix = `event-submission-${language}`
const requiredMark = '*'
const optionEntries = (options: Readonly<Record<string, string>>) => Object.entries(options)
---

<div
  class="event-submission"
  data-event-submission
  data-language={language}
  data-message-validation-title={copy.messages.validationSummaryTitle}
  data-message-validation-body={copy.messages.validationSummaryBody}
  data-message-required={copy.messages.requiredField}
  data-message-invalid-email={copy.messages.invalidEmail}
  data-message-invalid-url={copy.messages.invalidUrl}
  data-message-invalid-order={copy.messages.invalidOrder}
  data-message-description-short={copy.messages.descriptionTooShort}
  data-message-online-required={copy.messages.onlineAccessRequired}
  data-message-success-title={copy.messages.successTitle}
  data-message-success-body={copy.messages.successBody}
  data-message-success-reference={copy.messages.successReference}
  data-message-publication={copy.messages.publicationNotice}
  data-message-rate-limited={copy.messages.rateLimited}
  data-message-unavailable={copy.messages.temporarilyUnavailable}
  data-message-storage-failed={copy.messages.storageFailed}
  data-message-network-failed={copy.messages.networkFailed}
  data-message-unexpected={copy.messages.unexpectedError}
  data-day-label={copy.fields.dayLabel}
  data-action-submit={copy.actions.submit}
  data-action-submitting={copy.actions.submitting}
>
  <aside
    class="before-you-begin surface"
    aria-labelledby={`${idPrefix}-before-title`}
    data-before-you-begin
  >
    <div class="before-you-begin__mark" aria-hidden="true">✓</div>
    <div>
      <h2 id={`${idPrefix}-before-title`}>{copy.beforeYouBeginTitle}</h2>
      <ul>
        {copy.beforeYouBeginItems.map((item) => <li>{item}</li>)}
      </ul>
      <p class="required-notice">{copy.requiredNotice}</p>
    </div>
  </aside>

  <div class="form-alert form-alert--error" data-error-summary role="alert" tabindex="-1" hidden>
    <h2>{copy.messages.validationSummaryTitle}</h2>
    <p>{copy.messages.validationSummaryBody}</p>
    <ul data-error-list></ul>
  </div>

  <div class="form-alert form-alert--success" data-success-panel role="status" tabindex="-1" hidden>
    <span class="success-symbol" aria-hidden="true">✓</span>
    <div>
      <h2 data-success-title>{copy.messages.successTitle}</h2>
      <p data-success-body>{copy.messages.successBody}</p>
      <p class="success-reference" data-success-reference></p>
      <p>{copy.messages.publicationNotice}</p>
    </div>
  </div>

  <form class="submission-form" data-submission-form novalidate>
    <div class="honeypot" aria-hidden="true">
      <label for={`${idPrefix}-website`}>Website</label>
      <input
        id={`${idPrefix}-website`}
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <input name="formInterfaceLanguage" type="hidden" value={language} />

    <fieldset class="form-section surface">
      <legend><span>1</span>{copy.sections.basics}</legend>
      <div class="field-grid field-grid--two">
        <div class="field field-grid__wide">
          <label for={`${idPrefix}-proposedTitle`}>
            {copy.fields.proposedTitle} <span aria-hidden="true">{requiredMark}</span>
          </label>
          <input
            id={`${idPrefix}-proposedTitle`}
            name="proposedTitle"
            type="text"
            minlength="5"
            maxlength="150"
            required
          />
          <p class="field-error" data-error-for="proposedTitle"></p>
        </div>

        <div class="field">
          <label for={`${idPrefix}-eventType`}>
            {copy.fields.eventType} <span aria-hidden="true">{requiredMark}</span>
          </label>
          <select id={`${idPrefix}-eventType`} name="eventType" required>
            <option value="">—</option>
            {optionEntries(categories).map(([value, label]) => (
              <option value={value}>{label}</option>
            ))}
          </select>
          <p class="field-error" data-error-for="eventType"></p>
        </div>

        <div class="field">
          <label for={`${idPrefix}-eventFormat`}>
            {copy.fields.eventFormat} <span aria-hidden="true">{requiredMark}</span>
          </label>
          <select id={`${idPrefix}-eventFormat`} name="eventFormat" required>
            <option value="in-person">{copy.options.eventFormats.inPerson}</option>
            <option value="online">{copy.options.eventFormats.online}</option>
            <option value="hybrid">{copy.options.eventFormats.hybrid}</option>
          </select>
          <p class="field-error" data-error-for="eventFormat"></p>
        </div>

        <div class="field">
          <label for={`${idPrefix}-startDateTime`}>
            {copy.fields.startDateTime} <span aria-hidden="true">{requiredMark}</span>
          </label>
          <input id={`${idPrefix}-startDateTime`} name="startDateTime" type="datetime-local" required />
          <p class="field-error" data-error-for="startDateTime"></p>
        </div>

        <div class="field">
          <label for={`${idPrefix}-endDateTime`}>{copy.fields.endDateTime}</label>
          <input id={`${idPrefix}-endDateTime`} name="endDateTime" type="datetime-local" />
          <p class="field-error" data-error-for="endDateTime"></p>
        </div>

        <div class="field checkbox-field field-grid__wide">
          <label>
            <input name="isAllDay" type="checkbox" />
            <span>{copy.fields.isAllDay}</span>
          </label>
          <p class="field-error" data-error-for="isAllDay"></p>
        </div>

        <div class="field field-grid__wide additional-dates-box" data-additional-dates-root>
          <div class="additional-dates-box__head">
            <div>
              <span class="field-label">{copy.fields.additionalDates}</span>
              <p class="field-help">{copy.help.additionalDates}</p>
            </div>
            <button
              type="button"
              class="button button-secondary additional-dates-add"
              data-add-date
            >
              {copy.actions.addAnotherDay}
            </button>
          </div>
          <div class="additional-dates-list" data-additional-dates-list></div>
          <template data-additional-date-template>
            <div class="additional-date-row" data-additional-date-row>
              <div class="additional-date-row__head">
                <strong data-day-title></strong>
                <button type="button" class="additional-date-remove" data-remove-date>
                  {copy.actions.removeDay}
                </button>
              </div>
              <div class="field-grid field-grid--two">
                <div class="field">
                  <label data-extra-start-label>
                    {copy.fields.startDateTime} <span aria-hidden="true">{requiredMark}</span>
                  </label>
                  <input type="datetime-local" data-extra-start />
                </div>
                <div class="field">
                  <label data-extra-end-label>{copy.fields.endDateTime}</label>
                  <input type="datetime-local" data-extra-end />
                </div>
              </div>
              <p class="field-error" data-extra-error></p>
            </div>
          </template>
          <p class="field-error" data-error-for="additionalDates"></p>
        </div>
      </div>

      <div class="conditional-panel" data-location-panel="physical">
        <div class="field-grid field-grid--two">
          <div class="field">
            <label for={`${idPrefix}-city`}>
              {copy.fields.city} <span aria-hidden="true">{requiredMark}</span>
            </label>
            <input
              id={`${idPrefix}-city`}
              name="city"
              type="text"
              maxlength="100"
              autocomplete="address-level2"
            />
            <p class="field-error" data-error-for="city"></p>
          </div>

          <div class="field">
            <label for={`${idPrefix}-venueName`}>{copy.fields.venueName}</label>
            <input id={`${idPrefix}-venueName`} name="venueName" type="text" maxlength="180" />
            <p class="field-error" data-error-for="venueName"></p>
          </div>
        </div>
      </div>

      <div class="conditional-panel" data-location-panel="online" hidden>
        <p class="conditional-guidance">{copy.help.onlineAccessRequirement}</p>
        <div class="field-grid field-grid--two">
          <div class="field">
            <label for={`${idPrefix}-onlinePlatform`}>{copy.fields.onlinePlatform}</label>
            <input id={`${idPrefix}-onlinePlatform`} name="onlinePlatform" type="text" maxlength="120" />
            <p class="field-error" data-error-for="onlinePlatform"></p>
          </div>

          <div class="field">
            <label for={`${idPrefix}-onlineInformationUrl`}>{copy.fields.onlineInformationUrl}</label>
            <input
              id={`${idPrefix}-onlineInformationUrl`}
              name="onlineInformationUrl"
              type="url"
              maxlength="2048"
              inputmode="url"
              placeholder="https://"
            />
            <p class="field-error" data-error-for="onlineInformationUrl"></p>
          </div>
        </div>
      </div>

      <div class="field-grid field-grid--two practical-fields">
        <div class="field field-grid__wide">
          <label for={`${idPrefix}-descriptionPlainText`}>
            {copy.fields.descriptionPlainText} <span aria-hidden="true">{requiredMark}</span>
          </label>
          <textarea
            id={`${idPrefix}-descriptionPlainText`}
            name="descriptionPlainText"
            rows="5"
            minlength="30"
            maxlength="10000"
            required
          ></textarea>
          <p class="field-help">{copy.help.descriptionPlainText}</p>
          <p class="field-error" data-error-for="descriptionPlainText"></p>
        </div>

        <div class="field">
          <label for={`${idPrefix}-registrationRequirement`}>
            {copy.fields.registrationRequirement} <span aria-hidden="true">{requiredMark}</span>
          </label>
          <select id={`${idPrefix}-registrationRequirement`} name="registrationRequirement" required>
            {optionEntries(registrationRequirements).map(([value, label]) => (
              <option value={value}>{label}</option>
            ))}
          </select>
          <p class="field-error" data-error-for="registrationRequirement"></p>
        </div>

        <div class="field" data-registration-detail hidden>
          <label for={`${idPrefix}-registrationUrl`}>{copy.fields.registrationUrl}</label>
          <input
            id={`${idPrefix}-registrationUrl`}
            name="registrationUrl"
            type="url"
            maxlength="2048"
            inputmode="url"
            placeholder="https://"
          />
          <p class="field-error" data-error-for="registrationUrl"></p>
        </div>

        <div class="field checkbox-field field-grid__wide">
          <label>
            <input name="isFree" type="checkbox" checked />
            <span>{copy.fields.isFree}</span>
          </label>
          <p class="field-error" data-error-for="isFree"></p>
        </div>

        <div class="field field-grid__wide" data-price-detail hidden>
          <label for={`${idPrefix}-priceDescription`}>
            {copy.fields.priceDescription} <span aria-hidden="true">{requiredMark}</span>
          </label>
          <input id={`${idPrefix}-priceDescription`} name="priceDescription" type="text" maxlength="300" />
          <p class="field-error" data-error-for="priceDescription"></p>
        </div>
      </div>
    </fieldset>

    <fieldset class="form-section surface">
      <legend><span>2</span>{copy.sections.organizer}</legend>
      <p class="section-notice section-notice--private">{copy.privateNotice}</p>
      <div class="field-grid field-grid--two">
        <div class="field field-grid__wide">
          <label for={`${idPrefix}-organizerName`}>
            {copy.fields.organizerName} <span aria-hidden="true">{requiredMark}</span>
          </label>
          <input
            id={`${idPrefix}-organizerName`}
            name="organizerName"
            type="text"
            maxlength="150"
            autocomplete="organization"
            required
          />
          <p class="field-error" data-error-for="organizerName"></p>
        </div>

        <div class="field">
          <label for={`${idPrefix}-privateContactName`}>
            {copy.fields.privateContactName} <span aria-hidden="true">{requiredMark}</span>
          </label>
          <input
            id={`${idPrefix}-privateContactName`}
            name="privateContactName"
            type="text"
            maxlength="120"
            autocomplete="name"
            required
          />
          <p class="field-error" data-error-for="privateContactName"></p>
        </div>

        <div class="field">
          <label for={`${idPrefix}-privateContactEmail`}>
            {copy.fields.privateContactEmail} <span aria-hidden="true">{requiredMark}</span>
          </label>
          <input
            id={`${idPrefix}-privateContactEmail`}
            name="privateContactEmail"
            type="email"
            maxlength="254"
            autocomplete="email"
            required
          />
          <p class="field-error" data-error-for="privateContactEmail"></p>
        </div>

        <div class="field">
          <label for={`${idPrefix}-privateContactPhone`}>{copy.fields.privateContactPhone}</label>
          <input
            id={`${idPrefix}-privateContactPhone`}
            name="privateContactPhone"
            type="tel"
            maxlength="40"
            autocomplete="tel"
          />
          <p class="field-error" data-error-for="privateContactPhone"></p>
        </div>

        <div class="field">
          <label for={`${idPrefix}-publicOrganizerUrl`}>{copy.fields.publicOrganizerUrl}</label>
          <input
            id={`${idPrefix}-publicOrganizerUrl`}
            name="publicOrganizerUrl"
            type="url"
            maxlength="2048"
            inputmode="url"
            placeholder="https://"
          />
          <p class="field-error" data-error-for="publicOrganizerUrl"></p>
        </div>

        <div class="field field-grid__wide checkbox-field">
          <label>
            <input name="publicContactPermission" type="checkbox" />
            <span>{copy.fields.publicContactPermission}</span>
          </label>
          <p class="field-help">{copy.help.publicContactPermission}</p>
          <p class="field-error" data-error-for="publicContactPermission"></p>
        </div>
      </div>
    </fieldset>

    <details class="optional-drawer surface" data-optional-details>
      <summary>
        <span>{copy.sections.optionalDetails}</span>
      </summary>
      <div class="optional-drawer__body">
        <p class="field-help section-help-top">{copy.help.optionalDetails}</p>
        <div class="field-grid field-grid--two">
          <div class="field" data-location-panel="physical">
            <label for={`${idPrefix}-address`}>{copy.fields.address}</label>
            <input id={`${idPrefix}-address`} name="address" type="text" maxlength="200" autocomplete="street-address" />
            <p class="field-error" data-error-for="address"></p>
          </div>

          <div class="field" data-location-panel="physical">
            <label for={`${idPrefix}-postalCode`}>{copy.fields.postalCode}</label>
            <input id={`${idPrefix}-postalCode`} name="postalCode" type="text" maxlength="20" autocomplete="postal-code" />
            <p class="field-error" data-error-for="postalCode"></p>
          </div>

          <div class="field field-grid__wide" data-location-panel="physical">
            <label for={`${idPrefix}-mapUrl`}>{copy.fields.mapUrl}</label>
            <input id={`${idPrefix}-mapUrl`} name="mapUrl" type="url" maxlength="2048" inputmode="url" placeholder="https://" />
            <p class="field-error" data-error-for="mapUrl"></p>
          </div>

          <div class="field" data-registration-detail hidden>
            <label for={`${idPrefix}-registrationStatus`}>{copy.fields.registrationStatus}</label>
            <select id={`${idPrefix}-registrationStatus`} name="registrationStatus">
              {optionEntries(registrationStatuses).map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
            <p class="field-error" data-error-for="registrationStatus"></p>
          </div>

          <div class="field" data-registration-detail hidden>
            <label for={`${idPrefix}-registrationDeadline`}>{copy.fields.registrationDeadline}</label>
            <input id={`${idPrefix}-registrationDeadline`} name="registrationDeadline" type="datetime-local" />
            <p class="field-error" data-error-for="registrationDeadline"></p>
          </div>

          <div class="field field-grid__wide">
            <span class="field-label">{copy.fields.eventLanguages}</span>
            <div class="choice-grid" data-event-language-group>
              {optionEntries(eventLanguages).map(([value, label]) => (
                <label class="choice-card">
                  <input name="eventLanguages" type="checkbox" value={value} />
                  <span>{label}</span>
                </label>
              ))}
            </div>
            <p class="field-error" data-error-for="eventLanguages"></p>
          </div>

          <div class="field field-grid__wide" data-conditional="otherEventLanguage" hidden>
            <label for={`${idPrefix}-otherEventLanguage`}>{copy.fields.otherEventLanguage}</label>
            <input id={`${idPrefix}-otherEventLanguage`} name="otherEventLanguage" type="text" maxlength="80" />
            <p class="field-error" data-error-for="otherEventLanguage"></p>
          </div>

          <div class="field">
            <label for={`${idPrefix}-requestedPublicLanguage`}>{copy.fields.requestedPublicLanguage}</label>
            <select id={`${idPrefix}-requestedPublicLanguage`} name="requestedPublicLanguage">
              <option value="editorial-decision">{copy.options.publicLanguages.editorialDecision}</option>
              <option value="ne">{copy.options.publicLanguages.ne}</option>
              <option value="nb">{copy.options.publicLanguages.nb}</option>
              <option value="both">{copy.options.publicLanguages.both}</option>
            </select>
            <p class="field-error" data-error-for="requestedPublicLanguage"></p>
          </div>

          <div class="field">
            <label for={`${idPrefix}-intendedAudience`}>{copy.fields.intendedAudience}</label>
            <input id={`${idPrefix}-intendedAudience`} name="intendedAudience" type="text" maxlength="300" />
            <p class="field-error" data-error-for="intendedAudience"></p>
          </div>

          <div class="field field-grid__wide">
            <label for={`${idPrefix}-summary`}>{copy.fields.summary}</label>
            <textarea id={`${idPrefix}-summary`} name="summary" rows="2" maxlength="600"></textarea>
            <p class="field-error" data-error-for="summary"></p>
          </div>

          <div class="field field-grid__wide">
            <label for={`${idPrefix}-sourceUrl`}>{copy.fields.sourceUrl}</label>
            <input id={`${idPrefix}-sourceUrl`} name="sourceUrl" type="url" maxlength="2048" inputmode="url" placeholder="https://" />
            <p class="field-error" data-error-for="sourceUrl"></p>
          </div>

          <div class="field field-grid__wide">
            <label for={`${idPrefix}-accessibilityInformation`}>{copy.fields.accessibilityInformation}</label>
            <textarea id={`${idPrefix}-accessibilityInformation`} name="accessibilityInformation" rows="2" maxlength="1000"></textarea>
            <p class="field-error" data-error-for="accessibilityInformation"></p>
          </div>

          <div class="field field-grid__wide" data-location-panel="physical">
            <label for={`${idPrefix}-transportInformation`}>{copy.fields.transportInformation}</label>
            <textarea id={`${idPrefix}-transportInformation`} name="transportInformation" rows="2" maxlength="1000"></textarea>
            <p class="field-error" data-error-for="transportInformation"></p>
          </div>

          <div class="field field-grid__wide">
            <label for={`${idPrefix}-proposedImageUrl`}>{copy.fields.proposedImageUrl}</label>
            <input id={`${idPrefix}-proposedImageUrl`} name="proposedImageUrl" type="url" maxlength="2048" inputmode="url" placeholder="https://" />
            <p class="field-help">{copy.help.proposedImageUrl}</p>
            <p class="field-error" data-error-for="proposedImageUrl"></p>
          </div>

          <div class="field" data-image-permission hidden>
            <label for={`${idPrefix}-imageAltSuggestion`}>{copy.fields.imageAltSuggestion}</label>
            <input id={`${idPrefix}-imageAltSuggestion`} name="imageAltSuggestion" type="text" maxlength="300" />
            <p class="field-error" data-error-for="imageAltSuggestion"></p>
          </div>

          <div class="field" data-image-permission hidden>
            <label for={`${idPrefix}-imageCredit`}>{copy.fields.imageCredit}</label>
            <input id={`${idPrefix}-imageCredit`} name="imageCredit" type="text" maxlength="200" />
            <p class="field-error" data-error-for="imageCredit"></p>
          </div>

          <div class="field field-grid__wide checkbox-field" data-image-permission hidden>
            <label>
              <input name="imagePermissionConfirmed" type="checkbox" />
              <span>{copy.fields.imagePermissionConfirmed}</span>
            </label>
            <p class="field-help">{copy.help.imagePermissionConfirmed}</p>
            <p class="field-error" data-error-for="imagePermissionConfirmed"></p>
          </div>
        </div>
      </div>
    </details>

    <fieldset class="form-section surface declarations-section">
      <legend><span>3</span>{copy.sections.declarations}</legend>
      <div class="declaration-list">
        <div class="field checkbox-field">
          <label>
            <input id={`${idPrefix}-accuracyConfirmed`} name="accuracyConfirmed" type="checkbox" required />
            <span>{copy.fields.accuracyConfirmed} <span aria-hidden="true">{requiredMark}</span></span>
          </label>
          <p class="field-error" data-error-for="accuracyConfirmed"></p>
        </div>

        <div class="field checkbox-field">
          <label>
            <input id={`${idPrefix}-privacyRetentionAccepted`} name="privacyRetentionAccepted" type="checkbox" required />
            <span>{copy.fields.privacyRetentionAccepted} <span aria-hidden="true">{requiredMark}</span></span>
          </label>
          <p class="field-help">{copy.help.privacyRetentionAccepted}</p>
          <p class="field-error" data-error-for="privacyRetentionAccepted"></p>
        </div>
      </div>

      <div class="submit-panel">
        <p>{copy.messages.publicationNotice}</p>
        <button class="button button-primary submit-button" type="submit" data-submit-button>
          <span data-submit-label>{copy.actions.submit}</span>
          <span class="submit-spinner" aria-hidden="true" hidden></span>
        </button>
      </div>
    </fieldset>
  </form>
</div>

<script>
  type ApiError = { field?: string; code?: string; message?: string }
  type ApiResponse = {
    ok?: boolean
    code?: string
    message?: string
    submissionId?: string
    submittedAt?: string
    errors?: ApiError[]
  }

  const initializeEventSubmissionForm = (root: HTMLElement) => {
    const form = root.querySelector<HTMLFormElement>('[data-submission-form]')
    if (!form || root.dataset.initialized === 'true') return
    root.dataset.initialized = 'true'

    const errorSummary = root.querySelector<HTMLElement>('[data-error-summary]')
    const errorList = root.querySelector<HTMLUListElement>('[data-error-list]')
    const successPanel = root.querySelector<HTMLElement>('[data-success-panel]')
    const beforeYouBegin = root.querySelector<HTMLElement>('[data-before-you-begin]')
    const optionalDrawer = root.querySelector<HTMLDetailsElement>('[data-optional-details]')
    const additionalDatesList = root.querySelector<HTMLElement>('[data-additional-dates-list]')
    const additionalDateTemplate = root.querySelector<HTMLTemplateElement>('[data-additional-date-template]')
    const addDateButton = root.querySelector<HTMLButtonElement>('[data-add-date]')
    const submitButton = root.querySelector<HTMLButtonElement>('[data-submit-button]')
    const submitLabel = root.querySelector<HTMLElement>('[data-submit-label]')
    const spinner = root.querySelector<HTMLElement>('.submit-spinner')
    const dayLabelTemplate = root.dataset.dayLabel ?? 'Day {number}'

    const reindexAdditionalDates = () => {
      if (!additionalDatesList) return
      const rows = Array.from(additionalDatesList.querySelectorAll<HTMLElement>('[data-additional-date-row]'))
      rows.forEach((row, index) => {
        const dayNumber = index + 2
        const title = row.querySelector<HTMLElement>('[data-day-title]')
        if (title) title.textContent = dayLabelTemplate.replace('{number}', String(dayNumber))
        const startInput = row.querySelector<HTMLInputElement>('[data-extra-start]')
        const startLabel = row.querySelector<HTMLLabelElement>('[data-extra-start-label]')
        const endInput = row.querySelector<HTMLInputElement>('[data-extra-end]')
        const endLabel = row.querySelector<HTMLLabelElement>('[data-extra-end-label]')
        const startId = `${form.id || 'ev'}-extra-start-${dayNumber}`
        const endId = `${form.id || 'ev'}-extra-end-${dayNumber}`
        if (startInput && startLabel) {
          startInput.id = startId
          startLabel.htmlFor = startId
        }
        if (endInput && endLabel) {
          endInput.id = endId
          endLabel.htmlFor = endId
        }
      })
    }

    addDateButton?.addEventListener('click', () => {
      if (!additionalDatesList || !additionalDateTemplate) return
      const rowsCount = additionalDatesList.querySelectorAll('[data-additional-date-row]').length
      if (rowsCount >= 30) return
      const fragment = additionalDateTemplate.content.cloneNode(true) as DocumentFragment
      const row = fragment.querySelector<HTMLElement>('[data-additional-date-row]')
      row?.querySelector<HTMLButtonElement>('[data-remove-date]')?.addEventListener('click', () => {
        row.remove()
        reindexAdditionalDates()
      })
      additionalDatesList.append(fragment)
      reindexAdditionalDates()
      const lastStart = additionalDatesList.querySelector<HTMLInputElement>(
        '[data-additional-date-row]:last-child [data-extra-start]',
      )
      lastStart?.focus()
    })

    const input = (name: string) =>
      form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null

    const setVisible = (element: HTMLElement | null, visible: boolean) => {
      if (!element) return
      element.hidden = !visible
      element
        .querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          'input, select, textarea',
        )
        .forEach((control) => {
          control.disabled = !visible
          if (!visible && control.type !== 'checkbox' && control.type !== 'radio') control.value = ''
          if (
            !visible &&
            control instanceof HTMLInputElement &&
            (control.type === 'checkbox' || control.type === 'radio')
          ) {
            control.checked = false
          }
        })
    }

    const toIsoWithOffset = (value: string) => {
      if (!value) return undefined
      const date = new Date(value)
      if (!Number.isFinite(date.getTime())) return value
      const offset = -date.getTimezoneOffset()
      const sign = offset >= 0 ? '+' : '-'
      const hours = String(Math.floor(Math.abs(offset) / 60)).padStart(2, '0')
      const minutes = String(Math.abs(offset) % 60).padStart(2, '0')
      return `${value}:00${sign}${hours}:${minutes}`
    }

    const updateConditionals = () => {
      const format = input('eventFormat')?.value ?? 'in-person'
      const isPhysical = format === 'in-person' || format === 'hybrid'
      const isOnline = format === 'online' || format === 'hybrid'
      root
        .querySelectorAll<HTMLElement>('[data-location-panel="physical"]')
        .forEach((el) => setVisible(el, isPhysical))
      root
        .querySelectorAll<HTMLElement>('[data-location-panel="online"]')
        .forEach((el) => setVisible(el, isOnline))

      const selectedLanguages = Array.from(
        form.querySelectorAll<HTMLInputElement>('input[name="eventLanguages"]:checked'),
      ).map((item) => item.value)
      setVisible(
        root.querySelector<HTMLElement>('[data-conditional="otherEventLanguage"]'),
        selectedLanguages.includes('other'),
      )

      const registrationRequirement = input('registrationRequirement')?.value ?? 'not-required'
      const registrationRequired = registrationRequirement !== 'not-required'
      root
        .querySelectorAll<HTMLElement>('[data-registration-detail]')
        .forEach((el) => setVisible(el, registrationRequired))
      const registrationStatus = input('registrationStatus')
      if (!registrationRequired && registrationStatus) {
        registrationStatus.value = 'not-applicable'
      } else if (registrationRequired && registrationStatus?.value === 'not-applicable') {
        registrationStatus.value = 'open'
      }

      const isFree = (input('isFree') as HTMLInputElement | null)?.checked ?? true
      setVisible(root.querySelector<HTMLElement>('[data-price-detail]'), !isFree)

      const hasImageUrl = Boolean(input('proposedImageUrl')?.value.trim())
      root
        .querySelectorAll<HTMLElement>('[data-image-permission]')
        .forEach((el) => setVisible(el, hasImageUrl))
    }

    const clearErrors = () => {
      root.querySelectorAll<HTMLElement>('[data-error-for], [data-extra-error]').forEach((element) => {
        element.textContent = ''
      })
      form
        .querySelectorAll<HTMLElement>('[aria-invalid="true"]')
        .forEach((element) => element.removeAttribute('aria-invalid'))
      if (errorSummary) errorSummary.hidden = true
      if (errorList) errorList.replaceChildren()
    }

    const showErrors = (errors: ApiError[], fallbackMessage?: string) => {
      clearErrors()
      const items: Array<{ field?: string; message: string }> = []

      errors.forEach((error) => {
        if (!error.message) return
        if (error.field) {
          const target = root.querySelector<HTMLElement>(
            `[data-error-for="${CSS.escape(error.field)}"]`,
          )
          if (target) target.textContent = error.message
          const control = form.elements.namedItem(error.field)
          if (control instanceof HTMLElement) {
            control.setAttribute('aria-invalid', 'true')
            if (optionalDrawer && optionalDrawer.contains(control)) {
              optionalDrawer.open = true
            }
          }
        }
        items.push({ field: error.field, message: error.message })
      })

      if (items.length === 0 && fallbackMessage) {
        items.push({ message: fallbackMessage })
      }

      if (errorList) {
        items.forEach(({ field, message }) => {
          const li = document.createElement('li')
          const control = field ? form.elements.namedItem(field) : null
          if (control instanceof HTMLElement && control.id) {
            const link = document.createElement('a')
            link.href = `#${control.id}`
            link.textContent = message
            link.addEventListener('click', (e) => {
              e.preventDefault()
              if (optionalDrawer && optionalDrawer.contains(control)) optionalDrawer.open = true
              control.focus()
            })
            li.append(link)
          } else {
            li.textContent = message
          }
          errorList.append(li)
        })
      }

      if (errorSummary) {
        errorSummary.hidden = false
        errorSummary.focus()
      }
    }

    const isValidHttpUrl = (value: string) => {
      try {
        const url = new URL(value)
        return url.protocol === 'http:' || url.protocol === 'https:'
      } catch {
        return false
      }
    }

    const validateClientSide = (): ApiError[] => {
      const errors: ApiError[] = []
      const requiredMsg = root.dataset.messageRequired ?? 'Required'
      const invalidEmailMsg = root.dataset.messageInvalidEmail ?? 'Invalid email'
      const invalidUrlMsg = root.dataset.messageInvalidUrl ?? 'Invalid URL'
      const invalidOrderMsg = root.dataset.messageInvalidOrder ?? 'End must be after start'
      const shortDescMsg = root.dataset.messageDescriptionShort ?? 'Too short'
      const onlineReqMsg = root.dataset.messageOnlineRequired ?? requiredMsg

      const val = (name: string) => (input(name)?.value ?? '').trim()
      const checkRequired = (name: string) => {
        if (!val(name)) errors.push({ field: name, message: requiredMsg })
      }
      const checkUrl = (name: string) => {
        const value = val(name)
        if (value && !isValidHttpUrl(value)) errors.push({ field: name, message: invalidUrlMsg })
      }

      checkRequired('proposedTitle')
      checkRequired('eventType')
      checkRequired('eventFormat')
      checkRequired('startDateTime')

      const start = val('startDateTime')
      const end = val('endDateTime')
      if (start && end && Date.parse(end) <= Date.parse(start)) {
        errors.push({ field: 'endDateTime', message: invalidOrderMsg })
      }

      if (additionalDatesList) {
        const rows = Array.from(
          additionalDatesList.querySelectorAll<HTMLElement>('[data-additional-date-row]'),
        )
        rows.forEach((row, index) => {
          const extraStart = row.querySelector<HTMLInputElement>('[data-extra-start]')
          const extraEnd = row.querySelector<HTMLInputElement>('[data-extra-end]')
          const extraError = row.querySelector<HTMLElement>('[data-extra-error]')
          const s = (extraStart?.value ?? '').trim()
          const e = (extraEnd?.value ?? '').trim()
          if (!s) {
            const msg = `${dayLabelTemplate.replace('{number}', String(index + 2))}: ${requiredMsg}`
            if (extraError) extraError.textContent = msg
            extraStart?.setAttribute('aria-invalid', 'true')
            errors.push({ field: 'additionalDates', message: msg })
          } else if (e && Date.parse(e) <= Date.parse(s)) {
            const msg = `${dayLabelTemplate.replace('{number}', String(index + 2))}: ${invalidOrderMsg}`
            if (extraError) extraError.textContent = msg
            extraEnd?.setAttribute('aria-invalid', 'true')
            errors.push({ field: 'additionalDates', message: msg })
          }
        })
      }

      const format = val('eventFormat')
      if (format === 'in-person' || format === 'hybrid') checkRequired('city')
      if ((format === 'online' || format === 'hybrid') && !val('onlinePlatform') && !val('onlineInformationUrl')) {
        errors.push({ field: 'onlinePlatform', message: onlineReqMsg })
      }

      const desc = val('descriptionPlainText')
      if (!desc) {
        errors.push({ field: 'descriptionPlainText', message: requiredMsg })
      } else if (desc.length < 30) {
        errors.push({ field: 'descriptionPlainText', message: shortDescMsg })
      }

      const isFree = (input('isFree') as HTMLInputElement | null)?.checked ?? true
      if (!isFree) checkRequired('priceDescription')

      checkRequired('organizerName')
      checkRequired('privateContactName')
      const email = val('privateContactEmail')
      if (!email) {
        errors.push({ field: 'privateContactEmail', message: requiredMsg })
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        errors.push({ field: 'privateContactEmail', message: invalidEmailMsg })
      }

      checkUrl('onlineInformationUrl')
      checkUrl('registrationUrl')
      checkUrl('publicOrganizerUrl')
      checkUrl('mapUrl')
      checkUrl('sourceUrl')
      checkUrl('proposedImageUrl')

      if (val('proposedImageUrl')) {
        const perm = input('imagePermissionConfirmed') as HTMLInputElement | null
        if (!perm?.checked) errors.push({ field: 'imagePermissionConfirmed', message: requiredMsg })
      }

      if (!(input('accuracyConfirmed') as HTMLInputElement | null)?.checked) {
        errors.push({ field: 'accuracyConfirmed', message: requiredMsg })
      }
      if (!(input('privacyRetentionAccepted') as HTMLInputElement | null)?.checked) {
        errors.push({ field: 'privacyRetentionAccepted', message: requiredMsg })
      }

      return errors
    }

    const buildPayload = () => {
      const data = new FormData(form)
      const optionalTextFields = [
        'privateContactPhone',
        'publicOrganizerUrl',
        'otherEventLanguage',
        'endDateTime',
        'venueName',
        'address',
        'postalCode',
        'city',
        'mapUrl',
        'onlinePlatform',
        'onlineInformationUrl',
        'accessibilityInformation',
        'transportInformation',
        'intendedAudience',
        'sourceUrl',
        'summary',
        'registrationUrl',
        'registrationDeadline',
        'priceDescription',
        'proposedImageUrl',
        'imageAltSuggestion',
        'imageCredit',
        'requestedPublicLanguage',
        'registrationStatus',
      ]

      const payload: Record<string, unknown> = {
        website: String(data.get('website') ?? ''),
        formInterfaceLanguage: root.dataset.language,
        organizerName: String(data.get('organizerName') ?? ''),
        privateContactName: String(data.get('privateContactName') ?? ''),
        privateContactEmail: String(data.get('privateContactEmail') ?? ''),
        publicContactPermission: data.has('publicContactPermission'),
        proposedTitle: String(data.get('proposedTitle') ?? ''),
        descriptionPlainText: String(data.get('descriptionPlainText') ?? ''),
        eventLanguages: data.getAll('eventLanguages').map(String),
        eventType: String(data.get('eventType') ?? ''),
        eventFormat: String(data.get('eventFormat') ?? 'in-person'),
        isAllDay: data.has('isAllDay'),
        startDateTime: toIsoWithOffset(String(data.get('startDateTime') ?? '')),
        registrationRequirement: String(data.get('registrationRequirement') ?? 'not-required'),
        isFree: data.has('isFree'),
        imagePermissionConfirmed: data.has('imagePermissionConfirmed'),
        accuracyConfirmed: data.has('accuracyConfirmed'),
        privacyRetentionAccepted: data.has('privacyRetentionAccepted'),
      }

      optionalTextFields.forEach((name) => {
        const value = String(data.get(name) ?? '').trim()
        if (!value) return
        payload[name] = ['endDateTime', 'registrationDeadline'].includes(name)
          ? toIsoWithOffset(value)
          : value
      })

      if (additionalDatesList) {
        const extraDates = Array.from(
          additionalDatesList.querySelectorAll<HTMLElement>('[data-additional-date-row]'),
        )
          .map((row) => {
            const s = (row.querySelector<HTMLInputElement>('[data-extra-start]')?.value ?? '').trim()
            const e = (row.querySelector<HTMLInputElement>('[data-extra-end]')?.value ?? '').trim()
            if (!s) return null
            const startIso = toIsoWithOffset(s)
            if (!startIso) return null
            const endIso = e ? toIsoWithOffset(e) : undefined
            return endIso ? { startDateTime: startIso, endDateTime: endIso } : { startDateTime: startIso }
          })
          .filter((item): item is { startDateTime: string; endDateTime?: string } => item !== null)
        if (extraDates.length > 0) payload.additionalDates = extraDates
      }

      return payload
    }

    const setSubmitting = (submitting: boolean) => {
      if (submitButton) submitButton.disabled = submitting
      if (submitLabel) {
        submitLabel.textContent = submitting
          ? (root.dataset.actionSubmitting ?? '')
          : (root.dataset.actionSubmit ?? '')
      }
      if (spinner) spinner.hidden = !submitting
      form.setAttribute('aria-busy', String(submitting))
    }

    form.addEventListener('input', updateConditionals)
    form.addEventListener('change', (event) => {
      const target = event.target
      if (target instanceof HTMLInputElement && target.name === 'eventLanguages' && target.checked) {
        const languageChoices = Array.from(
          form.querySelectorAll<HTMLInputElement>('input[name="eventLanguages"]'),
        )
        if (target.value === 'language-independent') {
          languageChoices.forEach((choice) => {
            if (choice !== target) choice.checked = false
          })
        } else {
          const languageIndependent = languageChoices.find(
            (choice) => choice.value === 'language-independent',
          )
          if (languageIndependent) languageIndependent.checked = false
        }
      }
      updateConditionals()
    })

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      clearErrors()
      if (successPanel) successPanel.hidden = true

      const clientErrors = validateClientSide()
      if (clientErrors.length > 0) {
        showErrors(clientErrors, root.dataset.messageValidationBody)
        return
      }

      setSubmitting(true)
      try {
        const response = await fetch('/api/event-submissions', {
          method: 'POST',
          headers: {'content-type': 'application/json'},
          body: JSON.stringify(buildPayload()),
        })
        const result = (await response.json().catch(() => ({}))) as ApiResponse

        if (response.ok && result.ok) {
          form.hidden = true
          if (beforeYouBegin) beforeYouBegin.hidden = true
          if (errorSummary) errorSummary.hidden = true
          if (successPanel) {
            successPanel.hidden = false
            const reference = successPanel.querySelector<HTMLElement>('[data-success-reference]')
            if (reference) {
              reference.textContent = `${root.dataset.messageSuccessReference}: ${result.submissionId ?? ''}`
            }
            successPanel.focus()
          }
          return
        }

        if (result.code === 'validation_failed') {
          showErrors(result.errors ?? [], result.message ?? root.dataset.messageValidationBody)
        } else {
          const message =
            response.status === 429
              ? root.dataset.messageRateLimited
              : response.status === 503
                ? root.dataset.messageUnavailable
                : response.status >= 500
                  ? root.dataset.messageStorageFailed
                  : (result.message ?? root.dataset.messageUnexpected)
          showErrors([], message)
        }
      } catch {
        showErrors([], root.dataset.messageNetworkFailed)
      } finally {
        setSubmitting(false)
      }
    })

    updateConditionals()
  }

  document.querySelectorAll<HTMLElement>('[data-event-submission]').forEach(initializeEventSubmissionForm)
  document.addEventListener('astro:page-load', () => {
    document
      .querySelectorAll<HTMLElement>('[data-event-submission]')
      .forEach(initializeEventSubmissionForm)
  })
</script>

