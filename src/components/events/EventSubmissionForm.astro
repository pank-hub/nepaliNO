  @keyframes spin { to { transform: rotate(360deg); } }
  @media (max-width: 48rem) {
    .field-grid--two, .choice-grid { grid-template-columns: 1fr; }
    .submit-panel { align-items: stretch; flex-direction: column; }
    .submit-button { width: 100%; }
  }
  @media (max-width: 32rem) {
    .form-section { padding: 1rem; }
    .form-section legend { align-items: flex-start; font-size: 1.15rem; }
    .before-you-begin { grid-template-columns: 1fr; }
  }
</style>
