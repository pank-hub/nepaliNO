---
import type { SupportedLanguage } from '../../i18n/config'
import { getAllDates } from '../../lib/eventOccurrences'
import {
  formatEventDateRange,
  formatEventTimeRange,
  resolveEventRegistration,
} from '../../lib/eventPresentation'
import { urlFor } from '../../lib/sanity/image'

export interface EventCardData {
  _id: string
  title: string
  slug: string
  summary: string
  eventType: string
  eventFormat: string
  eventStatus: string
  isAllDay?: boolean
  startDateTime: string
  endDateTime?: string
  additionalDates?: { startDateTime: string; endDateTime?: string }[] | null
  venueName?: string
  city?: string
  onlinePlatform?: string
  organizerName: string
  registrationRequirement: string
  registrationStatus: string
  registrationUrl?: string
  registrationDeadline?: string
  isFree?: boolean
  priceNok?: number
  priceDescription?: string
  featuredImage?: { asset?: unknown; alt?: string; hotspot?: unknown; crop?: unknown }
}

interface Props {
  event: EventCardData
  language: SupportedLanguage
  eventLabels: any
  locale: string
  timeZone: string
  currentYear: number
  now: number
  pastCard?: boolean
}

const {
  event,
  language,
  eventLabels,
  locale,
  timeZone,
  currentYear,
  now,
  pastCard = false,
} = Astro.props

const categories = eventLabels.categories as Record<string, string>
const statuses = eventLabels.statuses as Record<string, string>
const formats: Record<string, string> = {
  'in-person': eventLabels.inPerson,
  online: eventLabels.online,
  hybrid: eventLabels.hybrid,
}

const reg = resolveEventRegistration(event, eventLabels, now)
const isPast = pastCard || reg.isPast
const allDates = getAllDates(event)
const isMultiDay = allDates.length > 1
const href = `/${language}/events/${event.slug}/`
const startDate = new Date(event.startDateTime)
const dayText = new Intl.DateTimeFormat(locale, { timeZone, day: '2-digit' }).format(startDate)
const monthText = new Intl.DateTimeFormat(locale, { timeZone, month: 'short' }).format(startDate)
const yearNumber = Number(new Intl.DateTimeFormat('en', { timeZone, year: 'numeric' }).format(startDate))
const showYear = yearNumber !== currentYear
const yearText = showYear
  ? new Intl.DateTimeFormat(locale, { timeZone, year: 'numeric' }).format(startDate)
  : undefined

const dateRangeText =
  pastCard && isMultiDay
    ? formatEventDateRange(
        allDates[0].startDateTime,
        allDates[allDates.length - 1].endDateTime || allDates[allDates.length - 1].startDateTime,
        locale,
        timeZone,
        currentYear,
      )
    : formatEventDateRange(
        event.startDateTime,
        event.endDateTime,
        locale,
        timeZone,
        currentYear,
      )
const timeText =
  pastCard && isMultiDay
    ? eventLabels.multiDayCount.replace('{count}', String(allDates.length))
    : formatEventTimeRange(
        event.startDateTime,
        event.endDateTime,
        event.isAllDay,
        locale,
        timeZone,
        eventLabels.allDay,
      )

const locationParts =
  event.eventFormat === 'online'
    ? [event.onlinePlatform || eventLabels.online]
    : [event.venueName, event.city].filter(Boolean)
const locationText =
  locationParts.length > 0
    ? locationParts.join(', ')
    : formats[event.eventFormat] ?? event.eventFormat

const priceText =
  event.isFree === true
    ? eventLabels.freeEvent
    : event.priceDescription ||
      (typeof event.priceNok === 'number' ? `${event.priceNok} NOK` : eventLabels.paidEvent)

const imageSrc = event.featuredImage?.asset
  ? urlFor(event.featuredImage as any).width(800).height(450).fit('crop').auto('format').url()
  : null
---

<article
  class:list={['ev-card', { 'ev-card--past': isPast }]}
  data-event-card
  data-event-format={event.eventFormat}
  data-event-category={event.eventType}
  data-event-free={event.isFree === true ? 'true' : 'false'}
>
  {imageSrc && (
    <a class="ev-card__media" href={href} tabindex="-1" aria-hidden="true">
      <img
        src={imageSrc}
        alt=""
        width="800"
        height="450"
        loading="lazy"
        decoding="async"
      />
    </a>
  )}

  <div class="ev-card__body">
    <div class="ev-card__top">
      <div class="ev-card__date" aria-hidden="true">
        <span class="ev-card__month">{monthText}</span>
        <strong>{dayText}</strong>
        {yearText && <span class="ev-card__year">{yearText}</span>}
      </div>

      <div class="ev-card__pills">
        {!isPast && reg.isOngoing && (
          <strong class="ev-pill ev-pill--live">{eventLabels.ongoing}</strong>
        )}
        {isPast && <strong class="ev-pill ev-pill--past">{eventLabels.completed}</strong>}
        {event.eventStatus !== 'scheduled' && (
          <strong class:list={['ev-pill', `ev-pill--${event.eventStatus}`]}>
            {statuses[event.eventStatus] ?? event.eventStatus}
          </strong>
        )}
        <span class="ev-pill">{formats[event.eventFormat] ?? event.eventFormat}</span>
        <span class="ev-pill">{categories[event.eventType] ?? event.eventType}</span>
        {isMultiDay && (
          <span class="ev-pill">{eventLabels.multiDayCount.replace('{count}', String(allDates.length))}</span>
        )}
        {event.isFree === true && (
          <span class="ev-pill ev-pill--free">{eventLabels.freeEvent}</span>
        )}
      </div>
    </div>

    <h3 class="ev-card__title">
      <a href={href}>{event.title}</a>
    </h3>

    <p class="ev-card__summary">{event.summary}</p>

    <dl class="ev-card__facts">
      <div>
        <dt>{eventLabels.dateAndTime}</dt>
        <dd>{dateRangeText} · {timeText}</dd>
      </div>
      <div>
        <dt>{eventLabels.venue}</dt>
        <dd>{locationText}</dd>
      </div>
      <div>
        <dt>{eventLabels.organizer}</dt>
        <dd>{event.organizerName}</dd>
      </div>
      {!isPast && reg.needsAction && (
        <div>
          <dt>{reg.sectionLabel}</dt>
          <dd>{reg.statusLabel}</dd>
        </div>
      )}
      {!isPast && event.isFree === false && (
        <div>
          <dt>{eventLabels.price}</dt>
          <dd>{priceText}</dd>
        </div>
      )}
    </dl>

    <div class="ev-card__footer">
      <a class="ev-card__link" href={href}>
        {eventLabels.readMore} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .ev-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  @media (hover: hover) {
    .ev-card:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-raised);
      transform: translateY(-2px);
    }
  }

  .ev-card--past {
    background: #fcfcfd;
  }

  .ev-card__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--border);
    background: var(--surface-muted);
  }

  .ev-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 280ms ease;
  }

  .ev-card:hover .ev-card__media img {
    transform: scale(1.02);
  }

  .ev-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1.35rem;
  }

  .ev-card__top {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .ev-card__date {
    display: grid;
    min-width: 3.75rem;
    padding: 0.45rem 0.5rem;
    place-items: center;
    border: 1px solid var(--border);
    border-block-start: 0.25rem solid var(--brand);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    color: var(--civic-deep);
    flex-shrink: 0;
  }

  .ev-card--past .ev-card__date {
    border-block-start-color: var(--civic);
  }

  .ev-card__month {
    color: var(--brand);
    font-size: 0.72rem;
    font-weight: 760;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .ev-card--past .ev-card__month {
    color: var(--civic);
  }

  html[lang='ne'] .ev-card__month {
    text-transform: none;
    font-size: 0.78rem;
  }

  .ev-card__date strong {
    font-size: 1.55rem;
    line-height: 1.05;
    margin-block-start: 0.1rem;
  }

  .ev-card__year {
    color: var(--text-soft);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .ev-card__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .ev-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.24rem 0.6rem;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--civic-deep);
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .ev-pill--live {
    background: #dcfce7;
    color: #14532d;
  }

  .ev-pill--free {
    background: #ecfdf3;
    color: #027a48;
  }

  .ev-pill--past {
    background: #eef2f6;
    color: #475569;
  }

  .ev-pill--cancelled {
    background: #fde8e6;
    color: #9e281f;
  }

  .ev-pill--postponed,
  .ev-pill--rescheduled {
    background: #fff2cc;
    color: #6f5200;
  }

  .ev-card__title {
    margin-block-start: 0.95rem;
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    line-height: 1.3;
  }

  .ev-card__title a {
    color: var(--civic-deep);
    text-decoration: none;
  }

  .ev-card__title a:hover {
    color: var(--brand);
  }

  .ev-card__summary {
    margin-block-start: 0.55rem;
    color: var(--text-muted);
    font-size: 0.96rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ev-card__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem 1rem;
    margin-block-start: 1rem;
    padding-block-start: 0.9rem;
    border-top: 1px solid var(--border);
  }

  .ev-card__facts dt {
    color: var(--text-soft);
    font-size: 0.7rem;
    font-weight: 760;
    text-transform: uppercase;
  }

  html[lang='ne'] .ev-card__facts dt {
    font-size: 0.78rem;
    text-transform: none;
  }

  .ev-card__facts dd {
    margin: 0.15rem 0 0;
    color: var(--civic-deep);
    font-size: 0.88rem;
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  .ev-card__footer {
    margin-block-start: auto;
    padding-block-start: 1rem;
  }

  .ev-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--brand);
    font-weight: 740;
    text-decoration: none;
  }

  .ev-card__link:hover {
    color: var(--brand-hover);
    text-decoration: underline;
  }

  @media (max-width: 34rem) {
    .ev-card__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
