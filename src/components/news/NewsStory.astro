---
import {getTranslations} from '../../i18n'
import type {SupportedLanguage} from '../../i18n/config'
import {formatNewsDate, type NewsStory} from '../../lib/newsHub'
import {urlFor} from '../../lib/sanity/image'
interface Props {
  story: NewsStory
  language: SupportedLanguage
  variant?: 'lead' | 'secondary' | 'latest' | 'primary' | 'paired' | 'support' | 'archive'
  heading?: 'h2' | 'h3'
}
const {story, language, variant = 'latest', heading: Heading = 'h3'} = Astro.props
const labels = getTranslations(language)
const categories: Record<string, string> = labels.news.categories
const source = story.featuredImage
const ratio = ['lead', 'primary', 'paired'].includes(variant) ? 16 / 9 : 4 / 3
let image: {src: string; srcset: string; width: number; height: number} | null = null
if (source?.asset) {
  const dimensions = source.asset._ref.match(/-(\d+)x(\d+)-[a-z0-9]+$/)
  const crop = source.crop
  const nativeWidth = dimensions ? Math.floor(Math.min(
    Number(dimensions[1]) * (1 - (crop?.left ?? 0) - (crop?.right ?? 0)),
    Number(dimensions[2]) * (1 - (crop?.top ?? 0) - (crop?.bottom ?? 0)) * ratio,
  )) : 0
  if (!Number.isFinite(nativeWidth) || nativeWidth < 4) {
    console.warn(`[news-hub] Invalid image asset or crop for ${story._id}; rendering a text-led story.`)
  } else {
    const maximum = variant === 'lead' ? 1440 : variant === 'archive' ? 340 : 800
    const widths = [...new Set([96, 192, 384, 640, maximum].filter((width) => width <= maximum).map((width) => Math.min(width, nativeWidth)))]
    const url = (width: number) => urlFor(source).width(width).height(Math.round(width / ratio)).fit('crop').auto('format').url()
    const width = Math.min(maximum, nativeWidth)
    image = {src: url(width), srcset: widths.map((size) => `${url(size)} ${size}w`).join(', '), width, height: Math.round(width / ratio)}
  }
}
const summary = ['lead', 'primary', 'archive'].includes(variant) && story.summary
const sizes = variant === 'lead' ? '(min-width: 64rem) 60vw, 100vw'
  : variant === 'primary' ? '(min-width: 48rem) 50vw, 100vw'
  : variant === 'paired' ? '(min-width: 48rem) 50vw, 96px'
  : variant === 'support' ? '(min-width: 80rem) 160px, 96px'
  : variant === 'archive' ? '(min-width: 48rem) 160px, 96px'
  : '(min-width: 64rem) 30vw, (min-width: 48rem) 45vw, 96px'
---
<article class:list={['story', variant, {'with-image': image}]}>
  <a href={`/${language}/news/${story.slug}/`} aria-label={story.title}>
    {image && (
      <img src={image.src} srcset={image.srcset} sizes={sizes}
        width={image.width} height={image.height}
        style={`--native-width: ${image.width}px; --image-ratio: ${ratio}`}
        alt={source?.alt ?? ''} loading={variant === 'lead' ? 'eager' : 'lazy'}
        fetchpriority={variant === 'lead' ? 'high' : undefined} decoding="async" />
    )}
    <div class="content">
      <div class="meta"><span>{categories[story.category] ?? story.category}</span><time datetime={story.publishedAt}>{formatNewsDate(story.publishedAt, language)}</time></div>
      <Heading>{story.title}</Heading>
      {summary && <p class="summary">{story.summary}</p>}
    </div>
  </a>
</article>
<style>
  .story, .content { min-width: 0; }
  a { display: grid; align-items: start; gap: .85rem; min-height: 44px; color: var(--civic-deep); text-decoration: none; }
  .support.with-image a { grid-template-columns: 96px minmax(0, 1fr); }
  img { width: min(100%, var(--native-width)); height: auto; aspect-ratio: var(--image-ratio); object-fit: cover; }
  .meta { display: flex; flex-wrap: wrap; gap: .15rem .65rem; margin-block-end: .3rem; font-size: .8125rem; line-height: 1.5; color: var(--text-muted); }
  .meta > span { color: var(--brand); font-weight: 600; }
  h2, h3 { max-width: none; margin: 0; font-size: 1.1875rem; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
  .lead h2 { font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.2; }
  .primary h3 { font-size: clamp(1.6rem, 2.7vw, 2.125rem); line-height: 1.3; }
  .summary { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; margin-block-start: .65rem; color: var(--text-muted); line-height: 1.65; }
  .archive .summary { display: none; }
  a:hover h2, a:hover h3 { text-decoration: underline; text-decoration-color: var(--brand); text-decoration-thickness: .055em; }
  .lead:not(.with-image) { padding-block: 1.25rem 2rem; }
  @media (max-width: 47.999rem) {
    .with-image:not(.lead):not(.primary) a { grid-template-columns: 96px minmax(0, 1fr); }
  }
  @media (min-width: 48rem) {
    .latest.with-image a, .secondary.with-image a { grid-template-columns: minmax(0, 1fr); }
    .latest h3 { font-size: 1.375rem; }
    .secondary h2, .secondary h3 { font-size: clamp(1.375rem, 2vw, 1.6875rem); }
    .paired h3 { font-size: clamp(1.6rem, 2.7vw, 2.125rem); line-height: 1.3; }
    .archive.with-image a { grid-template-columns: 160px minmax(0, 1fr); gap: 1.5rem; }
    .archive .summary { display: -webkit-box; -webkit-line-clamp: 2; }
    .archive h2 { font-size: 1.375rem; }
  }
  @media (min-width: 80rem) {
    .support.with-image a { grid-template-columns: 160px minmax(0, 1fr); }
  }
</style>
