const {topicKey} = Astro.props
const glyph = paths[topicKey] ?? paths.other
---

<svg
  viewBox="0 0 24 24"
  width="22"
  height="22"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  data-topic-icon={topicKey}
  data-icon-fallback={paths[topicKey] ? undefined : 'document'}
>
  {glyph.map((d) => <path d={d} />)}
</svg>

<style>
  svg {
    width: 22px;
    height: 22px;
    margin-block-start: 0.1rem;
    color: var(--text);
  }
</style>
