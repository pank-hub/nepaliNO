---
import { PortableText } from "astro-portabletext";
import type { SupportedLanguage } from "../../i18n/config";
import { getTranslations } from "../../i18n";
import {
  normalizeExpandableSection,
  type ExpandableSectionInput,
} from "../../lib/expandableSection/normalize.ts";

interface Props {
  node: ExpandableSectionInput;
  language: SupportedLanguage;
  index?: number;
}

const { node, language, index = 0 } = Astro.props;
const section = normalizeExpandableSection(node, index);
const labels = getTranslations(language).common;
const titleId = section
  ? `expandable-section-title-${section.idSuffix}`
  : undefined;
const contentId = section
  ? `expandable-section-content-${section.idSuffix}`
  : undefined;
---

{
  section && (
    <section
      class="expandable-section"
      aria-labelledby={titleId}
      data-preview-size={section.previewSize}
      data-expandable-section
    >
      <script is:inline>
        document.currentScript.parentElement.setAttribute("data-preparing", "");
      </script>
      <h2 class="expandable-section__title" id={titleId}>
        {section.title}
      </h2>
      <div
        class="expandable-section__preview"
        data-expandable-preview
        aria-hidden="true"
      >
        {section.previewText}
      </div>
      <div
        class="expandable-section__hidden"
        id={contentId}
        role="region"
        aria-labelledby={titleId}
        data-expandable-content
      >
        <div class="expandable-section__body" data-expandable-body>
          <PortableText value={section.body as any} />
        </div>
      </div>
      <button
        class="expandable-section__toggle"
        type="button"
        aria-expanded="false"
        aria-controls={contentId}
        data-expandable-toggle
        data-label-more={labels.showMore}
        data-label-less={labels.showLess}
      >
        {labels.showMore}
      </button>
    </section>
  )
}

<script>
  import "../../lib/expandableSection/enhance.ts";
</script>

<style>
  .expandable-section {
    position: relative;
    max-width: 100%;
    margin-block: 1.75rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    color: var(--text);
    overflow-wrap: anywhere;
  }

  :global(.prose) .expandable-section__title {
    margin: 0 0 0.35rem;
    padding-block-end: 0;
    border: 0;
    color: var(--civic-deep);
    font-size: 1.2rem;
    line-height: 1.4;
    letter-spacing: 0;
  }

  html[lang="ne"] :global(.prose) .expandable-section__title {
    line-height: 1.6;
  }

  .expandable-section__body > :global(* + *) {
    margin-block-start: 0.5em;
  }

  :global(.prose) .expandable-section__body :global(p),
  :global(.prose) .expandable-section__body :global(ul),
  :global(.prose) .expandable-section__body :global(ol) {
    margin-block: 0;
  }

  :global(.prose) .expandable-section__body :global(ul),
  :global(.prose) .expandable-section__body :global(ol) {
    padding-inline-start: 1.5rem;
  }

  .expandable-section__body :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .expandable-section__preview,
  .expandable-section__toggle {
    display: none;
  }

  .expandable-section[data-preparing] [data-expandable-content] {
    position: absolute;
    inset-inline: 0;
    top: 0;
    visibility: hidden;
  }

  .expandable-section[data-enhanced] .expandable-section__preview {
    position: relative;
    display: block;
    height: calc(var(--preview-line-height) * var(--preview-lines));
    margin-top: 0.15rem;
    overflow: hidden;
    font: inherit;
    line-height: var(--preview-line-height);
    white-space: pre-line;
  }

  .expandable-section[data-preview-size="compact"] {
    --preview-lines: 4;
    --preview-fade-start: 50%;
    --preview-fade-middle: 75%;
  }

  .expandable-section[data-preview-size="standard"] {
    --preview-lines: 6;
    --preview-fade-start: 66.667%;
    --preview-fade-middle: 83.333%;
  }

  .expandable-section[data-preview-size="extended"] {
    --preview-lines: 9;
    --preview-fade-start: 77.778%;
    --preview-fade-middle: 88.889%;
  }

  .expandable-section[data-enhanced] .expandable-section__preview::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: calc(var(--preview-line-height) * 2);
    background: linear-gradient(to bottom, transparent, var(--surface-muted));
    content: "";
    pointer-events: none;
  }

  @supports (mask-image: linear-gradient(to bottom, var(--text), transparent))
    or
    (-webkit-mask-image: linear-gradient(to bottom, var(--text), transparent)) {
    .expandable-section[data-enhanced] .expandable-section__preview {
      -webkit-mask-image: linear-gradient(
        to bottom,
        var(--text) 0%,
        var(--text) var(--preview-fade-start),
        color-mix(in srgb, var(--text) 55%, transparent)
          var(--preview-fade-middle),
        transparent 100%
      );
      mask-image: linear-gradient(
        to bottom,
        var(--text) 0%,
        var(--text) var(--preview-fade-start),
        color-mix(in srgb, var(--text) 55%, transparent)
          var(--preview-fade-middle),
        transparent 100%
      );
    }

    .expandable-section[data-enhanced] .expandable-section__preview::after {
      display: none;
    }
  }

  .expandable-section[data-enhanced]:not([data-expanded])
    .expandable-section__hidden {
    height: 0;
    visibility: hidden;
  }

  .expandable-section[data-preparing] .expandable-section__hidden {
    height: auto;
  }

  .expandable-section[data-enhanced][data-ready] .expandable-section__hidden {
    transition:
      height 0.32s ease,
      visibility 0s linear;
  }

  .expandable-section[data-enhanced][data-ready]:not([data-expanded])
    .expandable-section__hidden {
    transition-delay: 0s, 0.32s;
  }

  .expandable-section[data-enhanced] .expandable-section__toggle {
    position: relative;
    display: block;
    min-height: 2.75rem;
    margin: -0.25rem auto 0;
    padding: 0.55rem 1.3rem;
    border: 0;
    border-radius: 999px;
    background: var(--civic);
    color: var(--surface);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .expandable-section[data-enhanced] .expandable-section__toggle:hover {
    background: var(--civic-deep);
  }

  .expandable-section__toggle:focus-visible {
    outline: 0.2rem solid var(--focus);
    outline-offset: 0.2rem;
  }

  .expandable-section[data-expanded] .expandable-section__preview,
  .expandable-section[data-transitioning] .expandable-section__preview {
    display: none;
  }

  .expandable-section[data-expanded] .expandable-section__toggle {
    margin-top: 0.45rem;
  }

  @media (min-width: 40rem) {
    .expandable-section {
      padding: 1rem 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .expandable-section[data-enhanced][data-ready] [data-expandable-content],
    .expandable-section__toggle {
      transition: none;
    }
  }

  @media print {
    .expandable-section__toggle,
    .expandable-section__preview {
      display: none !important;
    }

    .expandable-section[data-enhanced] [data-expandable-content] {
      height: auto !important;
      overflow: visible;
      visibility: visible;
    }

    .expandable-section {
      border-color: currentColor;
      background: none;
    }
  }
</style>
