---
import { safeCreateChartGeometry } from "../../lib/editorialChart/geometry.ts";
import {
  formatChartUnit,
  formatChartValue,
  formatPercentage,
} from "../../lib/editorialChart/format.ts";
import {
  createChartIdSuffix,
  normalizeEditorialChart,
} from "../../lib/editorialChart/normalize.ts";
import {
  CHART_PALETTE,
  CHART_PATTERN_PATHS,
  getPaletteIndex,
  isPolarChart,
} from "../../lib/editorialChart/palette.ts";
import EditorialChartTable from "./EditorialChartTable.astro";
import type {
  ChartGeometry,
  ChartLanguage,
  ChartLayout,
  EditorialChartInput,
  NormalizedChart,
  SvgShape,
} from "../../lib/editorialChart/types.ts";

interface Props {
  node: EditorialChartInput;
  language: ChartLanguage;
  index?: number;
}

const { node, language, index = 0 } = Astro.props;
const chart = normalizeEditorialChart(node);
const polar = isPolarChart(chart);
// Polar charts are one fixed-size SVG; Cartesian charts get a compact and a wide layout, chosen by CSS.
const layoutKeys: ChartLayout[] = polar ? ["wide"] : ["compact", "wide"];
const results = layoutKeys.map((key) => ({
  key,
  ...safeCreateChartGeometry(chart, language, key),
}));
const geometryError = results.find((result) => result.error)?.error;
const tiers = results.flatMap((result) =>
  result.geometry && !geometryError
    ? [{ key: result.key, geometry: result.geometry as ChartGeometry }]
    : [],
);
const hasVisual = tiers.length > 0;
if (geometryError) {
  console.error(
    `[editorialChart] Geometry failed for "${chart.title ?? "untitled"}": ${geometryError}`,
  );
}
if (chart.warnings.length) {
  console.warn(
    `[editorialChart] "${chart.title ?? "untitled"}": ${chart.warnings.join("; ")}`,
  );
}
const idSuffix = createChartIdSuffix(node, index);
const titleId = `editorial-chart-title-${idSuffix}`;
const descriptionId = `editorial-chart-description-${idSuffix}`;
const copy =
  language === "ne"
    ? {
        chart: "चार्ट",
        legend: "चार्टको सङ्केत",
        unit: "एकाइ",
        scrollHint: "चार्ट काटिएमा दायाँबायाँ स्क्रोल गर्नुहोस्।",
        dataTable: "चार्टको तथ्याङ्क तालिका",
        category: "श्रेणी",
        unavailable: "उपलब्ध छैन",
        data: "चार्टको पूरा तथ्याङ्क हेर्नुहोस्",
        source: "स्रोत",
        note: "टिप्पणी",
        summary:
          "यो चार्टमा {categories} श्रेणी र {series} तथ्याङ्क शृङ्खला छन्। पूरा मान तलको तालिकामा छन्।",
        chartUnavailable:
          "चार्ट चित्र देखाउन सकिएन। तथ्याङ्क तालिकामा उपलब्ध छ।",
      }
    : {
        chart: "Diagram",
        legend: "Tegnforklaring",
        unit: "Enhet",
        scrollHint: "Rull sideveis hvis diagrammet er avkuttet.",
        dataTable: "Diagramdata som tabell",
        category: "Kategori",
        unavailable: "Ikke tilgjengelig",
        data: "Vis alle diagramdata",
        source: "Kilde",
        note: "Merknad",
        summary:
          "Diagrammet viser {categories} kategorier og {series} dataserier. Alle verdiene står i tabellen nedenfor.",
        chartUnavailable:
          "Diagrammet kunne ikke vises. Dataene finnes i tabellen.",
      };

const summaryText = (item: NormalizedChart) =>
  item.altSummary ??
  item.description ??
  copy.summary
    .replace(
      "{categories}",
      new Intl.NumberFormat(language === "ne" ? "ne-NP" : "nb-NO").format(
        item.categories.length,
      ),
    )
    .replace(
      "{series}",
      new Intl.NumberFormat(language === "ne" ? "ne-NP" : "nb-NO").format(
        item.series.length,
      ),
    );

const legendEntries = polar
  ? chart.categories.map((label, index) => ({
      label,
      index,
      value: chart.showValues ? (chart.series[0]?.values[index] ?? null) : null,
      percentage: chart.percentages[index] ?? null,
    }))
  : chart.series.map((item, index) => ({
      label: item.shortLabel ?? item.label,
      index,
      value: null,
      percentage: null,
    }));

const formatValue = (value: number) => formatChartValue(value, chart, language);
const showSource = chart.sourceLabel || chart.sourceUrl || chart.sourceDate;
const measureParts = [
  !polar && chart.series.length === 1 ? chart.series[0].label : undefined,
  chart.unit
    ? `${copy.unit}: ${formatChartUnit(chart.unit, language)}`
    : undefined,
].filter(Boolean);
const tableLabels = {
  category: copy.category,
  unavailable: copy.unavailable,
  dataTable: copy.dataTable,
};
const patternSlots = Array.from(
  { length: polar ? chart.categories.length : chart.series.length },
  (_, position) => ({
    position,
    color: getPaletteIndex(chart, position),
    path: CHART_PATTERN_PATHS[position % CHART_PATTERN_PATHS.length],
  }),
);
---

<figure
  class="editorial-chart"
  aria-labelledby={chart.title ? titleId : undefined}
  aria-label={chart.title ? undefined : copy.chart}
>
  <header class="editorial-chart__header">
    {
      chart.title && (
        <p class="editorial-chart__title" id={titleId}>
          {chart.title}
        </p>
      )
    }
    {
      chart.subtitle && (
        <p class="editorial-chart__subtitle">{chart.subtitle}</p>
      )
    }
    {
      chart.showDataSummary && (
        <p class="editorial-chart__summary">{summaryText(chart)}</p>
      )
    }
    {
      measureParts.length > 0 && (
        <p class="editorial-chart__measure">{measureParts.join(" · ")}</p>
      )
    }
  </header>

  {
    hasVisual ? (
      tiers.map(({ key, geometry }) => (
        <div
          class={
            polar
              ? "editorial-chart__tier"
              : `editorial-chart__tier editorial-chart__tier--${key}`
          }
        >
          <div
            class:list={[
              "editorial-chart__visual",
              geometry.scrolls && "is-scrollable",
            ]}
            tabindex={geometry.scrolls ? 0 : undefined}
            style={
              geometry.scrolls
                ? `--chart-min-width: ${geometry.width}px`
                : undefined
            }
          >
            <svg
              class="editorial-chart__svg"
              viewBox={`0 0 ${geometry.width} ${geometry.height}`}
              role="img"
              aria-label={copy.chart}
              aria-describedby={
                chart.showDataSummary ? undefined : `${descriptionId}-${key}`
              }
              focusable="false"
            >
              <defs>
                {patternSlots.map((slot) => (
                  <pattern
                    id={`chart-pattern-${idSuffix}-${key}-${slot.position}`}
                    width="8"
                    height="8"
                    patternUnits="userSpaceOnUse"
                  >
                    <rect
                      width="8"
                      height="8"
                      class={`chart-series-${slot.color}`}
                    />
                    <path d={slot.path} class="chart-pattern-line" />
                  </pattern>
                ))}
              </defs>
              {!chart.showDataSummary && (
                <desc id={`${descriptionId}-${key}`}>{summaryText(chart)}</desc>
              )}
              {geometry.shapes.map((shape: SvgShape) => {
                if (shape.type === "line") {
                  return (
                    <line
                      x1={shape.x1}
                      y1={shape.y1}
                      x2={shape.x2}
                      y2={shape.y2}
                      class:list={[
                        "chart-line",
                        shape.className && `chart-line--${shape.className}`,
                      ]}
                    />
                  );
                }
                if (shape.type === "rect") {
                  return (
                    <rect
                      x={shape.x}
                      y={shape.y}
                      width={shape.width}
                      height={shape.height}
                      rx="2"
                      style={
                        shape.pattern
                          ? `fill: url(#chart-pattern-${idSuffix}-${key}-${shape.position});`
                          : undefined
                      }
                      class:list={[
                        `chart-series-${shape.series}`,
                        `chart-pos-${shape.position}`,
                        shape.pattern && "chart-pattern",
                      ]}
                    />
                  );
                }
                if (shape.type === "hole") {
                  return (
                    <circle
                      cx={shape.cx}
                      cy={shape.cy}
                      r={shape.r}
                      class="chart-hole"
                    />
                  );
                }
                if (shape.type === "circle") {
                  return (
                    <circle
                      cx={shape.cx}
                      cy={shape.cy}
                      r={shape.r}
                      class={`chart-series-${shape.series} chart-pos-${shape.position}`}
                    />
                  );
                }
                if (shape.type === "path") {
                  return (
                    <path
                      d={shape.d}
                      style={
                        shape.pattern
                          ? `fill: url(#chart-pattern-${idSuffix}-${key}-${shape.position});`
                          : undefined
                      }
                      class:list={[
                        `chart-series-${shape.series}`,
                        `chart-pos-${shape.position}`,
                        shape.slice
                          ? "chart-slice"
                          : shape.fill
                            ? "chart-area"
                            : "chart-line-path",
                        shape.pattern && "chart-pattern",
                      ]}
                    />
                  );
                }
                return (
                  <text
                    x={shape.x}
                    y={shape.y}
                    text-anchor={shape.anchor ?? "middle"}
                    class:list={[
                      "chart-text",
                      shape.className && `chart-text--${shape.className}`,
                    ]}
                  >
                    {shape.lines
                      ? shape.lines.map((line, index) => (
                          <tspan x={shape.x} dy={index === 0 ? 0 : "1.15em"}>
                            {line}
                          </tspan>
                        ))
                      : shape.text}
                  </text>
                );
              })}
            </svg>
          </div>
          {geometry.scrolls && (
            <p class="editorial-chart__scroll-hint">{copy.scrollHint}</p>
          )}
        </div>
      ))
    ) : (
      <>
        <p class="editorial-chart__fallback">{copy.chartUnavailable}</p>
        {import.meta.env.DEV && geometryError && (
          <p class="editorial-chart__fallback" data-chart-geometry-error>
            Dev only: {geometryError}
          </p>
        )}
      </>
    )
  }

  {
    chart.legendVisible && legendEntries.length > 0 && (
      <ul class="editorial-chart__legend" aria-label={copy.legend}>
        {legendEntries.map((entry) => (
          <li class="editorial-chart__legend-item">
            {polar || !hasVisual ? (
              <span
                class={`editorial-chart__swatch chart-series-${getPaletteIndex(chart, entry.index)}`}
                aria-hidden="true"
              >
                {polar && <span>{entry.index + 1}</span>}
              </span>
            ) : (
              <svg
                class="editorial-chart__swatch-graphic"
                viewBox="0 0 28 18"
                aria-hidden="true"
                focusable="false"
              >
                <defs>
                  <pattern
                    id={`chart-pattern-${idSuffix}-legend-${entry.index}`}
                    width="8"
                    height="8"
                    patternUnits="userSpaceOnUse"
                  >
                    <rect
                      width="8"
                      height="8"
                      class={`chart-series-${getPaletteIndex(chart, entry.index)}`}
                    />
                    <path
                      d={
                        CHART_PATTERN_PATHS[
                          entry.index % CHART_PATTERN_PATHS.length
                        ]
                      }
                      class="chart-pattern-line"
                    />
                  </pattern>
                </defs>
                {chart.chartType === "line" ? (
                  <line
                    x1="2"
                    y1="9"
                    x2="26"
                    y2="9"
                    class={`chart-series-${getPaletteIndex(chart, entry.index)} chart-pos-${entry.index} chart-line-path`}
                  />
                ) : (
                  <rect
                    width="28"
                    height="18"
                    rx="3"
                    class={`chart-series-${getPaletteIndex(chart, entry.index)}`}
                    style={
                      entry.index > 0
                        ? `fill: url(#chart-pattern-${idSuffix}-legend-${entry.index});`
                        : undefined
                    }
                  />
                )}
              </svg>
            )}
            <span>
              <strong>{entry.label}</strong>
              {entry.value !== null && (
                <span class="editorial-chart__legend-value">
                  {formatValue(entry.value)}
                  {chart.showPercentages &&
                    entry.percentage !== null &&
                    ` (${formatPercentage(entry.percentage, language)})`}
                </span>
              )}
            </span>
          </li>
        ))}
      </ul>
    )
  }

  <details class="editorial-chart__data">
    <summary>{copy.data}</summary>
    <EditorialChartTable
      chart={chart}
      language={language}
      labels={tableLabels}
      focusable
    />
  </details>
  <div class="editorial-chart__print-table">
    <EditorialChartTable
      chart={chart}
      language={language}
      labels={tableLabels}
    />
  </div>

  {
    (chart.note || showSource || chart.caption) && (
      <figcaption class="editorial-chart__caption">
        {chart.caption && <span>{chart.caption}</span>}
        {chart.note && (
          <span>
            <strong>{copy.note}:</strong> {chart.note}
          </span>
        )}
        {showSource && (
          <span>
            <strong>{copy.source}:</strong>{" "}
            {chart.sourceUrl ? (
              <a
                href={chart.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {chart.sourceLabel ?? chart.sourceUrl}
              </a>
            ) : (
              chart.sourceLabel
            )}
            {chart.sourceDate && ` (${chart.sourceDate})`}
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .editorial-chart {
    margin-block: 2rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--chart-border);
    border-radius: var(--radius-lg);
    background: var(--chart-surface);
    color: var(--text);
    container: editorial-chart / inline-size;
  }
  .editorial-chart__title {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.2rem, 3vw, 1.55rem);
    font-weight: 700;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .editorial-chart__subtitle,
  .editorial-chart__summary {
    margin-block: 0.45rem 0;
    color: var(--text-muted);
  }
  .editorial-chart__measure {
    margin-block: 0.6rem 0;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .editorial-chart__tier--compact {
    display: none;
  }
  @container editorial-chart (max-width: 35rem) {
    .editorial-chart__tier--compact {
      display: block;
    }
    .editorial-chart__tier--wide {
      display: none;
    }
  }
  .editorial-chart__visual {
    max-width: 100%;
    margin-block: 1rem 0.5rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-color: var(--chart-scrollbar) transparent;
    outline-offset: 0.2rem;
  }
  /* Edge shadows appear only while there is more content to scroll to. */
  .editorial-chart__visual.is-scrollable {
    background:
      linear-gradient(to right, var(--chart-surface) 30%, transparent) left
        center / 24px 100% no-repeat local,
      linear-gradient(to left, var(--chart-surface) 30%, transparent) right
        center / 24px 100% no-repeat local,
      radial-gradient(farthest-side at 0 50%, rgb(0 0 0 / 0.25), transparent)
        left center / 10px 100% no-repeat scroll,
      radial-gradient(farthest-side at 100% 50%, rgb(0 0 0 / 0.25), transparent)
        right center / 10px 100% no-repeat scroll;
  }
  .editorial-chart__tier--compact .editorial-chart__visual:not(.is-scrollable) {
    max-width: 30rem;
    margin-inline: auto;
  }
  .editorial-chart__scroll-hint {
    margin: 0 0 0.6rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .editorial-chart__visual:focus-visible,
  .editorial-chart__data summary:focus-visible,
  .editorial-chart a:focus-visible {
    outline: 0.18rem solid var(--focus);
    outline-offset: 0.2rem;
  }
  .editorial-chart__svg {
    display: block;
    width: 100%;
    min-width: var(--chart-min-width, 0);
    height: auto;
    overflow: visible;
    font-family: inherit;
  }
  .chart-line {
    fill: none;
    stroke: var(--chart-grid);
    stroke-width: 1;
  }
  .chart-line--baseline {
    stroke: var(--chart-baseline);
    stroke-width: 2;
  }
  .chart-series-0 {
    color: var(--chart-blue);
    fill: var(--chart-blue);
    stroke: var(--chart-blue);
  }
  .chart-series-1 {
    color: var(--chart-teal);
    fill: var(--chart-teal);
    stroke: var(--chart-teal);
  }
  .chart-series-2 {
    color: var(--chart-gold);
    fill: var(--chart-gold);
    stroke: var(--chart-gold);
  }
  .chart-series-3 {
    color: var(--chart-purple);
    fill: var(--chart-purple);
    stroke: var(--chart-purple);
  }
  .chart-series-4 {
    color: var(--chart-slate);
    fill: var(--chart-slate);
    stroke: var(--chart-slate);
  }
  .chart-series-5 {
    color: var(--chart-indigo);
    fill: var(--chart-indigo);
    stroke: var(--chart-indigo);
  }
  .chart-series-6 {
    color: var(--chart-cyan);
    fill: var(--chart-cyan);
    stroke: var(--chart-cyan);
  }
  .chart-series-7 {
    color: var(--chart-brown);
    fill: var(--chart-brown);
    stroke: var(--chart-brown);
  }
  .chart-hole {
    fill: var(--chart-surface);
    stroke: var(--chart-surface);
  }
  .chart-pattern-line {
    fill: none;
    stroke: var(--chart-surface);
    stroke-width: 2;
  }
  .chart-line-path {
    fill: none;
    stroke-width: 3;
  }
  .chart-pos-1.chart-line-path,
  .chart-pos-1.chart-area {
    stroke-dasharray: 8 4;
  }
  .chart-pos-2.chart-line-path,
  .chart-pos-2.chart-area {
    stroke-dasharray: 2 4;
  }
  .chart-pos-3.chart-line-path,
  .chart-pos-3.chart-area {
    stroke-dasharray: 12 4 2 4;
  }
  .chart-pos-4.chart-line-path,
  .chart-pos-4.chart-area {
    stroke-dasharray: 6 3 1 3;
  }
  .chart-area {
    stroke: currentColor;
    stroke-width: 2;
    fill-opacity: 0.18;
  }
  .chart-pos-0.chart-area {
    fill-opacity: 0.24;
  }
  .chart-area.chart-pattern {
    fill-opacity: 0.55;
  }
  .chart-slice {
    stroke: var(--chart-surface);
    stroke-width: 2;
  }
  .chart-pattern {
    stroke: var(--chart-surface);
    stroke-width: 2;
  }
  .chart-text {
    fill: var(--chart-text);
    font-size: 13px;
  }
  .chart-text--axis {
    fill: var(--text-muted);
    font-size: 12px;
  }
  .chart-text--value {
    font-weight: 700;
  }
  .chart-text--value-inside {
    paint-order: stroke;
    stroke: var(--chart-surface);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .chart-text--category {
    font-weight: 600;
  }
  .chart-text--slice {
    fill: var(--chart-text);
    font-size: 15px;
    font-weight: 800;
    paint-order: stroke;
    stroke: var(--chart-surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .editorial-chart__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  .editorial-chart__legend-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .editorial-chart__swatch {
    display: grid;
    flex: 0 0 1.5rem;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    border-radius: 0.3rem;
    background: currentColor;
  }
  .editorial-chart__swatch span {
    color: var(--chart-surface);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .editorial-chart__swatch-graphic {
    flex: 0 0 1.75rem;
    width: 1.75rem;
    height: 1.125rem;
    overflow: visible;
  }
  .editorial-chart__legend-value {
    display: block;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .editorial-chart__data {
    margin-block-start: 0.8rem;
  }
  .editorial-chart__data summary {
    width: fit-content;
    min-height: 2.75rem;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--brand);
    cursor: pointer;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .editorial-chart__caption {
    display: grid;
    gap: 0.35rem;
    margin-block-start: 0.8rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .editorial-chart__caption a {
    color: var(--brand);
    overflow-wrap: anywhere;
  }
  .editorial-chart__fallback {
    padding: 0.8rem;
    border-inline-start: 0.2rem solid var(--brand);
    background: var(--surface-muted);
  }
  .editorial-chart__print-table {
    display: none;
  }
  @media (max-width: 35rem) {
    .editorial-chart {
      padding: 0.85rem;
    }
  }
  /* Print must never depend on the disclosure state. Browsers with ::details-content render the
     closed disclosure's content; the rest hide the disclosure and print a dedicated copy instead. */
  @media print {
    .editorial-chart {
      break-inside: avoid;
      border: 1px solid #777;
      background: #fff;
      color: #000;
      print-color-adjust: exact;
    }
    .editorial-chart__tier--compact {
      display: none !important;
    }
    .editorial-chart__tier--wide {
      display: block !important;
    }
    .editorial-chart__visual {
      overflow: visible;
      background: none;
    }
    .editorial-chart__svg {
      min-width: 0 !important;
    }
    .editorial-chart__scroll-hint {
      display: none;
    }
    .editorial-chart__data summary {
      display: none;
    }
  }
  @media print {
    @supports selector(::details-content) {
      .editorial-chart__data::details-content {
        content-visibility: visible;
        display: block;
      }
    }
    @supports not selector(::details-content) {
      .editorial-chart__data {
        display: none;
      }
      .editorial-chart__print-table {
        display: block;
      }
    }
  }
</style>
