---
import { safeCreateChartGeometry } from "../../lib/editorialChart/geometry.ts";
import {
  formatChartUnit,
  formatChartValue,
  formatPercentage,
} from "../../lib/editorialChart/format.ts";
import {
  createChartIdSuffix,
  normalizeEditorialChart,
} from "../../lib/editorialChart/normalize.ts";
import {
  CHART_PATTERN_PATHS,
  getPaletteIndex,
  isPolarChart,
} from "../../lib/editorialChart/palette.ts";
import {
  buildChartClientData,
  getEditorialChartCopy,
} from "../../lib/editorialChart/interactive.ts";
import EditorialChartTable from "./EditorialChartTable.astro";
import type {
  ChartGeometry,
  ChartLanguage,
  ChartLayout,
  EditorialChartInput,
  NormalizedChart,
  SvgShape,
} from "../../lib/editorialChart/types.ts";

interface Props {
  node: EditorialChartInput;
  language: ChartLanguage;
  index?: number;
}

const { node, language, index = 0 } = Astro.props;
const chart = normalizeEditorialChart(node);
const polar = isPolarChart(chart);
// Polar charts are one fixed-size SVG; Cartesian charts get a compact and a wide layout, chosen by CSS.
const layoutKeys: ChartLayout[] = polar ? ["wide"] : ["compact", "wide"];
const results = layoutKeys.map((key) => ({
  key,
  ...safeCreateChartGeometry(chart, language, key),
}));
const geometryError = results.find((result) => result.error)?.error;
const tiers = results.flatMap((result) =>
  result.geometry && !geometryError
    ? [{ key: result.key, geometry: result.geometry as ChartGeometry }]
    : [],
);
const hasVisual = tiers.length > 0;
if (geometryError) {
  console.error(
    `[editorialChart] Geometry failed for "${chart.title ?? "untitled"}": ${geometryError}`,
  );
}
if (chart.warnings.length) {
  console.warn(
    `[editorialChart] "${chart.title ?? "untitled"}": ${chart.warnings.join("; ")}`,
  );
}
const idSuffix = createChartIdSuffix(node, index);
const titleId = `editorial-chart-title-${idSuffix}`;
const descriptionId = `editorial-chart-description-${idSuffix}`;
const copy = getEditorialChartCopy(language);
const clientData = buildChartClientData(chart, language);
const serializedClientData = JSON.stringify(clientData).replace(/</g, "\\u003c");
const isHorizontal = chart.chartType === "horizontalBar";
const targetAriaLabel = (catIdx: number, seriesIdx: number): string => {
  const category = chart.categories[catIdx] || `${copy.category} ${catIdx + 1}`;
  if (polar) {
    const val = clientData.series[0]?.formattedValues[catIdx] ?? copy.unavailable;
    const pct = clientData.percentages[catIdx];
    return pct ? `${category}: ${val} (${pct})` : `${category}: ${val}`;
  }
  const s = clientData.series[seriesIdx];
  const val = s?.formattedValues[catIdx] ?? copy.unavailable;
  return chart.series.length > 1 && s
    ? `${category}, ${s.label}: ${val}`
    : `${category}: ${val}`;
};

const summaryText = (item: NormalizedChart) =>
  item.altSummary ??
  item.description ??
  copy.summary
    .replace(
      "{categories}",
      new Intl.NumberFormat(language === "ne" ? "ne-NP" : "nb-NO").format(
        item.categories.length,
      ),
    )
    .replace(
      "{series}",
      new Intl.NumberFormat(language === "ne" ? "ne-NP" : "nb-NO").format(
        item.series.length,
      ),
    );

const legendEntries = polar
  ? chart.categories.map((label, index) => ({
      label,
      index,
      value: chart.showValues ? (chart.series[0]?.values[index] ?? null) : null,
      percentage: chart.percentages[index] ?? null,
    }))
  : chart.series.map((item, index) => ({
      label: item.shortLabel ?? item.label,
      index,
      value: null,
      percentage: null,
    }));

const interactiveLegend = hasVisual && legendEntries.length > 1;

const formatValue = (value: number) => formatChartValue(value, chart, language);
const showSource = chart.sourceLabel || chart.sourceUrl || chart.sourceDate;
const measureParts = [
  !polar && chart.series.length === 1 ? chart.series[0].label : undefined,
  chart.unit
    ? `${copy.unit}: ${formatChartUnit(chart.unit, language)}`
    : undefined,
].filter(Boolean);
const tableLabels = {
  category: copy.category,
  unavailable: copy.unavailable,
  dataTable: copy.dataTable,
};
const patternSlots = Array.from(
  { length: polar ? chart.categories.length : chart.series.length },
  (_, position) => ({
    position,
    color: getPaletteIndex(chart, position),
    path: CHART_PATTERN_PATHS[position % CHART_PATTERN_PATHS.length],
  }),
);
---

<figure
  class="editorial-chart"
  aria-labelledby={chart.title ? titleId : undefined}
  aria-label={chart.title ? undefined : copy.chart}
>
  <script
    is:inline
    type="application/json"
    data-chart-payload
    set:html={serializedClientData}
  />
  <header class="editorial-chart__header">
    <div class="editorial-chart__header-main">
      {
        chart.title && (
          <p class="editorial-chart__title" id={titleId}>
            {chart.title}
          </p>
        )
      }
      {
        chart.subtitle && (
          <p class="editorial-chart__subtitle">{chart.subtitle}</p>
        )
      }
      {
        chart.showDataSummary && (
          <p class="editorial-chart__summary">{summaryText(chart)}</p>
        )
      }
      {
        measureParts.length > 0 && (
          <p class="editorial-chart__measure">{measureParts.join(" · ")}</p>
        )
      }
    </div>
    <div class="editorial-chart__toolbar" hidden>
      {
        hasVisual && (
          <div class="editorial-chart__segmented" role="group" aria-label={copy.chart}>
            <button
              type="button"
              class="editorial-chart__seg-btn"
              data-chart-view="chart"
              aria-pressed="true"
            >
              {copy.chartView}
            </button>
            <button
              type="button"
              class="editorial-chart__seg-btn"
              data-chart-view="table"
              aria-pressed="false"
            >
              {copy.tableView}
            </button>
          </div>
        )
      }
      <button
        type="button"
        class="editorial-chart__csv-btn"
        data-chart-action="csv"
        aria-label={`${copy.downloadCsv} (${chart.title ?? copy.chart})`}
      >
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
          <path
            d="M8 2v7.5m0 0L5 6.5m3 3 3-3M3 12.5h10"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span>{copy.downloadCsv}</span>
      </button>
    </div>
  </header>

  <div class="editorial-chart__visual-group">
    {
      hasVisual ? (
        tiers.map(({ key, geometry }) => (
          <div
            class={
              polar
                ? "editorial-chart__tier"
                : `editorial-chart__tier editorial-chart__tier--${key}`
            }
          >
            <div class="editorial-chart__stage">
              <div
                class:list={[
                  "editorial-chart__visual",
                  geometry.scrolls && "is-scrollable",
                ]}
                tabindex={geometry.scrolls ? 0 : undefined}
                style={
                  geometry.scrolls
                    ? `--chart-min-width: ${geometry.width}px`
                    : undefined
                }
              >
                <svg
                  class="editorial-chart__svg"
                  viewBox={`0 0 ${geometry.width} ${geometry.height}`}
                  role="img"
                  aria-label={copy.chart}
                  aria-describedby={
                    chart.showDataSummary ? undefined : `${descriptionId}-${key}`
                  }
                  focusable="false"
                  data-plot-top={geometry.plotTop}
                  data-plot-bottom={geometry.plotBottom}
                  data-plot-left={geometry.plotLeft}
                  data-plot-right={geometry.plotRight}
                  data-cat-x={geometry.categoryXPositions?.join(",")}
                >
                  <defs>
                    {patternSlots.map((slot) => (
                      <pattern
                        id={`chart-pattern-${idSuffix}-${key}-${slot.position}`}
                        width="8"
                        height="8"
                        patternUnits="userSpaceOnUse"
                      >
                        <rect
                          width="8"
                          height="8"
                          class={`chart-series-${slot.color}`}
                        />
                        <path d={slot.path} class="chart-pattern-line" />
                      </pattern>
                    ))}
                  </defs>
                  {!chart.showDataSummary && (
                    <desc id={`${descriptionId}-${key}`}>{summaryText(chart)}</desc>
                  )}
                  {!polar && !isHorizontal && (
                    <line
                      class="editorial-chart__crosshair"
                      aria-hidden="true"
                    />
                  )}
                  {geometry.shapes.map((shape: SvgShape) => {
                    if (shape.type === "line") {
                      return (
                        <line
                          x1={shape.x1}
                          y1={shape.y1}
                          x2={shape.x2}
                          y2={shape.y2}
                          class:list={[
                            "chart-line",
                            shape.className && `chart-line--${shape.className}`,
                          ]}
                        />
                      );
                    }
                    if (shape.type === "rect") {
                      const interactive = typeof shape.categoryIndex === "number";
                      const styleParts = [
                        shape.pattern
                          ? `fill: url(#chart-pattern-${idSuffix}-${key}-${shape.position})`
                          : undefined,
                        shape.originX !== undefined
                          ? `--origin-x: ${shape.originX}px`
                          : undefined,
                        shape.originY !== undefined
                          ? `--origin-y: ${shape.originY}px`
                          : undefined,
                        interactive
                          ? `--cat-idx: ${shape.categoryIndex}`
                          : undefined,
                      ].filter(Boolean);
                      return (
                        <rect
                          x={shape.x}
                          y={shape.y}
                          width={shape.width}
                          height={shape.height}
                          rx="3"
                          style={styleParts.length ? styleParts.join("; ") : undefined}
                          class:list={[
                            `chart-series-${shape.series}`,
                            `chart-pos-${shape.position}`,
                            shape.pattern && "chart-pattern",
                            interactive && "chart-target",
                            interactive && "chart-bar",
                            interactive &&
                              (isHorizontal
                                ? "chart-bar--horizontal"
                                : "chart-bar--vertical"),
                          ]}
                          data-cat-idx={shape.categoryIndex}
                          data-series-idx={shape.position}
                          data-origin-x={shape.originX}
                          tabindex={interactive ? 0 : undefined}
                          aria-label={
                            interactive
                              ? targetAriaLabel(shape.categoryIndex!, shape.position)
                              : undefined
                          }
                        />
                      );
                    }
                    if (shape.type === "hole") {
                      return (
                        <circle
                          cx={shape.cx}
                          cy={shape.cy}
                          r={shape.r}
                          class="chart-hole"
                        />
                      );
                    }
                    if (shape.type === "circle") {
                      const interactive = typeof shape.categoryIndex === "number";
                      return (
                        <circle
                          cx={shape.cx}
                          cy={shape.cy}
                          r={shape.r}
                          class:list={[
                            `chart-series-${shape.series}`,
                            `chart-pos-${shape.position}`,
                            interactive && "chart-target",
                            interactive && "chart-point",
                          ]}
                          data-cat-idx={shape.categoryIndex}
                          data-series-idx={shape.position}
                          tabindex={interactive ? 0 : undefined}
                          aria-label={
                            interactive
                              ? targetAriaLabel(shape.categoryIndex!, shape.position)
                              : undefined
                          }
                        />
                      );
                    }
                    if (shape.type === "path") {
                      const styleParts = [
                        shape.pattern
                          ? `fill: url(#chart-pattern-${idSuffix}-${key}-${shape.position})`
                          : undefined,
                        shape.slice && shape.centerX !== undefined
                          ? `transform-origin: ${shape.centerX}px ${shape.centerY}px`
                          : undefined,
                      ].filter(Boolean);
                      return (
                        <path
                          d={shape.d}
                          style={styleParts.length ? styleParts.join("; ") : undefined}
                          class:list={[
                            `chart-series-${shape.series}`,
                            `chart-pos-${shape.position}`,
                            shape.slice
                              ? "chart-slice chart-target"
                              : shape.fill
                                ? "chart-area"
                                : "chart-line-path",
                            shape.pattern && "chart-pattern",
                          ]}
                          data-cat-idx={shape.slice ? shape.position : undefined}
                          data-series-idx={shape.slice ? 0 : shape.position}
                          data-tip-x={shape.slice ? shape.tipX : undefined}
                          data-tip-y={shape.slice ? shape.tipY : undefined}
                          tabindex={shape.slice ? 0 : undefined}
                          aria-label={
                            shape.slice ? targetAriaLabel(shape.position, 0) : undefined
                          }
                        />
                      );
                    }
                    return (
                      <text
                        x={shape.x}
                        y={shape.y}
                        text-anchor={shape.anchor ?? "middle"}
                        class:list={[
                          "chart-text",
                          shape.className && `chart-text--${shape.className}`,
                        ]}
                      >
                        {shape.lines
                          ? shape.lines.map((line, index) => (
                              <tspan x={shape.x} dy={index === 0 ? 0 : "1.15em"}>
                                {line}
                              </tspan>
                            ))
                          : shape.text}
                      </text>
                    );
                  })}
                  {chart.chartType === "donut" && (
                    <g class="chart-donut-center" aria-hidden="true">
                      <text
                        x="180"
                        y="167"
                        text-anchor="middle"
                        class="chart-donut-center__pct"
                      />
                      <text
                        x="180"
                        y="188"
                        text-anchor="middle"
                        class="chart-donut-center__label"
                      />
                    </g>
                  )}
                </svg>
              </div>
              <div
                class="editorial-chart__tooltip"
                role="status"
                aria-live="polite"
                hidden
              />
            </div>
            {geometry.scrolls && (
              <p class="editorial-chart__scroll-hint">{copy.scrollHint}</p>
            )}
          </div>
        ))
      ) : (
        <>
          <p class="editorial-chart__fallback">{copy.chartUnavailable}</p>
          {import.meta.env.DEV && geometryError && (
            <p class="editorial-chart__fallback" data-chart-geometry-error>
              Dev only: {geometryError}
            </p>
          )}
        </>
      )
    }

    {
      chart.legendVisible && legendEntries.length > 0 && (
        <ul class="editorial-chart__legend" aria-label={copy.legend}>
          {legendEntries.map((entry) => (
            <li class="editorial-chart__legend-item">
              {interactiveLegend ? (
                <button
                  type="button"
                  class="editorial-chart__legend-btn"
                  data-legend-index={entry.index}
                  aria-pressed="true"
                >
                  {polar || !hasVisual ? (
                    <span
                      class={`editorial-chart__swatch chart-series-${getPaletteIndex(chart, entry.index)}`}
                      aria-hidden="true"
                    >
                      {polar && <span>{entry.index + 1}</span>}
                    </span>
                  ) : (
                    <svg
                      class="editorial-chart__swatch-graphic"
                      viewBox="0 0 28 18"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <defs>
                        <pattern
                          id={`chart-pattern-${idSuffix}-legend-${entry.index}`}
                          width="8"
                          height="8"
                          patternUnits="userSpaceOnUse"
                        >
                          <rect
                            width="8"
                            height="8"
                            class={`chart-series-${getPaletteIndex(chart, entry.index)}`}
                          />
                          <path
                            d={
                              CHART_PATTERN_PATHS[
                                entry.index % CHART_PATTERN_PATHS.length
                              ]
                            }
                            class="chart-pattern-line"
                          />
                        </pattern>
                      </defs>
                      {chart.chartType === "line" ? (
                        <line
                          x1="2"
                          y1="9"
                          x2="26"
                          y2="9"
                          class={`chart-series-${getPaletteIndex(chart, entry.index)} chart-pos-${entry.index} chart-line-path`}
                        />
                      ) : (
                        <rect
                          width="28"
                          height="18"
                          rx="3"
                          class={`chart-series-${getPaletteIndex(chart, entry.index)}`}
                          style={
                            entry.index > 0
                              ? `fill: url(#chart-pattern-${idSuffix}-legend-${entry.index});`
                              : undefined
                          }
                        />
                      )}
                    </svg>
                  )}
                  <span class="editorial-chart__legend-text">
                    <strong>{entry.label}</strong>
                    {entry.value !== null && (
                      <span class="editorial-chart__legend-value">
                        {formatValue(entry.value)}
                        {chart.showPercentages &&
                          entry.percentage !== null &&
                          ` (${formatPercentage(entry.percentage, language)})`}
                      </span>
                    )}
                  </span>
                </button>
              ) : (
                <>
                  {polar || !hasVisual ? (
                    <span
                      class={`editorial-chart__swatch chart-series-${getPaletteIndex(chart, entry.index)}`}
                      aria-hidden="true"
                    >
                      {polar && <span>{entry.index + 1}</span>}
                    </span>
                  ) : (
                    <svg
                      class="editorial-chart__swatch-graphic"
                      viewBox="0 0 28 18"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <defs>
                        <pattern
                          id={`chart-pattern-${idSuffix}-legend-${entry.index}`}
                          width="8"
                          height="8"
                          patternUnits="userSpaceOnUse"
                        >
                          <rect
                            width="8"
                            height="8"
                            class={`chart-series-${getPaletteIndex(chart, entry.index)}`}
                          />
                          <path
                            d={
                              CHART_PATTERN_PATHS[
                                entry.index % CHART_PATTERN_PATHS.length
                              ]
                            }
                            class="chart-pattern-line"
                          />
                        </pattern>
                      </defs>
                      {chart.chartType === "line" ? (
                        <line
                          x1="2"
                          y1="9"
                          x2="26"
                          y2="9"
                          class={`chart-series-${getPaletteIndex(chart, entry.index)} chart-pos-${entry.index} chart-line-path`}
                        />
                      ) : (
                        <rect
                          width="28"
                          height="18"
                          rx="3"
                          class={`chart-series-${getPaletteIndex(chart, entry.index)}`}
                          style={
                            entry.index > 0
                              ? `fill: url(#chart-pattern-${idSuffix}-legend-${entry.index});`
                              : undefined
                          }
                        />
                      )}
                    </svg>
                  )}
                  <span>
                    <strong>{entry.label}</strong>
                    {entry.value !== null && (
                      <span class="editorial-chart__legend-value">
                        {formatValue(entry.value)}
                        {chart.showPercentages &&
                          entry.percentage !== null &&
                          ` (${formatPercentage(entry.percentage, language)})`}
                      </span>
                    )}
                  </span>
                </>
              )}
            </li>
          ))}
          {interactiveLegend && !polar && (
            <li class="editorial-chart__legend-item">
              <button
                type="button"
                class="editorial-chart__legend-reset"
                data-chart-action="reset-series"
                hidden
              >
                {copy.showAll}
              </button>
            </li>
          )}
        </ul>
      )
    }
  </div>

  <details class="editorial-chart__data">
    <summary>{copy.data}</summary>
    <EditorialChartTable
      chart={chart}
      language={language}
      labels={tableLabels}
      focusable
    />
  </details>
  <div class="editorial-chart__print-table">
    <EditorialChartTable
      chart={chart}
      language={language}
      labels={tableLabels}
    />
  </div>

  <figcaption class="editorial-chart__caption">
    <div class="editorial-chart__caption-meta">
      {chart.caption && <span>{chart.caption}</span>}
      {chart.note && (
        <span>
          <strong>{copy.note}:</strong> {chart.note}
        </span>
      )}
      {showSource && (
        <span>
          <strong>{copy.source}:</strong>{" "}
          {chart.sourceUrl ? (
            <a
              href={chart.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {chart.sourceLabel ?? chart.sourceUrl}
            </a>
          ) : (
            chart.sourceLabel
          )}
          {chart.sourceDate && ` (${chart.sourceDate})`}
        </span>
      )}
    </div>
    <span class="editorial-chart__brand" aria-hidden="true">nepali.no</span>
  </figcaption>
</figure>

<script>
  import { initEditorialCharts } from "../../lib/editorialChart/client.ts";

  initEditorialCharts();
  document.addEventListener("astro:page-load", () => initEditorialCharts());
</script>

<style>
  .editorial-chart {
    margin-block: 2rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid color-mix(in srgb, var(--chart-border) 72%, transparent);
    border-top: 3px solid var(--chart-blue);
    border-radius: var(--radius-lg);
    background: var(--chart-surface);
    box-shadow: 0 2px 10px rgb(23 37 52 / 0.04);
    color: var(--text);
    container: editorial-chart / inline-size;
  }
  .editorial-chart__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }
  .editorial-chart__header-main {
    flex: 1 1 16rem;
    min-width: 0;
  }
  .editorial-chart__title {
    margin: 0;
    color: var(--chart-text);
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    font-weight: 700;
    line-height: 1.32;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .editorial-chart__subtitle,
  .editorial-chart__summary {
    margin-block: 0.4rem 0;
    color: var(--text-muted);
    line-height: 1.45;
  }
  .editorial-chart__measure {
    display: inline-block;
    margin-block: 0.65rem 0;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: var(--chart-table-heading);
    border: 1px solid color-mix(in srgb, var(--chart-border) 65%, transparent);
    color: var(--chart-text);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .editorial-chart__toolbar {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }
  .editorial-chart__toolbar[hidden] {
    display: none;
  }
  .editorial-chart__segmented {
    display: inline-flex;
    padding: 0.2rem;
    border: 1px solid color-mix(in srgb, var(--chart-border) 75%, transparent);
    border-radius: 999px;
    background: var(--chart-table-heading);
  }
  .editorial-chart__seg-btn,
  .editorial-chart__csv-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    min-height: 2rem;
    padding: 0.25rem 0.72rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 140ms ease,
      color 140ms ease,
      box-shadow 140ms ease;
  }
  .editorial-chart__seg-btn[aria-pressed="true"] {
    background: var(--chart-surface);
    color: var(--chart-text);
    box-shadow: 0 1px 3px rgb(23 37 52 / 0.14);
  }
  .editorial-chart__csv-btn {
    border: 1px solid color-mix(in srgb, var(--chart-border) 75%, transparent);
    background: var(--chart-surface);
    color: var(--chart-text);
  }
  .editorial-chart__seg-btn:hover,
  .editorial-chart__csv-btn:hover {
    color: var(--chart-text);
  }
  .editorial-chart__csv-btn:hover {
    background: var(--chart-table-heading);
  }
  .editorial-chart.is-interactive[data-view="table"] .editorial-chart__visual-group {
    display: none;
  }
  .editorial-chart.is-interactive[data-view="chart"] .editorial-chart__data {
    display: none;
  }
  .editorial-chart.is-interactive[data-view="table"] .editorial-chart__data summary {
