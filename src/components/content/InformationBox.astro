---
import { PortableText } from "astro-portabletext";
import type { SupportedLanguage } from "../../i18n/config";
import {
  normalizeInformationBox,
  type InformationBoxInput,
} from "../../lib/informationBox/normalize.ts";

interface Props {
  node: InformationBoxInput;
  language: SupportedLanguage | string;
  index?: number;
}

const { node, language, index = 0 } = Astro.props;
const box = normalizeInformationBox(node, index);
const titleId = box?.title ? `information-box-title-${box.idSuffix}` : undefined;
---

{
  box && (
    <aside
      class={`information-box information-box--${box.variant}`}
      aria-labelledby={titleId}
    >
      {box.title && (
        <div class="information-box__header">
          <p class="information-box__title" id={titleId}>
            {box.title}
          </p>
        </div>
      )}
      <div class="information-box__body">
        <PortableText value={box.body as any} />
      </div>
    </aside>
  )
}

<style>
  .information-box {
    --box-accent: var(--civic);
    --box-tint: var(--surface-muted);
    max-width: 100%;
    margin-block: 1.75rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border-strong);
    border-inline-start: 0.3rem solid var(--box-accent);
    border-radius: var(--radius-md);
    background: var(--box-tint);
    color: var(--text);
    font-size: 1rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
    break-inside: avoid;
  }

  .information-box--important {
    --box-accent: var(--civic-deep);
    --box-tint: var(--color-civic-100);
  }

  .information-box--attention {
    --box-accent: var(--brand);
    --box-tint: var(--color-brand-50);
    border-color: var(--brand);
    border-inline-start-width: 0.45rem;
  }

  .information-box--tip {
    --box-accent: var(--success);
    --box-tint: var(--color-success-50);
  }

  .information-box--fact {
    --box-accent: var(--text-soft);
    --box-tint: var(--surface-warm);
  }

  .information-box__header {
    margin-block-end: 0.5rem;
  }

  .information-box__title {
    margin: 0;
    color: var(--civic-deep);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;
    text-wrap: balance;
  }

  .information-box__body > :global(* + *) {
    margin-block-start: 0.75em;
  }

  .information-box__body :global(p),
  .information-box__body :global(ul),
  .information-box__body :global(ol) {
    margin-block: 0;
  }

  .information-box__body :global(ul),
  .information-box__body :global(ol) {
    padding-inline-start: 1.5rem;
  }

  .information-box__body :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (min-width: 40rem) {
    .information-box {
      padding: 1.25rem 1.5rem;
    }
  }

  @media print {
    .information-box {
      background: none;
      border-color: #000;
      color: #000;
      box-shadow: none;
    }

    .information-box__title {
      color: #000;
    }

    .information-box__body :global(a) {
      color: inherit;
    }
  }
</style>
