---
import TravelHelp from "./TravelHelp";
import "./travelHelp.css";
import type { JourneyRequest } from "../../lib/entur/types";
import type { SupportedLanguage } from "../../i18n/config";
import { getTranslations } from "../../i18n";

interface Props {
  destination: JourneyRequest["destination"];
  language: SupportedLanguage;
  defaultOpen?: boolean;
}
const { destination, language, defaultOpen = false } = Astro.props;
---

<TravelHelp
  client:load
  destination={destination}
  language={language}
  defaultOpen={defaultOpen}
  labels={getTranslations(language).travelHelp}
/>
