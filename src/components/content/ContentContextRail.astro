---
interface Props {
  label: string
}

const {label} = Astro.props
---

<aside class="content-context-rail" aria-label={label}>
  <slot />
</aside>

<style>
  .content-context-rail {
    display: grid;
    align-content: start;
    align-self: start;
    gap: 1rem;
    position: sticky;
    inset-block-start: 1.5rem;
    min-width: 0;
  }

  .content-context-rail :global(.verification-scopes) {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .content-context-rail :global(.verification-scopes li) {
    position: relative;
    padding-inline-start: 1.1rem;
    color: var(--civic-deep);
    font-size: 0.9rem;
  }

  .content-context-rail :global(.verification-scopes li::before) {
    content: '✓';
    position: absolute;
    inset-inline-start: 0;
    color: var(--success);
    font-weight: 800;
  }

  .content-context-rail :global(.translation-card) {
    display: grid;
    min-width: 0;
    gap: 0.35rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    color: var(--civic-deep);
    text-decoration: none;
  }

  .content-context-rail :global(.translation-card span) {
    color: var(--brand);
    font-size: 0.8rem;
    font-weight: 760;
  }

  .content-context-rail :global(.translation-card:hover) {
    border-color: var(--civic);
    background: var(--surface-muted);
    color: var(--civic-deep);
  }

  @media (max-width: 58rem) {
    .content-context-rail {
      position: static;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .content-context-rail {
      grid-template-columns: 1fr;
    }
  }
</style>
