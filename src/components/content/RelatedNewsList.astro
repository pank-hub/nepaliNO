---
import type {SupportedLanguage} from '../../i18n/config'

interface RelatedNewsItem {
  title: string
  slug: string
  language: SupportedLanguage
}

interface Props {
  articles: RelatedNewsItem[]
  heading: string
}

const {articles, heading} = Astro.props
---

<section class="related-news-list" aria-labelledby="related-news-heading">
  <h2 id="related-news-heading">{heading}</h2>
  <ol>
    {articles.map((article) => (
      <li>
        <a href={`/${article.language}/news/${article.slug}/`}>{article.title}</a>
      </li>
    ))}
  </ol>
</section>

<style>
  .related-news-list {
    padding: 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-warm);
    box-shadow: var(--shadow-soft);
  }

  .related-news-list h2 {
    color: var(--civic-deep);
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .related-news-list ol {
    display: grid;
    gap: 0;
    margin: 0.8rem 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .related-news-list li {
    border-bottom: 1px solid var(--border);
  }

  .related-news-list li:last-child {
    border-bottom: 0;
  }

  .related-news-list a {
    display: block;
    padding-block: 0.8rem;
    color: var(--civic-deep);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
  }

  .related-news-list a:hover {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
