---
import {
  MAP_PROVIDER,
  ROUTING_PROVIDER,
  resolveMapDisplaySettings,
  validateMapLocation,
  type MapEditorialPath,
  type MapLocation,
  type MapPlace,
  type MapRoute,
  type PlaceIcon,
} from "../../lib/maps/location";
import {isOpenStreetMapUrl} from "../../lib/maps/publicMapUrl";
import {
  iconForPlace,
  isLegacyBlock,
  normalizePlaces,
  publicEditorialPath,
  publicRoute,
  validPlaces,
  validatePlaces,
} from "../../lib/maps/places";

interface Props {
  location?: MapLocation;
  locations?: MapPlace[];
  initialZoom?: number;
  route?: MapRoute;
  editorialPath?: MapEditorialPath;
  loadingBehavior?: "automatic" | "click";
  immediate?: boolean;
  contextSidebar?: boolean;
  markerLabel?: string;
  markerIcon?: PlaceIcon;
  markerShowLabel?: boolean;
  showViewOnMapActions?: boolean;
  showOpenStreetMapLinks?: boolean;
  showLocationList?: boolean;
  showOpenStreetMapControl?: boolean;
  showFullscreenControl?: boolean;
  description: string;
  labels: {
    load: string;
    loading: string;
    failed: string;
    externalNotice: string;
    exact: string;
    approximate: string;
    openInOsm: string;
    openMapInOsm: string;
    viewMapFullscreen: string;
    exitMapFullscreen: string;
    fullscreenFailed: string;
    zoomIn: string;
    zoomOut: string;
    approximateRadius: string;
    locationsList: string;
    showOnMap: string;
    defaultPlaceLabel: string;
    routeHeading: string;
    routeSummary: string;
    routeEstimate: string;
    routeCalculated: string;
    routeAttribution: string;
    reportMapError: string;
  };
  title?: string;
  caption?: string;
  sourceLabel?: string;
  sourceUrl?: string;
  class?: string;
}

const {
  location,
  locations,
  initialZoom,
  route: routeInput,
  editorialPath: pathInput,
  loadingBehavior,
  immediate = false,
  contextSidebar = false,
  markerLabel,
  markerIcon,
  markerShowLabel,
  showViewOnMapActions,
  showOpenStreetMapLinks,
  showLocationList,
  showOpenStreetMapControl,
  showFullscreenControl,
  description,
  labels,
  title,
  caption,
  sourceLabel,
  sourceUrl,
  class: className = "",
} = Astro.props;
const display = resolveMapDisplaySettings({
  loadingBehavior,
  showViewOnMapActions,
  showOpenStreetMapLinks,
  showLocationList,
  showOpenStreetMapControl,
  showFullscreenControl,
});
const normalizedPlaces =
  normalizePlaces({ location, locations, title }, labels.defaultPlaceLabel);
const places = validPlaces(
  isLegacyBlock({location, locations}) && normalizedPlaces.length
    ? [{...normalizedPlaces[0], label: markerLabel?.trim() || normalizedPlaces[0].label, icon: markerIcon ?? normalizedPlaces[0].icon, showLabel: markerShowLabel}]
    : normalizedPlaces,
);
const legacy = isLegacyBlock({ location, locations });
const error =
  places.length === 0
    ? ((legacy ? validateMapLocation(location) : validatePlaces(locations)) ??
      "Choose a map location.")
    : undefined;
const route = places.length > 0 ? publicRoute(routeInput, places) : undefined;
const path = places.length > 0 ? publicEditorialPath(pathInput) : undefined;
const single = places.length === 1 ? places[0] : undefined;
const precision = single?.precision === "approximate" ? "approximate" : "exact";
const showList = !legacy || places.length > 1 || showLocationList !== undefined;
// Legacy blocks keep their stored zoom; a lone new exact place may set its own.
const fixedZoom =
  route || path || !single
    ? undefined
    : legacy
      ? location?.initialZoom
      : single.precision === "exact"
        ? (initialZoom ?? 15)
        : undefined;
const safeSourceUrl = (() => {
  if (!sourceUrl || isOpenStreetMapUrl(sourceUrl)) return undefined;
  try {
    const url = new URL(sourceUrl);
    return url.protocol === "http:" || url.protocol === "https:"
      ? url.toString()
      : undefined;
  } catch {
    return undefined;
  }
})();
const radiusText = (place: MapPlace) =>
  labels.approximateRadius.replace(
    "{radius}",
    String(place.radiusMeters ?? ""),
  );
const precisionLabel =
  places.length > 1
    ? ""
    : precision === "approximate"
      ? `${labels.approximate} · ${radiusText(single!)}`
      : contextSidebar ? "" : labels.exact;
const clientPlaces = places.map((place) => ({
  key: place._key,
  label: place.label,
  description: place.description,
  lat: place.coordinates!.lat,
  lng: place.coordinates!.lng,
  precision: place.precision,
  radius: place.precision === "approximate" ? place.radiusMeters : undefined,
  icon: place.precision === "exact" ? iconForPlace(place) : undefined,
  showLabel: place.showLabel !== false,
}));
const routeSummary = route
  ? labels.routeSummary
      .replace("{distance}", (route.distanceMeters! / 1000).toFixed(1))
      .replace(
        "{duration}",
        String(Math.max(1, Math.round(route.durationSeconds! / 60))),
      )
  : "";
const routeDate = route?.calculatedAt?.slice(0, 10);
const routeData = route?.geometry;
const mapId = `location-map-${crypto.randomUUID()}`;
---

{
  error ? (
    <aside
      class={`location-map location-map--fallback ${className}`}
      role="note"
    >
      {!contextSidebar && title && <h2>{title}</h2>}
      <p>{contextSidebar ? labels.failed : description || error}</p>
      {contextSidebar && title && <p>{title}</p>}
      {caption && <p>{caption}</p>}
      {safeSourceUrl && (
        <p>
          <a href={safeSourceUrl} target="_blank" rel="noopener noreferrer">
            {sourceLabel || safeSourceUrl}
          </a>
        </p>
      )}
    </aside>
  ) : (
    <figure
      class={`location-map ${contextSidebar ? "location-map--context" : ""} ${className}`}
      data-location-map
      data-map-id={mapId}
      data-loading-behavior={display.loadingBehavior}
      data-map-immediate={immediate ? "true" : undefined}
      data-show-location-list={String(display.showLocationList)}
      data-places={JSON.stringify(clientPlaces)}
      data-route={route ? routeData : undefined}
      data-path={path ? JSON.stringify(path) : undefined}
      data-zoom={fixedZoom ?? ""}
      data-description={description}
      data-tile-url={MAP_PROVIDER.tiles}
      data-attribution={MAP_PROVIDER.attribution}
      data-max-zoom={MAP_PROVIDER.maxZoom}
      data-referrer-policy={MAP_PROVIDER.referrerPolicy}
      data-load-label={labels.load}
      data-loading-label={labels.loading}
      data-failed-label={labels.failed}
      data-zoom-in-label={labels.zoomIn}
      data-zoom-out-label={labels.zoomOut}
      data-radius-label={labels.approximateRadius}
      data-fullscreen-failed-label={labels.fullscreenFailed}
    >
      {!contextSidebar && title && <h2 class="location-map__title">{title}</h2>}
      {!contextSidebar && <p class="location-map__description">{description}</p>}
      {!contextSidebar && <p class="location-map__external-notice">{labels.externalNotice}</p>}
      {display.showFullscreenControl && !contextSidebar && (
        <button type="button" class="location-map__fullscreen-open" data-map-fullscreen-open aria-haspopup="dialog" aria-controls={`${mapId}-fullscreen`} hidden>
          {labels.viewMapFullscreen}
        </button>
      )}
      <div class="location-map__stage" data-map-stage>
        <div
          class="location-map__canvas"
          data-map-canvas
          hidden
          aria-hidden="true"
        />
        <div class="location-map__controls" data-map-controls hidden>
          <button type="button" data-map-zoom-in aria-label={labels.zoomIn}>
            +
          </button>
          <button type="button" data-map-zoom-out aria-label={labels.zoomOut}>
            −
          </button>
        </div>
      </div>
      {display.showFullscreenControl && contextSidebar && (
        <button type="button" class="location-map__fullscreen-open" data-map-fullscreen-open aria-haspopup="dialog" aria-controls={`${mapId}-fullscreen`} hidden>
          {labels.viewMapFullscreen}
        </button>
      )}
      {display.showFullscreenControl && (
        <dialog id={`${mapId}-fullscreen`} class="location-map__fullscreen" data-map-fullscreen-dialog aria-label={labels.viewMapFullscreen}>
          <div class="location-map__fullscreen-header">
            <button type="button" data-map-fullscreen-exit>{labels.exitMapFullscreen}</button>
          </div>
        </dialog>
      )}
      <p
        class="location-map__status"
        data-map-status
        role="status"
        aria-live="polite"
      />
      <div class="location-map__actions">
        <button type="button" class="location-map__load" data-map-load hidden={immediate}>
          {labels.load}
        </button>
        {immediate && <noscript><p>{labels.failed}</p></noscript>}
      </div>
      {showList && (
        <section class="location-map__places">
          <h3 class="location-map__subheading">{labels.locationsList}</h3>
          <ol>
            {places.map((place) => (
              <li data-place-key={place._key}>
                <div class="location-map__place-details">
                  <strong>{place.label}</strong>
                  <span class="location-map__place-kind">
                    {place.precision === "approximate"
                      ? `${labels.approximate} · ${radiusText(place)}`
                      : labels.exact}
                  </span>
                  {place.description && <p>{place.description}</p>}
                </div>
                {display.showViewOnMapActions && (
                  <span class="location-map__place-actions">
                    {display.showViewOnMapActions && <button
                      type="button"
                      data-map-focus={place._key}
                      aria-label={`${labels.showOnMap}: ${place.label}`}
                      hidden
                    >
                      {labels.showOnMap}
                    </button>}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}
      {path && (path.label || path.description) && (
        <section class="location-map__path">
          {path.label && <h3 class="location-map__subheading">{path.label}</h3>}
          {path.description && <p>{path.description}</p>}
        </section>
      )}
      {route && (
        <section class="location-map__route">
          <h3 class="location-map__subheading">{labels.routeHeading}</h3>
          <p>
            {routeSummary} {labels.routeEstimate}
          </p>
          <p class="location-map__route-meta">
            {labels.routeCalculated
              .replace("{date}", routeDate ?? "")
              .replace(
                "{provider}",
                route.providerName ?? ROUTING_PROVIDER.name,
              )}{" "}
            {labels.routeAttribution}
          </p>
        </section>
      )}
      {(caption || safeSourceUrl || precisionLabel || (contextSidebar && title)) && <figcaption class="location-map__caption">
        {contextSidebar && title && <span>{title}</span>}
        {caption && <span>{caption}</span>}
        {safeSourceUrl && (
          <span>
            {sourceLabel && <span>{sourceLabel}: </span>}
            <a href={safeSourceUrl} target="_blank" rel="noopener noreferrer">
              {sourceLabel || safeSourceUrl}
            </a>
          </span>
        )}
        {precisionLabel && <span>{precisionLabel}</span>}
      </figcaption>}
    </figure>
  )
}

<script>
  import type {
    Circle,
    LatLngBoundsExpression,
    Map as LeafletMap,
    Marker,
    TileLayer,
  } from "leaflet";
  import {
    createPlaceIcon,
    labelContent,
    placeContent,
  } from "../../lib/maps/markerIcons";
  import type { PlaceIcon } from "../../lib/maps/location";
  import { decodePolyline6 } from "../../lib/maps/places";
  import { createMapActivator, observeAutomaticMaps, setMapListLoaded } from "../../lib/maps/mapLoading";
  import { createMapFullscreen } from "../../lib/maps/mapFullscreen";

  type ClientPlace = {
    key: string;
    label: string;
    description?: string;
    lat: number;
    lng: number;
    precision: "exact" | "approximate";
    radius?: number;
    icon?: PlaceIcon;
    showLabel?: boolean;
  };

  type MapRecord = {
    map: LeafletMap;
    layers: Map<string, Marker | Circle>;
    tiles: TileLayer;
    root: HTMLElement;
  };

  const readPlaces = (raw: string | undefined): ClientPlace[] => {
    try {
      const parsed: unknown = JSON.parse(raw ?? "[]");
      return Array.isArray(parsed)
        ? parsed.filter(
            (place): place is ClientPlace =>
              !!place &&
              Number.isFinite(place.lat) &&
              Number.isFinite(place.lng) &&
              typeof place.label === "string",
          )
        : [];
    } catch {
      return [];
    }
  };

  type ClientPath = {
    points: [number, number][];
    color: string;
    dashArray?: string;
  };

  const readPath = (raw: string | undefined): ClientPath | undefined => {
    try {
      const parsed = JSON.parse(raw ?? "null");
      return parsed &&
        Array.isArray(parsed.points) &&
        parsed.points.length > 1 &&
        /^#[0-9a-f]{6}$/i.test(parsed.color)
        ? parsed
        : undefined;
    } catch {
      return undefined;
    }
  };

  const activeMaps = new Map<string, MapRecord>();
  const fullscreen = createMapFullscreen(document, window);
  let mapGeneration = 0;
  let leafletPromise: Promise<typeof import("leaflet")> | undefined;

  const loadLeaflet = () => {
    leafletPromise ??= Promise.all([
      import("leaflet"),
      import("leaflet/dist/leaflet.css"),
    ]).then(([leaflet]) => leaflet).catch((error: unknown) => {
      leafletPromise = undefined;
      throw error;
    });
    return leafletPromise;
  };

  const announce = (root: HTMLElement, message: string) => {
    const status = root.querySelector<HTMLElement>("[data-map-status]");
    if (status) status.textContent = message;
  };

  const dispose = (root: HTMLElement) => {
    fullscreen.close(root, false);
    setMapListLoaded(root, false);
    const fullscreenButton = root.querySelector<HTMLButtonElement>("[data-map-fullscreen-open]");
    if (fullscreenButton) fullscreenButton.hidden = true;
    const id = root.dataset.mapId;
    if (!id) return;
    activeMaps.get(id)?.map.remove();
    activeMaps.delete(id);
    root.querySelector<HTMLElement>("[data-map-canvas]")?.replaceChildren();
  };

  const activate = async (root: HTMLElement) => {
    const id = root.dataset.mapId;
    if (!id || activeMaps.has(id)) return;
    const generation = mapGeneration;

    const canvas = root.querySelector<HTMLElement>("[data-map-canvas]");
    const button = root.querySelector<HTMLButtonElement>("[data-map-load]");
    const controls = root.querySelector<HTMLElement>("[data-map-controls]");
    const places = readPlaces(root.dataset.places);
    const zoom = Number(root.dataset.zoom);
    if (!canvas || !button || !controls || places.length === 0) {
      announce(root, root.dataset.failedLabel ?? "");
      if (button) button.hidden = false;
      return;
    }

    announce(root, root.dataset.loadingLabel ?? "");
    button.disabled = true;
    try {
      const L = await loadLeaflet();
      if (!root.isConnected || generation !== mapGeneration) {
        button.disabled = false;
        return;
      }
      canvas.hidden = false;
      canvas.setAttribute("aria-hidden", "false");
      canvas.setAttribute("role", "region");
      canvas.setAttribute("aria-label", root.dataset.description ?? "");
      controls.hidden = false;
      const map = L.map(canvas, {
        center: [places[0].lat, places[0].lng],
        zoom: Number.isFinite(zoom) && root.dataset.zoom !== "" ? zoom : 13,
        maxZoom: Number(root.dataset.maxZoom),
        keyboard: true,
        scrollWheelZoom: false,
        zoomControl: false,
      });
      const tiles = L.tileLayer(root.dataset.tileUrl ?? "", {
        attribution: root.dataset.attribution ?? "",
        maxZoom: Number(root.dataset.maxZoom),
        referrerPolicy: (root.dataset.referrerPolicy ||
          "strict-origin-when-cross-origin") as "strict-origin-when-cross-origin",
      }).addTo(map);
      const record: MapRecord = { map, tiles, root, layers: new Map() };
      activeMaps.set(id, record);

      const bounds = L.latLngBounds([]);
      const routePoints = root.dataset.route
        ? (() => {
            try {
              return decodePolyline6(root.dataset.route);
            } catch {
              return [];
            }
          })()
        : [];
      if (routePoints.length > 1) {
        L.polyline(routePoints, {
          color: "#1d4ed8",
          weight: 5,
          opacity: 0.8,
          interactive: false,
        }).addTo(map);
        bounds.extend(routePoints);
      }
      const editorialPath = readPath(root.dataset.path);
      if (editorialPath) {
        // White casing keeps the highlighted path readable over any base map.
        L.polyline(editorialPath.points, {
          color: "#ffffff",
          weight: 9,
          opacity: 0.9,
          interactive: false,
        }).addTo(map);
        L.polyline(editorialPath.points, {
          color: editorialPath.color,
          weight: 5,
          opacity: 1,
          dashArray: editorialPath.dashArray,
          interactive: false,
        }).addTo(map);
        bounds.extend(editorialPath.points);
      }
      for (const place of places) {
        const latlng: [number, number] = [place.lat, place.lng];
        if (place.precision === "approximate" && place.radius) {
          const circle = L.circle(latlng, {
            radius: place.radius,
            color: "#b42318",
            fillColor: "#f04438",
            fillOpacity: 0.18,
            weight: 2,
          }).addTo(map);
          // Popup opens at the click point, never at the circle centre.
          circle.bindPopup(placeContent(place, document));
          record.layers.set(place.key, circle);
          bounds.extend(circle.getBounds());
        } else {
          const marker = L.marker(latlng, {
            title: place.label,
            keyboard: true,
            icon: createPlaceIcon(L, place.icon),
          }).addTo(map);
          marker.bindPopup(placeContent(place, document));
          marker.bindTooltip(labelContent(place.label, document), {
            permanent: place.showLabel !== false,
            direction: "right",
            offset: [8, 0],
          });
          marker.getElement()?.setAttribute("aria-label", place.label);
          if (root.dataset.mapImmediate === "true" && place.showLabel !== false) marker.openPopup();
          record.layers.set(place.key, marker);
          bounds.extend(latlng);
        }
      }
      if (root.dataset.zoom === "" && bounds.isValid()) {
        map.fitBounds(bounds as LatLngBoundsExpression, {
          padding: [32, 32],
          maxZoom: 16,
        });
      }
      const only = places.length === 1 ? places[0] : undefined;
      if (only?.precision === "approximate") {
        const radiusLabel = (root.dataset.radiusLabel ?? "").replace(
          "{radius}",
          String(Math.round(only.radius ?? 0)),
        );
        canvas.setAttribute(
          "aria-label",
          `${root.dataset.description ?? ""}. ${radiusLabel}`,
        );
      }
      tiles.on("tileerror", () => {
        const wasFullscreen = fullscreen.close(root, false);
        dispose(root);
        canvas.hidden = true;
        canvas.setAttribute("aria-hidden", "true");
        controls.hidden = true;
        announce(root, root.dataset.failedLabel ?? "");
        button.hidden = false;
        button.disabled = false;
        button.textContent = root.dataset.loadLabel ?? "";
        if (wasFullscreen) button.focus();
      });
      tiles.once("load", () => {
        if (activeMaps.get(id) !== record) return;
        setMapListLoaded(root, true);
        const fullscreenButton = root.querySelector<HTMLButtonElement>("[data-map-fullscreen-open]");
        if (fullscreenButton) fullscreenButton.hidden = false;
        announce(root, "");
      });
      button.textContent = root.dataset.loadLabel ?? "";
      button.disabled = false;
      button.hidden = true;
      requestAnimationFrame(() => map.invalidateSize());
      announce(root, "");
    } catch (error) {
      dispose(root);
      canvas.hidden = true;
      canvas.setAttribute("aria-hidden", "true");
      controls.hidden = true;
      button.hidden = false;
      button.disabled = false;
      announce(root, root.dataset.failedLabel ?? "");
      console.error("[location-map] Unable to load map resources.", error);
    }
  };

  const ensureActive = createMapActivator(activate);

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const fullscreenButton = target.closest<HTMLButtonElement>("[data-map-fullscreen-open]");
    const fullscreenRoot = fullscreenButton?.closest<HTMLElement>("[data-location-map]");
    const fullscreenMap = fullscreenRoot?.dataset.mapId
      ? activeMaps.get(fullscreenRoot.dataset.mapId)?.map
      : undefined;
    if (fullscreenRoot && fullscreenMap) {
      try {
        fullscreen.open(fullscreenRoot, fullscreenMap);
      } catch (error) {
        announce(fullscreenRoot, fullscreenRoot.dataset.fullscreenFailedLabel ?? "");
        console.error("[location-map] Unable to open fullscreen map.", error);
      }
      return;
    }
    const zoomControl = target.closest<HTMLButtonElement>(
      "[data-map-zoom-in], [data-map-zoom-out]",
    );
    const zoomRoot = zoomControl?.closest<HTMLElement>("[data-location-map]");
    const zoomMap = zoomRoot?.dataset.mapId
      ? activeMaps.get(zoomRoot.dataset.mapId)?.map
      : undefined;
    if (zoomControl && zoomMap) {
      if (zoomControl.hasAttribute("data-map-zoom-in")) zoomMap.zoomIn();
      else zoomMap.zoomOut();
      return;
    }
    const focusControl = target.closest<HTMLButtonElement>("[data-map-focus]");
    const focusRoot = focusControl?.closest<HTMLElement>("[data-location-map]");
    if (focusControl && focusRoot) {
      void (async () => {
        await ensureActive(focusRoot);
        const focusRecord = focusRoot.dataset.mapId
          ? activeMaps.get(focusRoot.dataset.mapId)
          : undefined;
        if (!focusRecord) return;
        const layer = focusRecord.layers.get(focusControl.dataset.mapFocus ?? "");
        if (layer && "getBounds" in layer) {
          // Approximate area: fit the circle, never open anything at its centre.
          focusRecord.map.fitBounds(layer.getBounds(), { padding: [32, 32] });
        } else if (layer) {
          focusRecord.map.setView(
            layer.getLatLng(),
            Math.max(focusRecord.map.getZoom(), 16),
          );
          layer.openPopup();
        }
        focusRoot
          .querySelector<HTMLElement>("[data-map-canvas]")
          ?.scrollIntoView({ block: "nearest" });
      })();
      return;
    }
    const button = target.closest<HTMLButtonElement>("[data-map-load]");
    const root = button?.closest<HTMLElement>("[data-location-map]");
    if (root) void ensureActive(root);
  });

  let stopObserving = () => {};
  const initializeMaps = () => {
    stopObserving();
    const roots = document.querySelectorAll<HTMLElement>("[data-location-map]");
    roots.forEach((root) => {
      if (root.dataset.mapImmediate === "true") {
        const button = root.querySelector<HTMLButtonElement>("[data-map-load]");
        if (button) button.hidden = true;
        void ensureActive(root);
      }
      root
        .querySelectorAll<HTMLElement>("[data-map-focus]")
        .forEach((control) => (control.hidden = false));
    });
    stopObserving = observeAutomaticMaps(roots, ensureActive);
  };
  const disposeAll = () => {
    mapGeneration++;
    stopObserving();
    fullscreen.close(undefined, false);
    for (const record of activeMaps.values()) {
      setMapListLoaded(record.root, false);
      const fullscreenButton = record.root.querySelector<HTMLButtonElement>("[data-map-fullscreen-open]");
      if (fullscreenButton) fullscreenButton.hidden = true;
      record.map.remove();
      const canvas = record.root.querySelector<HTMLElement>("[data-map-canvas]");
      if (canvas) {
        canvas.replaceChildren();
        canvas.hidden = true;
        canvas.setAttribute("aria-hidden", "true");
      }
      const controls = record.root.querySelector<HTMLElement>("[data-map-controls]");
      if (controls) controls.hidden = true;
      const button = record.root.querySelector<HTMLButtonElement>("[data-map-load]");
      if (button) button.hidden = false;
    }
    activeMaps.clear();
  };

  initializeMaps();
  document.addEventListener("astro:page-load", initializeMaps);
  document.addEventListener("astro:before-swap", disposeAll);
  window.addEventListener("pagehide", disposeAll);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) initializeMaps();
  });
</script>

<style>
  .location-map {
    position: relative;
    margin: 2rem 0;
    padding: 1rem;
    border: 1px solid var(--border, #dce4ec);
    border-radius: 0.75rem;
    background: var(--surface, #fff);
  }

  .location-map__title {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

