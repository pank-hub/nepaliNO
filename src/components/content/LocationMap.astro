---
import MapPrivacy from "./MapPrivacy.astro";
import {
  MAP_VECTOR_PROVIDER,
  ROUTING_PROVIDER,
  resolveMapDisplaySettings,
  validateMapLocation,
  type MapEditorialPath,
  type MapLocation,
  type MapPlace,
  type MapRoute,
  type MapStyleMode,
  type PlaceIcon,
} from "../../lib/maps/location";
import { isOpenStreetMapUrl } from "../../lib/maps/publicMapUrl";
import {
  NORWAY_LOCATOR_VIEWBOX,
  NORWAY_MAINLAND_PATH,
  projectNorwayPoint,
} from "../../lib/maps/norwayLocator";
import {
  iconForPlace,
  isLegacyBlock,
  normalizePlaces,
  publicEditorialPath,
  publicRoute,
  validPlaces,
  validatePlaces,
} from "../../lib/maps/places";

interface Props {
  location?: MapLocation;
  locations?: MapPlace[];
  initialZoom?: number;
  route?: MapRoute;
  editorialPath?: MapEditorialPath;
  mapStyle?: MapStyleMode;
  showNorwayLocator?: boolean;
  loadingBehavior?: "automatic" | "click";
  immediate?: boolean;
  contextSidebar?: boolean;
  language?: string;
  markerLabel?: string;
  markerIcon?: PlaceIcon;
  markerShowLabel?: boolean;
  showViewOnMapActions?: boolean;
  showOpenStreetMapLinks?: boolean;
  showLocationList?: boolean;
  showOpenStreetMapControl?: boolean;
  showFullscreenControl?: boolean;
  description: string;
  labels: {
    load: string;
    loading: string;
    failed: string;
    externalNotice: string;
    exact: string;
    approximate: string;
    openInOsm?: string;
    openMapInOsm?: string;
    viewMapFullscreen: string;
    exitMapFullscreen: string;
    fullscreenFailed: string;
    zoomIn: string;
    zoomOut: string;
    approximateRadius: string;
    locationsList: string;
    showOnMap: string;
    defaultPlaceLabel: string;
    routeHeading: string;
    routeSummary: string;
    routeEstimate: string;
    routeCalculated: string;
    routeAttribution: string;
    reportMapError: string;
  };
  title?: string;
  caption?: string;
  sourceLabel?: string;
  sourceUrl?: string;
  class?: string;
}

const {
  location,
  locations,
  initialZoom,
  route: routeInput,
  editorialPath: pathInput,
  mapStyle,
  showNorwayLocator,
  loadingBehavior,
  immediate = false,
  contextSidebar = false,
  language = "en",
  markerLabel,
  markerIcon,
  markerShowLabel,
  showViewOnMapActions,
  showOpenStreetMapLinks,
  showLocationList,
  showOpenStreetMapControl,
  showFullscreenControl,
  description,
  labels,
  title,
  caption,
  sourceLabel,
  sourceUrl,
  class: className = "",
} = Astro.props;

const display = resolveMapDisplaySettings({
  loadingBehavior,
  mapStyle,
  showNorwayLocator,
  showViewOnMapActions,
  showOpenStreetMapLinks,
  showLocationList,
  showOpenStreetMapControl,
  showFullscreenControl,
});

const normalizedPlaces = normalizePlaces(
  { location, locations, title },
  labels.defaultPlaceLabel,
);
const places = validPlaces(
  isLegacyBlock({ location, locations }) && normalizedPlaces.length
    ? [
        {
          ...normalizedPlaces[0],
          label: markerLabel?.trim() || normalizedPlaces[0].label,
          icon: markerIcon ?? normalizedPlaces[0].icon,
          showLabel: markerShowLabel,
        },
      ]
    : normalizedPlaces,
);
const legacy = isLegacyBlock({ location, locations });
const error =
  places.length === 0
    ? ((legacy ? validateMapLocation(location) : validatePlaces(locations)) ??
      labels.failed)
    : undefined;
const route = places.length > 0 ? publicRoute(routeInput, places) : undefined;
const path = places.length > 0 ? publicEditorialPath(pathInput) : undefined;
const single = places.length === 1 ? places[0] : undefined;
const precision = single?.precision === "approximate" ? "approximate" : "exact";
const showList = !legacy || places.length > 1 || showLocationList !== undefined;

// Legacy blocks keep their stored zoom; a lone new exact place may set its own.
const fixedZoom =
  route || path || !single
    ? undefined
    : legacy
      ? location?.initialZoom
      : single.precision === "exact"
        ? (initialZoom ?? 15)
        : undefined;

const safeSourceUrl = (() => {
  if (!sourceUrl || isOpenStreetMapUrl(sourceUrl)) return undefined;
  try {
    const url = new URL(sourceUrl);
    return url.protocol === "http:" || url.protocol === "https:"
      ? url.toString()
      : undefined;
  } catch {
    return undefined;
  }
})();

const radiusText = (place: MapPlace) =>
  labels.approximateRadius.replace(
    "{radius}",
    String(place.radiusMeters ?? ""),
  );

const precisionLabel =
  places.length > 1
    ? ""
    : precision === "approximate"
      ? `${labels.approximate} · ${radiusText(single!)}`
      : contextSidebar
        ? ""
        : labels.exact;

const clientPlaces = places.map((place) => ({
  key: place._key,
  label: place.label,
  description: place.description,
  lat: place.coordinates!.lat,
  lng: place.coordinates!.lng,
  precision: place.precision,
  radius: place.precision === "approximate" ? place.radiusMeters : undefined,
  icon: place.precision === "exact" ? iconForPlace(place) : undefined,
  showLabel: place.showLabel !== false,
}));

const centerLat =
  places.length > 0
    ? places.reduce((sum, p) => sum + p.coordinates!.lat, 0) / places.length
    : 0;
const centerLng =
  places.length > 0
    ? places.reduce((sum, p) => sum + p.coordinates!.lng, 0) / places.length
    : 0;
const initialLocatorPoint =
  display.showNorwayLocator && places.length > 0
    ? projectNorwayPoint(centerLat, centerLng)
    : undefined;

const routeSummary = route
  ? labels.routeSummary
      .replace("{distance}", (route.distanceMeters! / 1000).toFixed(1))
      .replace(
        "{duration}",
        String(Math.max(1, Math.round(route.durationSeconds! / 60))),
      )
  : "";
const routeDate = route?.calculatedAt?.slice(0, 10);
const routeData = route?.geometry;
const mapId = `location-map-${crypto.randomUUID()}`;
const styleUrl = MAP_VECTOR_PROVIDER.styles[display.mapStyle];
const isEditorialFrame = !contextSidebar && display.mapStyle === "editorial";
---

{
  error ? (
    <aside
      class={`location-map location-map--fallback ${className}`}
      role="note"
    >
      {!contextSidebar && title && <h2>{title}</h2>}
      <p>{contextSidebar ? labels.failed : description || error}</p>
      {contextSidebar && title && <p>{title}</p>}
      {caption && <p>{caption}</p>}
      {safeSourceUrl && (
        <p>
          <a href={safeSourceUrl} target="_blank" rel="noopener noreferrer">
            {sourceLabel || safeSourceUrl}
          </a>
        </p>
      )}
    </aside>
  ) : (
    <figure
      class={`location-map ${contextSidebar ? "location-map--context" : ""} ${isEditorialFrame ? "location-map--editorial" : ""} ${className}`}
      data-location-map
      data-map-id={mapId}
      data-map-style={display.mapStyle}
      data-show-locator={String(display.showNorwayLocator)}
      data-style-url={styleUrl}
      data-loading-behavior={display.loadingBehavior}
      data-map-immediate={immediate ? "true" : undefined}
      data-show-location-list={String(display.showLocationList)}
      data-places={JSON.stringify(clientPlaces)}
      data-route={route ? routeData : undefined}
      data-path={path ? JSON.stringify(path) : undefined}
      data-zoom={fixedZoom ?? ""}
      data-description={description}
      data-attribution={MAP_VECTOR_PROVIDER.attribution}
      data-max-zoom={MAP_VECTOR_PROVIDER.maxZoom}
      data-referrer-policy={MAP_VECTOR_PROVIDER.referrerPolicy}
      data-load-label={labels.load}
      data-loading-label={labels.loading}
      data-failed-label={labels.failed}
      data-zoom-in-label={labels.zoomIn}
      data-zoom-out-label={labels.zoomOut}
      data-radius-label={labels.approximateRadius}
      data-fullscreen-failed-label={labels.fullscreenFailed}
    >
      {!contextSidebar && title && <h2 class="location-map__title">{title}</h2>}
      {!contextSidebar && description && (
        <p class="location-map__description">{description}</p>
      )}
      <div class="location-map__stage" data-map-stage>
        <div
          class="location-map__placeholder"
          data-map-placeholder
          hidden={immediate}
        >
          <button
            type="button"
            class="location-map__load"
            data-map-load
            hidden={immediate}
          >
            {labels.load}
          </button>
          {!contextSidebar && (
            <p class="location-map__external-notice">{labels.externalNotice}</p>
          )}
        </div>
        <div
          class="location-map__canvas"
          data-map-canvas
          hidden
          aria-hidden="true"
        />
        <div
          class="location-map__locator"
          data-map-locator
          hidden
          aria-hidden="true"
        >
          <svg
            viewBox={NORWAY_LOCATOR_VIEWBOX}
            width="60"
            height="72"
            aria-hidden="true"
            focusable="false"
          >
            <path class="location-map__locator-land" d={NORWAY_MAINLAND_PATH} />
            <circle
              class="location-map__locator-dot"
              data-map-locator-dot
              cx={initialLocatorPoint?.x ?? 20}
              cy={initialLocatorPoint?.y ?? 76}
              r="3.8"
            />
          </svg>
        </div>
        <div
          class="location-map__brand"
          data-map-brand
          hidden
          aria-hidden="true"
        >
          <span class="location-map__brand-dot" aria-hidden="true"></span>
          <span>nepali.no</span>
        </div>
        <div class="location-map__controls" data-map-controls hidden>
          {display.showFullscreenControl && (
            <button
              type="button"
              class="location-map__control-icon"
              data-map-fullscreen-open
              aria-label={labels.viewMapFullscreen}
              title={labels.viewMapFullscreen}
              aria-haspopup="dialog"
              aria-controls={`${mapId}-fullscreen`}
              hidden
            >
              <svg
                viewBox="0 0 20 20"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M7 3H3v4M13 3h4v4M17 13v4h-4M3 13v4h4" />
              </svg>
            </button>
          )}
          <div class="location-map__zoom-group">
            <button
              type="button"
              data-map-zoom-in
              aria-label={labels.zoomIn}
              title={labels.zoomIn}
            >
              +
            </button>
            <button
              type="button"
              data-map-zoom-out
              aria-label={labels.zoomOut}
              title={labels.zoomOut}
            >
              −
            </button>
          </div>
        </div>
      </div>
      {immediate && (
        <noscript>
          <p class="location-map__status">{labels.failed}</p>
        </noscript>
      )}
      {contextSidebar && <MapPrivacy language={language} />}
      {display.showFullscreenControl && (
        <dialog
          id={`${mapId}-fullscreen`}
          class="location-map__fullscreen"
          data-map-fullscreen-dialog
          aria-label={labels.viewMapFullscreen}
        >
          <button
            type="button"
            class="location-map__fullscreen-exit"
            data-map-fullscreen-exit
            aria-label={labels.exitMapFullscreen}
            title={labels.exitMapFullscreen}
          >
            <svg
              viewBox="0 0 20 20"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M3 7h4V3M17 7h-4V3M13 17v-4h4M7 17v-4H3" />
            </svg>
          </button>
        </dialog>
      )}
      <p
        class="location-map__status"
        data-map-status
        role="status"
        aria-live="polite"
      />
      {showList && (
        <section class="location-map__places">
          <h3 class="location-map__subheading">{labels.locationsList}</h3>
          <ol>
            {places.map((place) => (
              <li data-place-key={place._key}>
                <div class="location-map__place-details">
                  <strong>{place.label}</strong>
                  <span class="location-map__place-kind">
                    {place.precision === "approximate"
                      ? `${labels.approximate} · ${radiusText(place)}`
                      : labels.exact}
                  </span>
                  {place.description && <p>{place.description}</p>}
                </div>
                {display.showViewOnMapActions && (
                  <span class="location-map__place-actions">
                    <button
                      type="button"
                      data-map-focus={place._key}
                      aria-label={`${labels.showOnMap}: ${place.label}`}
                      hidden
                    >
                      {labels.showOnMap}
                    </button>
                  </span>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}
      {path && (path.label || path.description) && (
        <section class="location-map__path">
          {path.label && <h3 class="location-map__subheading">{path.label}</h3>}
          {path.description && <p>{path.description}</p>}
        </section>
      )}
      {route && (
        <section class="location-map__route">
          <h3 class="location-map__subheading">{labels.routeHeading}</h3>
          <p>
            {routeSummary} {labels.routeEstimate}
          </p>
          <p class="location-map__route-meta">
            {labels.routeCalculated
              .replace("{date}", routeDate ?? "")
              .replace(
                "{provider}",
                route.providerName ?? ROUTING_PROVIDER.name,
              )}{" "}
            {labels.routeAttribution}
          </p>
        </section>
      )}
      {(caption ||
        safeSourceUrl ||
        precisionLabel ||
        (contextSidebar && title)) && (
        <figcaption class="location-map__caption">
          {contextSidebar && title && <span>{title}</span>}
          {caption && <span>{caption}</span>}
          {safeSourceUrl && (
            <span>
              {sourceLabel && <span>{sourceLabel}: </span>}
              <a
                href={safeSourceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {sourceLabel || safeSourceUrl}
              </a>
            </span>
          )}
          {precisionLabel && <span>{precisionLabel}</span>}
        </figcaption>
      )}
    </figure>
  )
}

<script>
  import type {
    LngLatBoundsLike,
    MapLibreMap,
    Marker,
    StyleSpecification,
  } from "maplibre-gl";
  import {
    createMapLibreMarkerElement,
    placeContent,
  } from "../../lib/maps/markerIcons";
  import type { PlaceIcon } from "../../lib/maps/location";
  import {
    customizeMapStyle,
    type MapStyleMode,
    type VectorStyleSpec,
  } from "../../lib/maps/mapStyle";
  import { projectNorwayPoint } from "../../lib/maps/norwayLocator";
  import {
    circlePolygonRing,
    decodePolyline6,
    editorialPathMidpoint,
  } from "../../lib/maps/places";
  import {
    createMapActivator,
    observeAutomaticMaps,
    setMapListLoaded,
  } from "../../lib/maps/mapLoading";
  import { createMapFullscreen } from "../../lib/maps/mapFullscreen";

  type ClientPlace = {
    key: string;
    label: string;
    description?: string;
    lat: number;
    lng: number;
    precision: "exact" | "approximate";
    radius?: number;
    icon?: PlaceIcon;
    showLabel?: boolean;
  };

  type LayerTarget =
    | { type: "marker"; lngLat: [number, number]; marker: Marker }
    | { type: "circle"; bounds: [[number, number], [number, number]] };

  type MapRecord = {
    map: MapLibreMap;
    layers: Map<string, LayerTarget>;
    markers: Marker[];
    root: HTMLElement;
  };

  const readPlaces = (raw: string | undefined): ClientPlace[] => {
    try {
      const parsed: unknown = JSON.parse(raw ?? "[]");
      return Array.isArray(parsed)
        ? parsed.filter(
            (place): place is ClientPlace =>
              !!place &&
              Number.isFinite(place.lat) &&
              Number.isFinite(place.lng) &&
              typeof place.label === "string",
          )
        : [];
    } catch {
      return [];
    }
  };

  type ClientPath = {
    points: [number, number][];
    color: string;
    dashArray?: string;
    label?: string;
  };

  const readPath = (raw: string | undefined): ClientPath | undefined => {
    try {
      const parsed = JSON.parse(raw ?? "null");
      return parsed &&
        Array.isArray(parsed.points) &&
        parsed.points.length > 1 &&
        /^#[0-9a-f]{6}$/i.test(parsed.color)
        ? parsed
        : undefined;
    } catch {
      return undefined;
    }
  };

  const activeMaps = new Map<string, MapRecord>();
  const fullscreen = createMapFullscreen(document, window);
  let mapGeneration = 0;
  let mapLibrePromise: Promise<typeof import("maplibre-gl")> | undefined;
  const styleCache = new Map<string, Promise<VectorStyleSpec>>();

  const loadMapLibre = () => {
    mapLibrePromise ??= Promise.all([
      import("maplibre-gl"),
      import("maplibre-gl/dist/maplibre-gl.css"),
    ])
      .then(([mod]) => mod)
      .catch((error: unknown) => {
        mapLibrePromise = undefined;
        throw error;
      });
    return mapLibrePromise;
  };

  const fetchBaseStyle = (
    styleUrl: string,
    referrerPolicy: ReferrerPolicy,
  ): Promise<VectorStyleSpec> => {
    const cached = styleCache.get(styleUrl);
    if (cached) return cached;
    const request = fetch(styleUrl, { referrerPolicy })
      .then((res) => {
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return res.json() as Promise<VectorStyleSpec>;
      })
      .catch((error: unknown) => {
        styleCache.delete(styleUrl);
        throw error;
      });
    styleCache.set(styleUrl, request);
    return request;
  };

  const announce = (root: HTMLElement, message: string) => {
    const status = root.querySelector<HTMLElement>("[data-map-status]");
    if (status) status.textContent = message;
  };

  const updateLocator = (root: HTMLElement, lat: number, lng: number) => {
    const locator = root.querySelector<HTMLElement>("[data-map-locator]");
    const dot = root.querySelector<SVGCircleElement>("[data-map-locator-dot]");
    if (!locator || !dot) return;
    if (root.dataset.showLocator !== "true") {
      locator.hidden = true;
      return;
    }
    const projected = projectNorwayPoint(lat, lng);
    if (!projected) {
      locator.hidden = true;
      return;
    }
    dot.setAttribute("cx", String(projected.x));
    dot.setAttribute("cy", String(projected.y));
    locator.hidden = false;
  };

  const dispose = (root: HTMLElement) => {
    fullscreen.close(root, false);
    setMapListLoaded(root, false);
    const fullscreenButton = root.querySelector<HTMLButtonElement>(
      "[data-map-fullscreen-open]",
    );
    if (fullscreenButton) fullscreenButton.hidden = true;
    const brand = root.querySelector<HTMLElement>("[data-map-brand]");
    if (brand) brand.hidden = true;
    const locator = root.querySelector<HTMLElement>("[data-map-locator]");
    if (locator) locator.hidden = true;
    const placeholder = root.querySelector<HTMLElement>(
      "[data-map-placeholder]",
    );
    if (placeholder) placeholder.hidden = false;
    const id = root.dataset.mapId;
    if (!id) return;
    const record = activeMaps.get(id);
    if (record) {
      for (const marker of record.markers) marker.remove();
      record.map.remove();
      activeMaps.delete(id);
    }
    root.querySelector<HTMLElement>("[data-map-canvas]")?.replaceChildren();
  };

  const activate = async (root: HTMLElement) => {
    const id = root.dataset.mapId;
    if (!id || activeMaps.has(id)) return;
    const generation = mapGeneration;

    const canvas = root.querySelector<HTMLElement>("[data-map-canvas]");
    const button = root.querySelector<HTMLButtonElement>("[data-map-load]");
    const controls = root.querySelector<HTMLElement>("[data-map-controls]");
    const placeholder = root.querySelector<HTMLElement>(
      "[data-map-placeholder]",
    );
    const brand = root.querySelector<HTMLElement>("[data-map-brand]");
    const places = readPlaces(root.dataset.places);
    const zoom = Number(root.dataset.zoom);
    const styleUrl = root.dataset.styleUrl ?? "";
    const styleMode: MapStyleMode =
      root.dataset.mapStyle === "city" ? "city" : "editorial";
    const referrerPolicy = (root.dataset.referrerPolicy ||
      "strict-origin-when-cross-origin") as ReferrerPolicy;

    if (!canvas || !button || !controls || !styleUrl || places.length === 0) {
      announce(root, root.dataset.failedLabel ?? "");
      if (button) button.hidden = false;
      if (placeholder) placeholder.hidden = false;
      return;
    }

    announce(root, root.dataset.loadingLabel ?? "");
    button.disabled = true;

    try {
      const [maplibregl, rawStyle] = await Promise.all([
        loadMapLibre(),
        fetchBaseStyle(styleUrl, referrerPolicy),
      ]);
      if (!root.isConnected || generation !== mapGeneration) {
        button.disabled = false;
        return;
      }

      if (placeholder) placeholder.hidden = true;
      canvas.hidden = false;
      canvas.setAttribute("aria-hidden", "false");
      canvas.setAttribute("role", "region");
      canvas.setAttribute("aria-label", root.dataset.description ?? "");
      controls.hidden = false;
      if (brand) brand.hidden = false;

      const styledSpec = customizeMapStyle(rawStyle, styleMode);
      const map = new maplibregl.Map({
        container: canvas,
        style: styledSpec as unknown as StyleSpecification,
        center: [places[0].lng, places[0].lat],
        zoom: Number.isFinite(zoom) && root.dataset.zoom !== "" ? zoom : 12.5,
        maxZoom: Number(root.dataset.maxZoom) || 19,
        attributionControl: false,
        scrollZoom: false,
        dragRotate: false,
        pitchWithRotate: false,
        transformRequest: (url) => ({ url, referrerPolicy }),
      });
      map.addControl(
        new maplibregl.AttributionControl({
          compact: false,
          customAttribution: "nepali.no",
        }),
        "bottom-right",
      );

      const record: MapRecord = {
        map,
        layers: new Map(),
        markers: [],
        root,
      };
      activeMaps.set(id, record);

      const bounds = new maplibregl.LngLatBounds();
      let hasLoaded = false;

      const failMap = () => {
        if (activeMaps.get(id) !== record) return;
        const wasFullscreen = fullscreen.close(root, false);
        dispose(root);
        canvas.hidden = true;
        canvas.setAttribute("aria-hidden", "true");
        controls.hidden = true;
        if (placeholder) placeholder.hidden = false;
        announce(root, root.dataset.failedLabel ?? "");
        button.hidden = false;
        button.disabled = false;
        button.textContent = root.dataset.loadLabel ?? "";
        if (wasFullscreen) button.focus();
      };

      map.on("error", () => {
        if (!hasLoaded) failMap();
      });

      map.once("load", () => {
        if (activeMaps.get(id) !== record) return;
        hasLoaded = true;

        const routePoints = root.dataset.route
          ? (() => {
              try {
                return decodePolyline6(root.dataset.route);
              } catch {
                return [];
              }
            })()
          : [];
        if (routePoints.length > 1) {
          const coords = routePoints.map(
            ([lat, lng]) => [lng, lat] as [number, number],
          );
          for (const c of coords) bounds.extend(c);
          map.addSource("saved-route", {
            type: "geojson",
            data: {
              type: "Feature",
              properties: {},
              geometry: { type: "LineString", coordinates: coords },
            },
          });
          map.addLayer({
            id: "saved-route-line",
            type: "line",
            source: "saved-route",
            layout: { "line-cap": "round", "line-join": "round" },
            paint: {
              "line-color": "#1d4ed8",
              "line-width": 4.5,
              "line-opacity": 0.85,
            },
          });
        }

        const editorialPath = readPath(root.dataset.path);
        if (editorialPath) {
          const coords = editorialPath.points.map(
            ([lat, lng]) => [lng, lat] as [number, number],
          );
          for (const c of coords) bounds.extend(c);
          map.addSource("editorial-path", {
            type: "geojson",
            data: {
              type: "Feature",
              properties: {},
              geometry: { type: "LineString", coordinates: coords },
            },
          });
          map.addLayer({
            id: "editorial-path-casing",
            type: "line",
            source: "editorial-path",
            layout: { "line-cap": "round", "line-join": "round" },
            paint: {
              "line-color": "#ffffff",
              "line-width": 8,
              "line-opacity": 0.9,
            },
          });
          map.addLayer({
            id: "editorial-path-line",
            type: "line",
            source: "editorial-path",
            layout: { "line-cap": "round", "line-join": "round" },
            paint: {
              "line-color": editorialPath.color,
              "line-width": 4.5,
              "line-opacity": 1,
              ...(editorialPath.dashArray
                ? { "line-dasharray": [2.2, 1.8] }
                : {}),
            },
          });

          if (editorialPath.label) {
            const mid = editorialPathMidpoint(editorialPath.points);
            if (mid) {
              const pathBadge = document.createElement("div");
              pathBadge.className = "nrk-path-label";
              pathBadge.textContent = editorialPath.label;
              const pathMarker = new maplibregl.Marker({
                element: pathBadge,
                anchor: "center",
              })
                .setLngLat([mid[1], mid[0]])
                .addTo(map);
              record.markers.push(pathMarker);
            }
          }
        }

        const approxFeatures: GeoJSON.Feature<GeoJSON.Polygon>[] = [];
        for (const place of places) {
          if (place.precision === "approximate" && place.radius) {
            const ring = circlePolygonRing(place.lat, place.lng, place.radius);
            let west = Infinity;
            let south = Infinity;
            let east = -Infinity;
            let north = -Infinity;
            for (const pt of ring) {
              bounds.extend(pt);
              west = Math.min(west, pt[0]);
              south = Math.min(south, pt[1]);
              east = Math.max(east, pt[0]);
              north = Math.max(north, pt[1]);
            }
            record.layers.set(place.key, {
              type: "circle",
              bounds: [
                [west, south],
                [east, north],
              ],
            });
            approxFeatures.push({
              type: "Feature",
              properties: { key: place.key },
              geometry: { type: "Polygon", coordinates: [ring] },
            });
          } else {
            const lngLat: [number, number] = [place.lng, place.lat];
            const el = createMapLibreMarkerElement(place, document);
            const popup = new maplibregl.Popup({
              offset: 14,
              closeButton: true,
            }).setDOMContent(placeContent(place, document));
            const marker = new maplibregl.Marker({
              element: el,
              anchor: "bottom",
            })
              .setLngLat(lngLat)
              .setPopup(popup)
              .addTo(map);
            el.addEventListener("keydown", (event) => {
              if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                marker.togglePopup();
              }
            });
            record.layers.set(place.key, {
              type: "marker",
              lngLat,
              marker,
            });
            record.markers.push(marker);
            bounds.extend(lngLat);
          }
        }

        if (approxFeatures.length > 0) {
          map.addSource("approximate-areas", {
            type: "geojson",
            data: { type: "FeatureCollection", features: approxFeatures },
          });
          map.addLayer({
            id: "approximate-areas-fill",
            type: "fill",
            source: "approximate-areas",
            paint: { "fill-color": "#f04438", "fill-opacity": 0.18 },
          });
          map.addLayer({
            id: "approximate-areas-line",
            type: "line",
            source: "approximate-areas",
            paint: {
              "line-color": "#b42318",
              "line-width": 2,
              "line-dasharray": [3, 2],
            },
          });
          map.on("click", "approximate-areas-fill", (event) => {
            const key = event.features?.[0]?.properties?.key as
              | string
              | undefined;
            const targetPlace = places.find((p) => p.key === key);
            if (!targetPlace) return;
            new maplibregl.Popup({ closeButton: true })
              .setLngLat(event.lngLat)
              .setDOMContent(placeContent(targetPlace, document))
              .addTo(map);
          });
          map.on("mouseenter", "approximate-areas-fill", () => {
            map.getCanvas().style.cursor = "pointer";
          });
          map.on("mouseleave", "approximate-areas-fill", () => {
            map.getCanvas().style.cursor = "";
          });
        }

        if (root.dataset.zoom === "" && !bounds.isEmpty()) {
          map.fitBounds(bounds as LngLatBoundsLike, {
            padding: 48,
            maxZoom: 15,
            duration: 0,
          });
        }

        const currentCenter = map.getCenter();
        updateLocator(root, currentCenter.lat, currentCenter.lng);
        map.on("moveend", () => {
          const next = map.getCenter();
          updateLocator(root, next.lat, next.lng);
        });

        setMapListLoaded(root, true);
        const fullscreenButton = root.querySelector<HTMLButtonElement>(
          "[data-map-fullscreen-open]",
        );
        if (fullscreenButton) fullscreenButton.hidden = false;
        announce(root, "");
      });

      const only = places.length === 1 ? places[0] : undefined;
      if (only?.precision === "approximate") {
        const radiusLabel = (root.dataset.radiusLabel ?? "").replace(
          "{radius}",
          String(Math.round(only.radius ?? 0)),
        );
        canvas.setAttribute(
          "aria-label",
          `${root.dataset.description ?? ""}. ${radiusLabel}`,
        );
      }

      button.textContent = root.dataset.loadLabel ?? "";
      button.disabled = false;
      button.hidden = true;
      requestAnimationFrame(() => map.resize());
      announce(root, "");
    } catch (error) {
      dispose(root);
      canvas.hidden = true;
      canvas.setAttribute("aria-hidden", "true");
      controls.hidden = true;
      if (placeholder) placeholder.hidden = false;
      button.hidden = false;
      button.disabled = false;
      announce(root, root.dataset.failedLabel ?? "");
      console.error("[location-map] Unable to load map resources.", error);
    }
  };

  const ensureActive = createMapActivator(activate);

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const fullscreenButton = target.closest<HTMLButtonElement>(
      "[data-map-fullscreen-open]",
    );
    const fullscreenRoot =
      fullscreenButton?.closest<HTMLElement>("[data-location-map]");
    const fullscreenMap = fullscreenRoot?.dataset.mapId
      ? activeMaps.get(fullscreenRoot.dataset.mapId)?.map
      : undefined;
    if (fullscreenRoot && fullscreenMap) {
      try {
        fullscreen.open(fullscreenRoot, fullscreenMap);
      } catch (error) {
        announce(
          fullscreenRoot,
          fullscreenRoot.dataset.fullscreenFailedLabel ?? "",
        );
        console.error("[location-map] Unable to open fullscreen map.", error);
      }
      return;
    }
    const zoomControl = target.closest<HTMLButtonElement>(
      "[data-map-zoom-in], [data-map-zoom-out]",
    );
    const zoomRoot = zoomControl?.closest<HTMLElement>("[data-location-map]");
    const zoomMap = zoomRoot?.dataset.mapId
      ? activeMaps.get(zoomRoot.dataset.mapId)?.map
      : undefined;
    if (zoomControl && zoomMap) {
      if (zoomControl.hasAttribute("data-map-zoom-in")) zoomMap.zoomIn();
      else zoomMap.zoomOut();
      return;
    }
    const focusControl = target.closest<HTMLButtonElement>("[data-map-focus]");
    const focusRoot = focusControl?.closest<HTMLElement>("[data-location-map]");
    if (focusControl && focusRoot) {
      void (async () => {
        await ensureActive(focusRoot);
        const focusRecord = focusRoot.dataset.mapId
          ? activeMaps.get(focusRoot.dataset.mapId)
          : undefined;
        if (!focusRecord) return;
        const layer = focusRecord.layers.get(
          focusControl.dataset.mapFocus ?? "",
        );
        if (layer?.type === "circle") {
          focusRecord.map.fitBounds(layer.bounds, { padding: 36 });
        } else if (layer?.type === "marker") {
          focusRecord.map.flyTo({
            center: layer.lngLat,
            zoom: Math.max(focusRecord.map.getZoom(), 15),
          });
          if (!layer.marker.getPopup()?.isOpen()) layer.marker.togglePopup();
        }
        focusRoot
          .querySelector<HTMLElement>("[data-map-canvas]")
          ?.scrollIntoView({ block: "nearest" });
      })();
      return;
    }
    const button = target.closest<HTMLButtonElement>("[data-map-load]");
    const root = button?.closest<HTMLElement>("[data-location-map]");
    if (root) void ensureActive(root);
  });

  let stopObserving = () => {};
  const initializeMaps = () => {
    stopObserving();
    const roots = document.querySelectorAll<HTMLElement>("[data-location-map]");
    roots.forEach((root) => {
      if (root.dataset.mapImmediate === "true") {
        const button = root.querySelector<HTMLButtonElement>("[data-map-load]");
        if (button) button.hidden = true;
        void ensureActive(root);
      }
      root
        .querySelectorAll<HTMLElement>("[data-map-focus]")
        .forEach((control) => (control.hidden = false));
    });
    stopObserving = observeAutomaticMaps(roots, ensureActive);
  };

  const disposeAll = () => {
    mapGeneration++;
    stopObserving();
    fullscreen.close(undefined, false);
    for (const record of activeMaps.values()) {
      setMapListLoaded(record.root, false);
      const fullscreenButton = record.root.querySelector<HTMLButtonElement>(
        "[data-map-fullscreen-open]",
      );
      if (fullscreenButton) fullscreenButton.hidden = true;
      const brand = record.root.querySelector<HTMLElement>("[data-map-brand]");
      if (brand) brand.hidden = true;
      const locator = record.root.querySelector<HTMLElement>(
        "[data-map-locator]",
      );
      if (locator) locator.hidden = true;
      const placeholder = record.root.querySelector<HTMLElement>(
        "[data-map-placeholder]",
      );
      if (placeholder) placeholder.hidden = false;
      for (const marker of record.markers) marker.remove();
      record.map.remove();
      const canvas = record.root.querySelector<HTMLElement>("[data-map-canvas]");
      if (canvas) {
        canvas.replaceChildren();
        canvas.hidden = true;
        canvas.setAttribute("aria-hidden", "true");
      }
      const controls = record.root.querySelector<HTMLElement>(
        "[data-map-controls]",
      );
      if (controls) controls.hidden = true;
      const button = record.root.querySelector<HTMLButtonElement>(
        "[data-map-load]",
      );
      if (button) button.hidden = false;
    }
    activeMaps.clear();
  };

  initializeMaps();
  document.addEventListener("astro:page-load", initializeMaps);
  document.addEventListener("astro:before-swap", disposeAll);
  window.addEventListener("pagehide", disposeAll);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) initializeMaps();
  });
</script>

