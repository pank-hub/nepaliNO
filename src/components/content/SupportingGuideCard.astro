---
import type {SupportedLanguage} from '../../i18n/config'

interface SupportingGuide {
  title: string
  slug: string
  language: SupportedLanguage
  responsibleAgency: string
}

interface Props {
  guide: SupportingGuide
  eyebrow: string
  agencyLabel: string
}

const {guide, eyebrow, agencyLabel} = Astro.props
---

<article class="supporting-guide-card">
  <p class="eyebrow">{eyebrow}</p>
  <h2>
    <a href={`/${guide.language}/info/${guide.slug}/`}>{guide.title}</a>
  </h2>
  <p class="supporting-guide-card__agency">
    <span>{agencyLabel}</span>
    <strong>{guide.responsibleAgency}</strong>
  </p>
</article>

<style>
  .supporting-guide-card {
    padding: 1.2rem;
    border: 1px solid #a5bdd4;
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, #f5f8fb 0%, #ffffff 100%);
    box-shadow: var(--shadow-soft);
  }

  .supporting-guide-card h2 {
    margin-block-start: 0.4rem;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.3;
  }

  .supporting-guide-card h2 a {
    color: var(--civic-deep);
    text-decoration: none;
  }

  .supporting-guide-card h2 a:hover {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .supporting-guide-card__agency {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.45rem;
    margin-block-start: 0.75rem;
    padding-block-start: 0.75rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .supporting-guide-card__agency span {
    color: var(--text-soft);
  }

  .supporting-guide-card__agency strong {
    color: var(--civic-deep);
    font-weight: 700;
  }
</style>
