---
import {getTranslations} from '../../i18n'
import type {SupportedLanguage} from '../../i18n/config'

interface Props {
  language: SupportedLanguage
}

const {language} = Astro.props
const labels = getTranslations(language)
---

<header class="home-introduction">
  <div class="container home-introduction__inner">
    <div class="home-introduction__content reading-width">
      <h1>{labels.home.title}</h1>
      <p>{labels.home.introduction}</p>
    </div>
    {Astro.slots.has('search') && (
      <div class="home-introduction__search">
        <slot name="search" />
      </div>
    )}
  </div>
</header>

<style>
  .home-introduction {
    min-width: 0;
    padding-block: 1.25rem 2rem;
    background: var(--surface-intro);
    border-block-end: 1px solid var(--border);
  }

  .home-introduction__inner {
    width: min(100% - (2 * var(--page-gutter)), 74rem);
  }

  h1 {
    max-width: 22ch;
    font-size: clamp(1.6rem, 5vw, 2.25rem);
    font-weight: 600;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  p {
    max-width: 54ch;
    margin-block-start: 0.65rem;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .home-introduction__search {
    max-width: 58rem;
    margin-block-start: 1.5rem;
  }

  @media (min-width: 40rem) {
    .home-introduction {
      padding-block: 1.75rem 2.25rem;
    }
  }

  @media (min-width: 64rem) {
    .home-introduction {
      padding-block: 2rem 2.5rem;
    }

    .home-introduction h1 {
      max-width: 34ch;
      font-size: clamp(2.25rem, 2.8vw, 2.5rem);
      line-height: 1.18;
    }

    p {
      max-width: 45rem;
      font-size: 1.125rem;
      line-height: 1.6;
    }
  }
</style>
