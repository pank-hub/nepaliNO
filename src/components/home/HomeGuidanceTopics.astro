---
import {getTranslations} from '../../i18n'
import type {SupportedLanguage} from '../../i18n/config'
import HomeSectionHeading from './HomeSectionHeading.astro'
import type {HomeTopic} from './types'

interface Props {
  language: SupportedLanguage
  topics: HomeTopic[]
}

const {language, topics} = Astro.props
const labels = getTranslations(language)
const shortcuts = topics.slice(0, 6)
---

<section aria-labelledby="home-guidance-heading">
  <HomeSectionHeading
    id="home-guidance-heading"
    title={labels.home.informationHeading}
    description={labels.home.informationDescription}
    actionHref={`/${language}/info/`}
    actionLabel={labels.home.viewAllInformation}
  />
  {shortcuts.length > 0 ? (
    <ul class="guidance-topics">
      {shortcuts.map((topic) => (
        <li>
          <a href={`/${language}/info/topic/${topic.slug}/`} data-icon-key={topic.iconKey}>
            {topic.title}
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="muted">{labels.home.emptyTopics}</p>
  )}
</section>

<style>
  .guidance-topics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    height: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    font-weight: 700;
  }
</style>
