---
interface Props {
  id: string
  title: string
  description?: string
  actionHref: string
  actionLabel: string
}

const {id, title, description, actionHref, actionLabel} = Astro.props
---

<div class="home-section">
  <header class="home-section-heading">
    <h2 id={id}>{title}</h2>
    {description && <p>{description}</p>}
  </header>
  <div class="home-section__content"><slot /></div>
  <a class="home-section__action" href={actionHref}>{actionLabel} <span aria-hidden="true">→</span></a>
</div>

<style>
  .home-section {
    display: grid;
    grid-template-areas: "heading" "content" "action";
    gap: 0.65rem;
  }

  .home-section-heading {
    grid-area: heading;
  }

  .home-section__content {
    grid-area: content;
    min-width: 0;
  }

  h2 {
    font-size: clamp(1.3rem, 4vw, 1.6rem);
    font-weight: 600;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  p {
    margin-block-start: 0.25rem;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .home-section__action {
    grid-area: action;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  @media (min-width: 60rem) {
    .home-section {
      grid-template-areas: "heading action" "content content";
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .home-section__action {
      justify-self: end;
    }
  }
</style>
