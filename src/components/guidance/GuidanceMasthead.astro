---
import {getTranslations} from '../../i18n'
import type {SupportedLanguage} from '../../i18n/config'
import {topicHref, type GuidanceTopicItem} from '../../lib/guidanceHub'

interface Props {
  language: SupportedLanguage
  topicCount: number
  guideCount: number
  quickTopics: GuidanceTopicItem[]
  hasRecent: boolean
  activeTopicKey?: string
}

const {language, topicCount, guideCount, quickTopics, hasRecent, activeTopicKey} = Astro.props
const labels = getTranslations(language).information

const topicCountText = (
  topicCount === 1 ? labels.topicsCountLabel.one : labels.topicsCountLabel.other
).replace('{count}', String(topicCount))

const guideCountText = (
  guideCount === 1 ? labels.guidesCountLabel.one : labels.guidesCountLabel.other
).replace('{count}', String(guideCount))
---

<header class="masthead">
  <div class="masthead-heading">
    <div>
      <h1>{labels.pageTitle}</h1>
      <p class="masthead-description">{labels.pageDescription}</p>
    </div>
    {(topicCount > 0 || guideCount > 0) && (
      <p class="masthead-stats">
        {[topicCount > 0 ? topicCountText : '', guideCount > 0 ? guideCountText : '']
          .filter(Boolean)
          .join(' · ')}
      </p>
    )}
  </div>
  {(hasRecent || quickTopics.length > 0) && (
    <nav aria-label={labels.quickJumpLabel} tabindex="0">
      <div class="nav-row">
        {hasRecent && (
          <a class="nav-recent" href="#recent-guidance-heading">
            <span class="nav-recent-pill">
              <svg
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9Z"></path>
              </svg>
              <span>{labels.recentJumpLabel}</span>
            </span>
          </a>
        )}
        {hasRecent && quickTopics.length > 0 && <span class="nav-divider" aria-hidden="true"></span>}
        {quickTopics.map((topic) => (
          <a
            href={topicHref(language, topic.slug)}
            aria-current={activeTopicKey === topic.topicKey ? 'page' : undefined}
          >
            {topic.title}
          </a>
        ))}
      </div>
    </nav>
  )}
</header>

<style>
  .masthead {
    margin-block: 1.25rem 1.25rem;
    border-top: 3px solid var(--civic-deep);
  }

  .masthead-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.45rem 1.5rem;
    padding-block: 0.9rem;
  }

  h1 {
    max-width: none;
    color: var(--civic-deep);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.3;
  }

  .masthead-description {
    max-width: 62ch;
    margin-block-start: 0.35rem;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .masthead-stats {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  nav {
    display: flex;
    overflow-x: auto;
    gap: 0 1.25rem;
    padding-block-end: 0.2rem;
    border-block: 1px solid var(--border-strong);
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }

  .nav-row {
    display: flex;
    align-items: center;
    gap: 0 1.25rem;
  }

  nav a {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    min-height: 48px;
    padding-block: 0.5rem;
    border-bottom: 3px solid transparent;
    color: var(--civic);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-recent {
    padding-block: 0.35rem;
    border-bottom: 0;
  }

  .nav-recent-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--color-brand-200);
    border-radius: 999px;
    background: var(--color-brand-50);
    color: var(--brand);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .nav-recent-pill svg {
    flex: 0 0 auto;
  }

  .nav-divider {
    flex: 0 0 auto;
    align-self: center;
    width: 1px;
    height: 1.25rem;
    background: var(--border-strong);
  }

  nav a[aria-current] {
    border-bottom-color: var(--brand);
    color: var(--civic-deep);
    font-weight: 700;
  }

  nav a:hover {
    text-decoration: underline;
  }

  .nav-recent:hover {
    text-decoration: none;
  }

  .nav-recent:hover .nav-recent-pill {
    border-color: var(--color-brand-300);
    background: var(--color-brand-100);
  }

  nav a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }
</style>
