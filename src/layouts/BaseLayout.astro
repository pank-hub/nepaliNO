---
import "../styles/global.css";

import { getTranslations } from "../i18n";
import type { SupportedLanguage } from "../i18n/config";

interface Props {
  language: SupportedLanguage;
  title: string;
  description: string;
  canonicalUrl?: URL;
  socialImage?: string;
  socialImageAlt?: string;
  contentType?: "website" | "article";
  publishedAt?: string;
  noIndex?: boolean;
  bodyClass?: string;
}

const {
  language,
  title,
  description,
  canonicalUrl,
  socialImage,
  socialImageAlt = "nepali.no",
  contentType = "website",
  publishedAt,
  noIndex = false,
  bodyClass = "",
} = Astro.props;

const labels = getTranslations(language);
const siteOrigin = Astro.site ?? new URL("https://nepali.no");
const resolvedCanonicalUrl = canonicalUrl ?? new URL(Astro.url.pathname, siteOrigin);
const resolvedSocialImage = socialImage
  ? new URL(socialImage, siteOrigin).toString()
  : undefined;
const openGraphLocale = language === "ne" ? "ne_NP" : "nb_NO";
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#172534" />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={resolvedCanonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={contentType} />
    <meta property="og:url" content={resolvedCanonicalUrl} />
    <meta property="og:site_name" content="nepali.no" />
    <meta property="og:locale" content={openGraphLocale} />
    {resolvedSocialImage && <meta property="og:image" content={resolvedSocialImage} />}
    {resolvedSocialImage && <meta property="og:image:width" content="1200" />}
    {resolvedSocialImage && <meta property="og:image:height" content="630" />}
    {resolvedSocialImage && <meta property="og:image:alt" content={socialImageAlt} />}
    {contentType === "article" && publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}

    <meta name="twitter:card" content={resolvedSocialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedSocialImage && <meta name="twitter:image" content={resolvedSocialImage} />}
    {resolvedSocialImage && <meta name="twitter:image:alt" content={socialImageAlt} />}

    <title>{title}</title>

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">
      {labels.common.skipToContent}
    </a>

    <slot name="header" />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
