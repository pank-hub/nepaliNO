---
import TranslationPortalLayout from "../../../layouts/TranslationPortalLayout.astro";
import { readTranslationSession } from "../../../lib/translationAuth/session";
import {
  getTranslationLanguageLabel,
  getTranslationModule,
  isTranslationLanguage,
  isTranslationModuleId,
} from "../../../lib/translationBrowser/registry";

export const prerender = false;

const session = await readTranslationSession(Astro.cookies);

if (!session) {
  return Astro.redirect("/translations/login/", 302);
}

const { language, module: moduleParameter } = Astro.params;

if (
  !isTranslationLanguage(language) ||
  !isTranslationModuleId(moduleParameter)
) {
  return new Response("Translation module not found.", {
    status: 404,
    headers: { "cache-control": "no-store" },
  });
}

const translationModule = getTranslationModule(language, moduleParameter);
const languageLabel = getTranslationLanguageLabel(language);
const pageTitle = `${translationModule.title} · ${languageLabel} | nepali.no`;
---

<TranslationPortalLayout
  title={pageTitle}
  description={`${languageLabel} ${translationModule.title} interface wording editor.`}
>
  <div
    class="module-shell"
    data-translation-editor
    data-language={language}
    data-module={moduleParameter}
  >
    <nav class="module-nav" aria-label="Translation Browser navigation">
      <a href="/translations/">← All translation modules</a>
      <a class="button button-secondary" href="/translations/logout/">Sign out</a>
    </nav>

    <header class="module-header">
      <div>
        <p class="eyebrow">{languageLabel} · Controlled editing</p>
        <h1>{translationModule.title}</h1>
        <p class="lead">{translationModule.description}</p>
      </div>
      <div class="module-total" aria-label={`${translationModule.entries.length} strings`}>
        <strong>{translationModule.entries.length}</strong>
        <span>strings</span>
      </div>
    </header>

    <aside class="scope-note">
      <strong>Validation-only checkpoint</strong>
      <p>
        Proposed wording is validated before a protected translation branch and
        pull request can be created. The Translation Editor never updates main directly.
      </p>
    </aside>

    <div class="editor-actions" data-editor-actions>
      <button class="button button-primary" type="button" data-enable-editing>
        Enable editing
      </button>
      <button class="button button-primary" type="button" data-review-changes hidden>
        Validate and review changes
      </button>
      <button class="button button-secondary" type="button" data-cancel-editing hidden>
        Cancel editing
      </button>
      <span class="change-count" data-change-count aria-live="polite">Read-only</span>
    </div>

    <div class="error-summary" data-error-summary role="alert" tabindex="-1" hidden>
      <strong>Review the proposed changes</strong>
      <ul data-error-list></ul>
    </div>

    <form data-translation-form novalidate>
      <ol class="translation-list">
        {translationModule.entries.map((entry) => (
          <li class="translation-item surface" data-translation-item>
            <div class="translation-item__meta">
              <code>{entry.key}</code>
            </div>
            <div class="translation-item__content">
              <p class="current-value" lang={language} data-current-value>
                {entry.value}
              </p>
              <label class="edit-field" hidden>
                <span>Proposed wording</span>
                <textarea
                  rows="3"
                  maxlength="5000"
                  data-translation-key={entry.key}
                  data-original-value={entry.value}
                  disabled
                >{entry.value}</textarea>
                <small>Current source remains unchanged until a later pull-request milestone.</small>
              </label>
            </div>
          </li>
        ))}
      </ol>
    </form>

    <section class="review-panel surface" data-review-panel tabindex="-1" hidden>
      <p class="eyebrow">Validated proposal</p>
      <h2>Review exact wording changes</h2>
      <p data-review-message>
        The server validated this proposal. No source file or GitHub content was changed.
      </p>
      <ol class="review-list" data-review-list></ol>
      <div class="review-actions">
        <button class="button button-secondary" type="button" data-close-review>
          Return to editing
        </button>
        <button class="button button-primary" type="button" data-create-pull-request disabled>
          Create protected pull request
        </button>
      </div>
    </section>
  </div>
</TranslationPortalLayout>

<script>
  const editor = document.querySelector("[data-translation-editor]");

  if (editor instanceof HTMLElement) {
    const form = editor.querySelector("[data-translation-form]");
    const enableButton = editor.querySelector("[data-enable-editing]");
    const reviewButton = editor.querySelector("[data-review-changes]");
    const cancelButton = editor.querySelector("[data-cancel-editing]");
    const changeCount = editor.querySelector("[data-change-count]");
    const errorSummary = editor.querySelector("[data-error-summary]");
    const errorList = editor.querySelector("[data-error-list]");
    const reviewPanel = editor.querySelector("[data-review-panel]");
    const reviewList = editor.querySelector("[data-review-list]");
    const reviewMessage = editor.querySelector("[data-review-message]");
    const closeReview = editor.querySelector("[data-close-review]");
    const createPullRequestButton = editor.querySelector("[data-create-pull-request]");
    let validatedProposal: {
      language: string;
      module: string;
      changes: Array<{ key: string; originalValue: string; proposedValue: string }>;
    } | null = null;
    const textareas = Array.from(
      editor.querySelectorAll("textarea[data-translation-key]"),
    ).filter((element) => element instanceof HTMLTextAreaElement);

    const changedTextareas = () =>
      textareas.filter(
        (textarea) => textarea.value !== textarea.dataset.originalValue,
      );

    const updateCount = () => {
      if (!(changeCount instanceof HTMLElement)) return;
      const count = changedTextareas().length;
      changeCount.textContent = `${count} changed ${count === 1 ? "string" : "strings"}`;
    };

    const clearErrors = () => {
      if (errorSummary instanceof HTMLElement) errorSummary.hidden = true;
      if (errorList instanceof HTMLElement) errorList.replaceChildren();
      for (const textarea of textareas) textarea.removeAttribute("aria-invalid");
    };

    const showErrors = (
      errors: Array<{ key?: string; message: string }>,
    ) => {
      if (!(errorSummary instanceof HTMLElement) || !(errorList instanceof HTMLElement)) {
        return;
      }

      errorList.replaceChildren();

      for (const error of errors) {
        const item = document.createElement("li");
        item.textContent = error.key
          ? `${error.key}: ${error.message}`
          : error.message;
        errorList.append(item);

        if (error.key) {
          const textarea = textareas.find(
            (candidate) => candidate.dataset.translationKey === error.key,
          );
          textarea?.setAttribute("aria-invalid", "true");
        }
      }

      errorSummary.hidden = false;
      errorSummary.focus();
    };

    const setEditing = (enabled: boolean) => {
      for (const item of editor.querySelectorAll("[data-translation-item]")) {
        const current = item.querySelector("[data-current-value]");
        const field = item.querySelector(".edit-field");
        if (current instanceof HTMLElement) current.hidden = enabled;
        if (field instanceof HTMLElement) field.hidden = !enabled;
      }

      for (const textarea of textareas) textarea.disabled = !enabled;
      if (enableButton instanceof HTMLElement) enableButton.hidden = enabled;
      if (reviewButton instanceof HTMLElement) reviewButton.hidden = !enabled;
      if (cancelButton instanceof HTMLElement) cancelButton.hidden = !enabled;
      if (changeCount instanceof HTMLElement) {
        changeCount.textContent = enabled ? "0 changed strings" : "Read-only";
      }
      clearErrors();
      validatedProposal = null;
      if (createPullRequestButton instanceof HTMLButtonElement) {
        createPullRequestButton.disabled = true;
        createPullRequestButton.textContent = "Create protected pull request";
      }
      if (reviewPanel instanceof HTMLElement) reviewPanel.hidden = true;
    };

    enableButton?.addEventListener("click", () => {
      setEditing(true);
      textareas[0]?.focus();
    });

    cancelButton?.addEventListener("click", () => {
      for (const textarea of textareas) {
        textarea.value = textarea.dataset.originalValue ?? "";
      }
      setEditing(false);
    });

    for (const textarea of textareas) {
      textarea.addEventListener("input", updateCount);
    }

    reviewButton?.addEventListener("click", async () => {
      clearErrors();
      const changes = changedTextareas().map((textarea) => ({
        key: textarea.dataset.translationKey ?? "",
        originalValue: textarea.dataset.originalValue ?? "",
        proposedValue: textarea.value,
      }));

      if (reviewButton instanceof HTMLButtonElement) {
        reviewButton.disabled = true;
        reviewButton.textContent = "Validating…";
      }

      try {
        const response = await fetch("/translations/api/validate", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            language: editor.dataset.language,
            module: editor.dataset.module,
            changes,
          }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showErrors(
            Array.isArray(result.errors)
              ? result.errors
              : [{ message: result.message ?? "The proposal could not be validated." }],
          );
          return;
        }

        if (!(reviewPanel instanceof HTMLElement) || !(reviewList instanceof HTMLElement)) {
          return;
        }

        reviewList.replaceChildren();

        for (const change of result.changes) {
          const item = document.createElement("li");
          const key = document.createElement("code");
          const comparison = document.createElement("div");
          const before = document.createElement("p");
          const after = document.createElement("p");

          key.textContent = change.key;
          before.className = "review-before";
          before.textContent = `Current: ${change.originalValue}`;
          after.className = "review-after";
          after.textContent = `Proposed: ${change.proposedValue}`;
          comparison.append(before, after);
          item.append(key, comparison);
          reviewList.append(item);
        }

        validatedProposal = {
          language: editor.dataset.language ?? "",
          module: editor.dataset.module ?? "",
          changes: result.changes,
        };
        if (createPullRequestButton instanceof HTMLButtonElement) {
          createPullRequestButton.disabled = false;
        }
        if (reviewMessage instanceof HTMLElement) {
          reviewMessage.textContent = result.message;
        }
        reviewPanel.hidden = false;
        reviewPanel.focus();
      } catch {
        showErrors([
          { message: "The validation service is temporarily unavailable." },
        ]);
      } finally {
        if (reviewButton instanceof HTMLButtonElement) {
          reviewButton.disabled = false;
          reviewButton.textContent = "Validate and review changes";
        }
      }
    });

    createPullRequestButton?.addEventListener("click", async () => {
      if (
        !validatedProposal ||
        !(createPullRequestButton instanceof HTMLButtonElement)
      ) {
        return;
      }

      createPullRequestButton.disabled = true;
      createPullRequestButton.textContent = "Creating pull request…";
      clearErrors();

      try {
        const response = await fetch("/translations/api/create-pull-request", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(validatedProposal),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showErrors([
            { message: result.message ?? "The pull request could not be created." },
          ]);
          createPullRequestButton.disabled = false;
          createPullRequestButton.textContent = "Create protected pull request";
          return;
        }

        const link = document.createElement("a");
        link.href = result.result.pullRequest.url;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.className = "button button-primary";
        link.textContent = `Open pull request #${result.result.pullRequest.number}`;
        createPullRequestButton.replaceWith(link);

        if (reviewMessage instanceof HTMLElement) {
          reviewMessage.textContent = result.message;
        }
        validatedProposal = null;
      } catch {
        showErrors([
          { message: "The pull-request service is temporarily unavailable." },
        ]);
        createPullRequestButton.disabled = false;
        createPullRequestButton.textContent = "Create protected pull request";
      }
    });

    closeReview?.addEventListener("click", () => {
      if (reviewPanel instanceof HTMLElement) reviewPanel.hidden = true;
      textareas.find((textarea) =>
        textarea.value !== textarea.dataset.originalValue
      )?.focus();
    });

    if (form instanceof HTMLFormElement) {
      form.addEventListener("submit", (event) => event.preventDefault());
    }
  }
</script>

<style>
  :global(.portal-main) {
    place-items: start center;
  }

  .module-shell {
    width: min(100%, 68rem);
  }

  .module-nav,
  .editor-actions,
  .review-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .module-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  h1 {
    margin-top: 0.65rem;
    font-size: clamp(2.2rem, 6vw, 4rem);
  }

  .lead {
    max-width: 48rem;
    margin-top: 1rem;
  }

  .module-total {
    display: grid;
    min-width: 6rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    text-align: center;
  }

  .module-total strong {
    color: var(--civic-deep);
    font-size: 1.55rem;
    line-height: 1;
  }

  .module-total span {
    margin-top: 0.3rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 680;
  }

  .scope-note,
  .error-summary {
    display: grid;
    gap: 0.35rem;
    margin-top: 2rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
  }

  .editor-actions {
    justify-content: flex-start;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .change-count {
    margin-left: auto;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .error-summary {
    border-color: #efb0aa;
    background: #fff3f1;
  }

  .error-summary ul {
    margin: 0.35rem 0 0;
  }

  .translation-list {
    display: grid;
    gap: 0.85rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .translation-item {
    display: grid;
    grid-template-columns: minmax(13rem, 0.8fr) minmax(0, 1.7fr);
    gap: 1rem 1.5rem;
    align-items: start;
    padding: 1rem 1.1rem;
  }

  .translation-item__meta,
  .translation-item__content {
    min-width: 0;
  }

  code {
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
    color: var(--civic);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .current-value,
  textarea {
    color: var(--text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .current-value[lang="ne"],
  :global(html[lang="en"]) textarea {
    font-family: "Noto Sans Devanagari Variable", "Inter Variable", sans-serif;
  }

  .edit-field {
    display: grid;
    gap: 0.45rem;
  }

  .edit-field > span {
    color: var(--civic-deep);
    font-size: 0.82rem;
    font-weight: 720;
  }

  textarea {
    width: 100%;
    min-height: 7rem;
    resize: vertical;
    padding: 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: #fff;
    line-height: 1.65;
  }

  textarea[aria-invalid="true"] {
    border-color: var(--brand);
    box-shadow: 0 0 0 0.12rem rgb(198 42 31 / 0.12);
  }

  .edit-field small {
    color: var(--text-muted);
  }

  .review-panel {
    margin-top: 2rem;
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .review-panel h2 {
    margin-top: 0.5rem;
  }

  .review-panel > p {
    margin-top: 0.75rem;
    color: var(--text-muted);
  }

  .review-list {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .review-list li {
    display: grid;
    gap: 0.65rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
  }

  .review-list li div {
    display: grid;
    gap: 0.35rem;
  }

  :global(.review-before),
  :global(.review-after) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  :global(.review-before) {
    color: var(--text-muted);
  }

  :global(.review-after) {
    color: var(--success);
    font-weight: 700;
  }

  .review-actions {
    justify-content: flex-end;
    margin-top: 1.5rem;
  }

  @media (max-width: 44rem) {
    .module-header {
      display: grid;
    }

    .module-total {
      justify-self: start;
    }

    .translation-item {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .module-nav,
    .review-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .change-count {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
