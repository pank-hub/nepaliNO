---
import {sanityClient} from 'sanity:client'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import {getTranslations} from '../../i18n'
import {
  supportedLanguages,
  type SupportedLanguage,
} from '../../i18n/config'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {urlFor} from '../../lib/sanity/image'
import {
  FEATURED_PUBLIC_INFORMATION_GUIDES_QUERY,
  HOMEPAGE_DIRECTORY_LISTINGS_BY_LANGUAGE_QUERY,
  HOMEPAGE_FEATURED_NEWS_BY_LANGUAGE_QUERY,
  HOMEPAGE_EVENTS_BY_LANGUAGE_QUERY,
  HOMEPAGE_LATEST_NEWS_BY_LANGUAGE_QUERY,
  IMPORTANT_NOW_NEWS_BY_LANGUAGE_QUERY,
} from '../../lib/sanity/queries'

export function getStaticPaths() {
  return supportedLanguages.map((language) => ({
    params: {lang: language},
    props: {language},
  }))
}

interface HomeGuide {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  summary: string
  topic: string
  responsibleAgency: string
  lastReviewedAt: string
  isUrgent?: boolean
}

interface HomeArticleImage {
  asset?: unknown
  alt?: string
  caption?: string
  credit?: string
  hotspot?: unknown
  crop?: unknown
}

interface HomeArticle {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  summary: string
  newsRegion: string
  category: string
  publishedAt: string
  importantUntil?: string
  featuredImage?: HomeArticleImage
}

interface HomeEvent {
  _id: string
  title: string
  slug: string
  summary: string
  eventType: string
  eventFormat: string
  eventStatus: string
  isAllDay?: boolean
  startDateTime: string
  endDateTime?: string
  venueName?: string
  city?: string
  onlinePlatform?: string
  organizerName: string
  featuredImage?: HomeArticleImage
  isFeatured?: boolean
}

interface HomeDirectoryListing {
  _id: string
  name: string
  slug: string
  language: SupportedLanguage
  listingType: string
  otherListingType?: string
  primaryCategory: string
  otherCategory?: string
  summary: string
  presenceType: string
  county?: string
  municipality?: string
  city?: string
  logo?: HomeArticleImage
  isVerified?: boolean
  isFeatured?: boolean
}

const {language} = Astro.props
const labels = getTranslations(language)
const alternateLanguage: SupportedLanguage = language === 'ne' ? 'nb' : 'ne'

const [
  featuredGuides,
  importantNow,
  featuredStory,
  homepageEvents,
  homepageDirectoryListings,
] = await Promise.all([
  sanityClient.fetch<HomeGuide[]>(FEATURED_PUBLIC_INFORMATION_GUIDES_QUERY, {
    language,
  }),
  sanityClient.fetch<HomeArticle | null>(IMPORTANT_NOW_NEWS_BY_LANGUAGE_QUERY, {
    language,
  }),
  sanityClient.fetch<HomeArticle | null>(HOMEPAGE_FEATURED_NEWS_BY_LANGUAGE_QUERY, {
    language,
  }),
  sanityClient.fetch<HomeEvent[]>(HOMEPAGE_EVENTS_BY_LANGUAGE_QUERY, {language}),
  sanityClient.fetch<HomeDirectoryListing[]>(
    HOMEPAGE_DIRECTORY_LISTINGS_BY_LANGUAGE_QUERY,
    {language},
  ),
])

const latestStories = await sanityClient.fetch<HomeArticle[]>(
  HOMEPAGE_LATEST_NEWS_BY_LANGUAGE_QUERY,
  {language, excludeId: featuredStory?._id ?? null},
)

const imageUrl = (image?: HomeArticleImage, width = 1200) =>
  image?.asset ? urlFor(image as any).width(width).fit('crop').auto('format').url() : null
const homepageRegionLabels = labels.news.regions as Record<string, string>
const homepageCategoryLabels = labels.news.categories as Record<string, string>
const getRegionLabel = (value: string) => homepageRegionLabels[value] ?? value
const getCategoryLabel = (value: string) => homepageCategoryLabels[value] ?? value

const dateLocale = language === 'ne' ? 'ne-NP' : 'nb-NO'
const formatDate = (date: string) =>
  new Date(date).toLocaleDateString(dateLocale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })

const eventTimeZone = 'Europe/Oslo'
const now = Date.now()
const eventCategories = labels.events.categories as Record<string, string>
const eventStatuses = labels.events.statuses as Record<string, string>
const eventFormats: Record<string, string> = {
  'in-person': labels.events.inPerson,
  online: labels.events.online,
  hybrid: labels.events.hybrid,
}
const currentEventYear = Number(
  new Intl.DateTimeFormat('en', {timeZone: eventTimeZone, year: 'numeric'}).format(new Date()),
)
const eventYear = (value: string) =>
  Number(
    new Intl.DateTimeFormat('en', {timeZone: eventTimeZone, year: 'numeric'}).format(
      new Date(value),
    ),
  )
const formatEventDateRange = (startValue: string, endValue?: string) => {
  const end = endValue || startValue
  const includeYear =
    eventYear(startValue) !== currentEventYear || eventYear(end) !== currentEventYear
  const options: Intl.DateTimeFormatOptions = {
    timeZone: eventTimeZone,
    month: 'long',
    day: 'numeric',
  }
  if (includeYear) options.year = 'numeric'
  return new Intl.DateTimeFormat(dateLocale, options).formatRange(
    new Date(startValue),
    new Date(end),
  )
}
const formatEventTime = (value: string) =>
  new Date(value).toLocaleTimeString(dateLocale, {
    timeZone: eventTimeZone,
    hour: '2-digit',
    minute: '2-digit',
  })
const isEventOngoing = (event: HomeEvent) =>
  new Date(event.startDateTime).getTime() <= now &&
  new Date(event.endDateTime || event.startDateTime).getTime() >= now
const eventLocation = (event: HomeEvent) =>
  event.eventFormat === 'online'
    ? event.onlinePlatform || labels.events.online
    : event.city || event.venueName || eventFormats[event.eventFormat] || event.eventFormat

const directoryTypes = labels.directory.listingTypes as Record<string, string>
const directoryCategories = labels.directory.categories as Record<string, string>
const directoryCounties = labels.directory.counties as Record<string, string>
const directoryPresenceTypes = labels.directory.presenceTypes as Record<string, string>
const directoryTypeLabel = (listing: HomeDirectoryListing) =>
  listing.listingType === 'other'
    ? listing.otherListingType || directoryTypes.other
    : directoryTypes[listing.listingType] || listing.listingType
const directoryCategoryLabel = (listing: HomeDirectoryListing) =>
  listing.primaryCategory === 'other'
    ? listing.otherCategory || directoryCategories.other
    : directoryCategories[listing.primaryCategory] || listing.primaryCategory
const directoryLocationLabel = (listing: HomeDirectoryListing) => {
  if (listing.presenceType === 'online-only') {
    return directoryPresenceTypes['online-only']
  }
  if (listing.presenceType === 'no-public-location') {
    return directoryPresenceTypes['no-public-location']
  }

  return (
    [
      listing.city || listing.municipality,
      listing.county ? directoryCounties[listing.county] || listing.county : null,
    ]
      .filter(Boolean)
      .join(' · ') || directoryPresenceTypes[listing.presenceType] || listing.presenceType
  )
}
const directoryLogoUrl = (logo?: HomeArticleImage) =>
  logo?.asset
    ? urlFor(logo as any).width(160).height(160).fit('max').auto('format').url()
    : null

---

<BaseLayout
  language={language}
  title={labels.home.metaTitle}
  description={labels.home.metaDescription}
>
  <SiteHeader
    slot="header"
    language={language}
    alternatePath={`/${alternateLanguage}/`}
  />

  <section class="home-hero">
    <div class="container home-hero__grid">
      <div class="home-hero__content">
        <p class="eyebrow">{labels.home.eyebrow}</p>
        <h1>{labels.home.title}</h1>
        <p class="lead">{labels.home.introduction}</p>
        <div class="home-hero__actions">
          <a class="button button-primary" href={`/${language}/info/`}>
            {labels.home.primaryAction}
          </a>
          <a class="button button-secondary" href={`/${language}/news/`}>
            {labels.home.secondaryAction}
          </a>
        </div>
      </div>

      <div class="home-hero__pathways" aria-label={labels.home.title}>
        <article class="pathway pathway--understand">
          <span aria-hidden="true">01</span>
          <h2>{labels.home.informationHeading}</h2>
          <p>{labels.home.informationDescription}</p>
        </article>
        <article class="pathway pathway--informed">
          <span aria-hidden="true">02</span>
          <h2>{labels.home.newsHeading}</h2>
          <p>{labels.home.newsDescription}</p>
        </article>
        <article class="pathway pathway--participate">
          <span aria-hidden="true">03</span>
          <h2>{labels.home.discussionsHeading}</h2>
          <p>{labels.home.discussionsDescription}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section home-news" aria-labelledby="home-news-heading">
    <div class="container">
      {
        importantNow && (
          <aside class="important-now" aria-labelledby="important-now-heading">
            <div class="important-now__label">
              <span aria-hidden="true"></span>
              <strong id="important-now-heading">{labels.home.importantNow}</strong>
            </div>
            <a href={`/${language}/news/${importantNow.slug}/`}>
              {importantNow.title}
            </a>
            {importantNow.importantUntil && (
              <p>
                {labels.home.importantUntil}: {' '}
                <time datetime={importantNow.importantUntil}>
                  {formatDate(importantNow.importantUntil)}
                </time>
              </p>
            )}
          </aside>
        )
      }

      <div class="section-heading news-heading">
        <div>
          <p class="eyebrow">{labels.home.newsEyebrow}</p>
          <h2 id="home-news-heading">{labels.home.newsHeading}</h2>
          <p>{labels.home.newsDescription}</p>
        </div>
        <a class="section-link" href={`/${language}/news/`}>
          {labels.home.viewAllNews} <span aria-hidden="true">→</span>
        </a>
      </div>

      {
        featuredStory || latestStories.length > 0 ? (
          <div class="news-layout">
            {featuredStory && (
              <article class="lead-story">
                {imageUrl(featuredStory.featuredImage) ? (
                  <a
                    class="lead-story__image"
                    href={`/${language}/news/${featuredStory.slug}/`}
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <img
                      src={imageUrl(featuredStory.featuredImage) ?? ''}
                      alt={featuredStory.featuredImage?.alt ?? ''}
                      width="1200"
                      height="720"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ) : (
                  <div class="lead-story__placeholder" aria-hidden="true"></div>
                )}
                <div class="lead-story__content">
                  <p class="story-kicker">
                    {labels.home.featuredStory} · {getRegionLabel(featuredStory.newsRegion)}
                  </p>
                  <h3>
                    <a href={`/${language}/news/${featuredStory.slug}/`}>
                      {featuredStory.title}
                    </a>
                  </h3>
                  <p>{featuredStory.summary}</p>
                  <div class="story-footer">
                    <time datetime={featuredStory.publishedAt}>
                      {formatDate(featuredStory.publishedAt)}
                    </time>
                    <a href={`/${language}/news/${featuredStory.slug}/`}>
                      {labels.home.readFullStory} <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </article>
            )}

            {latestStories.length > 0 && (
              <section
                class:list={['latest-stories', !featuredStory && 'latest-stories--full']}
                aria-labelledby="latest-news-heading"
              >
                <h3 id="latest-news-heading">{labels.home.latestNews}</h3>
                <ol>
                  {latestStories.map((article) => (
                    <li>
                      <article class="latest-story">
                        <div class="latest-story__text">
                          <p class="story-kicker">
                            {getRegionLabel(article.newsRegion)} · {getCategoryLabel(article.category)}
                          </p>
                          <h4>
                            <a href={`/${language}/news/${article.slug}/`}>
                              {article.title}
                            </a>
                          </h4>
                          <time datetime={article.publishedAt}>
                            {formatDate(article.publishedAt)}
                          </time>
                        </div>
                        {imageUrl(article.featuredImage, 360) && (
                          <a
                            class="latest-story__image"
                            href={`/${language}/news/${article.slug}/`}
                            tabindex="-1"
                            aria-hidden="true"
                          >
                            <img
                              src={imageUrl(article.featuredImage, 360) ?? ''}
                              alt=""
                              width="360"
                              height="240"
                              loading="lazy"
                              decoding="async"
                            />
                          </a>
                        )}
                      </article>
                    </li>
                  ))}
                </ol>
              </section>
            )}
          </div>
        ) : (
          <div class="empty-state editorial-empty">
            <span class="editorial-empty__rule" aria-hidden="true"></span>
            <p>{labels.home.emptyNews}</p>
          </div>
        )
      }
    </div>
  </section>


  <section class="section home-section" aria-labelledby="home-information-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{labels.home.informationEyebrow}</p>
          <h2 id="home-information-heading">{labels.home.informationHeading}</h2>
          <p>{labels.home.informationDescription}</p>
        </div>
        <a class="section-link" href={`/${language}/info/`}>
          {labels.home.viewAllInformation} <span aria-hidden="true">→</span>
        </a>
      </div>

      {
        featuredGuides.length > 0 ? (
          <ul class="content-grid">
            {featuredGuides.map((guide) => (
              <li>
                <article class="content-card card">
                  <div class="content-card__badges">
                    <span class="badge badge-success">{guide.responsibleAgency}</span>
                    {guide.isUrgent && (
                      <span class="badge badge-brand">{labels.information.urgentLabel}</span>
                    )}
                  </div>
                  <h3>
                    <a href={`/${language}/info/${guide.slug}/`}>{guide.title}</a>
                  </h3>
                  <p>{guide.summary}</p>
                  <a class="content-card__link" href={`/${language}/info/${guide.slug}/`}>
                    {labels.information.readGuide} <span aria-hidden="true">→</span>
                  </a>
                </article>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty-state surface"><p>{labels.home.emptyInformation}</p></div>
        )
      }
    </div>
  </section>

  {
    homepageEvents.length > 0 && (
      <section class="section home-events" aria-labelledby="home-events-heading">
        <div class="container">
          <div class="section-heading home-events__heading">
            <div>
              <p class="eyebrow">{labels.events.pageTitle}</p>
              <h2 id="home-events-heading">{labels.home.eventsHeading}</h2>
              <p>{labels.home.eventsDescription}</p>
            </div>
            <a class="section-link" href={`/${language}/events/`}>
              {labels.events.viewAllEvents} <span aria-hidden="true">→</span>
            </a>
          </div>

          <ol class="home-event-grid">
            {homepageEvents.map((event) => (
              <li>
                <article class="home-event-card">
                  {imageUrl(event.featuredImage, 720) && (
                    <a
                      class="home-event-card__image"
                      href={`/${language}/events/${event.slug}/`}
                      tabindex="-1"
                      aria-hidden="true"
                    >
                      <img
                        src={imageUrl(event.featuredImage, 720) ?? ''}
                        alt=""
                        width="720"
                        height="480"
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  )}
                  <div class="home-event-card__content">
                    <div class="home-event-card__badges">
                      {event.isFeatured && (
                        <strong class="badge badge-brand">{labels.events.featuredEvent}</strong>
                      )}
                      {isEventOngoing(event) && (
                        <strong class="badge badge-success">{labels.events.ongoing}</strong>
                      )}
                      {event.eventStatus !== 'scheduled' && (
                        <strong class="badge">
                          {eventStatuses[event.eventStatus] ?? event.eventStatus}
                        </strong>
                      )}
                      <span class="badge">
                        {eventCategories[event.eventType] ?? event.eventType}
                      </span>
                      <span class="badge">
                        {eventFormats[event.eventFormat] ?? event.eventFormat}
                      </span>
                    </div>
                    <p class="home-event-card__date">
                      {formatEventDateRange(event.startDateTime, event.endDateTime)}
                      {event.isAllDay
                        ? ` • ${labels.events.allDay}`
                        : ` • ${formatEventTime(event.startDateTime)}`}
                    </p>
                    <h3>
                      <a href={`/${language}/events/${event.slug}/`}>{event.title}</a>
                    </h3>
                    <p class="home-event-card__summary">{event.summary}</p>
                    <dl class="home-event-card__meta">
                      <div>
                        <dt>{labels.events.venue}</dt>
                        <dd>{eventLocation(event)}</dd>
                      </div>
                      <div>
                        <dt>{labels.events.organizer}</dt>
                        <dd>{event.organizerName}</dd>
                      </div>
                    </dl>
                    <a class="home-event-card__link" href={`/${language}/events/${event.slug}/`}>
                      {labels.events.readMore} <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </article>
              </li>
            ))}
          </ol>

          <aside class="home-events__submit">
            <div>
              <h3>{labels.events.submitEvent}</h3>
              <p>{labels.home.eventsDescription}</p>
            </div>
            <a class="button button-secondary" href={`/${language}/events/submit/`}>
              {labels.events.submitEvent} <span aria-hidden="true">→</span>
            </a>
          </aside>
        </div>
      </section>
    )
  }

  <section class="section discussions" aria-labelledby="home-discussions-heading">
    <div class="container discussions__grid">
      <div>
        <p class="eyebrow">{labels.home.discussionsEyebrow}</p>
        <h2 id="home-discussions-heading">{labels.home.discussionsHeading}</h2>
        <p class="lead">{labels.home.discussionsDescription}</p>
        <span class="badge badge-brand">{labels.home.forumComingSoon}</span>
      </div>

      <div class="discussions__preview" aria-hidden="true">
        <div class="discussion-line discussion-line--wide"></div>
        <div class="discussion-line"></div>
        <div class="discussion-line discussion-line--short"></div>
        <div class="discussion-line discussion-line--wide"></div>
      </div>
    </div>
    <div class="container discussions__notice">
      <p>{labels.home.forumNotice}</p>
    </div>
  </section>

  {
    homepageDirectoryListings.length > 0 && (
      <section class="section home-directory" aria-labelledby="home-directory-heading">
        <div class="container">
          <div class="section-heading home-directory__heading">
            <div>
              <p class="eyebrow">{labels.directory.pageTitle}</p>
              <h2 id="home-directory-heading">{labels.home.businessesHeading}</h2>
              <p>{labels.home.businessesDescription}</p>
            </div>
            <a class="section-link" href={`/${language}/directory/`}>
              {labels.directory.exploreListings} <span aria-hidden="true">→</span>
            </a>
          </div>

          <ol class="directory-rail">
            {homepageDirectoryListings.map((listing) => (
              <li>
                <article class="directory-rail__item">
                  <div class="directory-rail__topline">
                    {directoryLogoUrl(listing.logo) && (
                      <div class="directory-rail__logo">
                        <img
                          src={directoryLogoUrl(listing.logo) ?? ''}
                          alt=""
                          width="160"
                          height="160"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    )}
                    <div class="directory-rail__badges">
                      {listing.isFeatured && (
                        <strong class="badge badge-brand">
                          {labels.directory.featuredListing}
                        </strong>
                      )}
                      {listing.isVerified && (
                        <strong class="badge badge-success">{labels.directory.verified}</strong>
                      )}
                    </div>
                  </div>

                  <p class="directory-rail__category">
                    {directoryCategoryLabel(listing)}
                  </p>
                  <h3>
                    <a href={`/${language}/directory/${listing.slug}/`}>{listing.name}</a>
                  </h3>
                  <p class="directory-rail__type">
                    {directoryTypeLabel(listing)} · {directoryLocationLabel(listing)}
                  </p>
                  <p class="directory-rail__summary">{listing.summary}</p>
                  <a
                    class="directory-rail__link"
                    href={`/${language}/directory/${listing.slug}/`}
                  >
                    {labels.directory.viewDetails} <span aria-hidden="true">→</span>
                  </a>
                </article>
              </li>
            ))}
          </ol>

          <aside class="directory-submit-cta home-directory__submit" aria-label={labels.directory.submitListing}>
            <div>
              <strong>{labels.directory.submitListing}</strong>
              <p>{labels.directory.submitListingDescription}</p>
            </div>
            <a class="directory-submit-cta__link" href={`/${language}/directory/submit/`}>
              {labels.directory.submitListing} <span aria-hidden="true">→</span>
            </a>
          </aside>
        </div>
      </section>
    )
  }

  <SiteFooter slot="footer" language={language} />
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 85% 15%, rgb(198 42 31 / 0.12), transparent 20rem),
      linear-gradient(135deg, #f5f8fb 0%, #fdfcf9 60%, #fff5f4 100%);
  }

  .home-hero::after {
    content: '';
    position: absolute;
    width: 22rem;
    height: 22rem;
    inset-block-end: -14rem;
    inset-inline-end: 5%;
    border: 1px solid rgb(198 42 31 / 0.13);
    border-radius: 50%;
  }

  .home-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.75fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .home-hero__content h1 {
    max-width: 14ch;
    margin-block-start: 0.75rem;
  }

  .home-hero__content .lead {
    max-width: 43rem;
    margin-block-start: 1.4rem;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-block-start: 2rem;
  }

  .home-hero__pathways {
    display: grid;
    gap: 0.75rem;
  }

  .pathway {
    position: relative;
    padding: 1.1rem 1.2rem 1.2rem 4rem;
    border: 1px solid rgb(48 70 92 / 0.14);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.72);
    backdrop-filter: blur(0.5rem);
  }

  .pathway > span {
    position: absolute;
    inset-block-start: 1.2rem;
    inset-inline-start: 1.15rem;
    color: var(--brand);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .pathway h2 {
    font-size: 1.15rem;
  }

  .pathway p {
    margin-block-start: 0.35rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .home-section--muted {
    background: var(--surface-muted);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-block-end: 2rem;
  }

  .section-heading h2 {
    margin-block-start: 0.55rem;
  }

  .section-heading p:not(.eyebrow) {
    max-width: 45rem;
    margin-block-start: 0.65rem;
    color: var(--text-muted);
  }

  .section-link {
    flex: 0 0 auto;
    color: var(--civic-deep);
    font-weight: 750;
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .content-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: 1.5rem;
  }

  .content-card__badges {
    display: flex;
