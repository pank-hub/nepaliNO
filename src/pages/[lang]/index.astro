---
import {sanityClient} from 'sanity:client'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import HomeDirectoryHighlights from '../../components/home/HomeDirectoryHighlights.astro'
import HomeForumActivity from '../../components/home/HomeForumActivity.astro'
import HomeGuidanceTopics from '../../components/home/HomeGuidanceTopics.astro'
import HomeIntroduction from '../../components/home/HomeIntroduction.astro'
import HomeLatestUpdates from '../../components/home/HomeLatestUpdates.astro'
import HomeUpcomingEvents from '../../components/home/HomeUpcomingEvents.astro'
import ContentSearch from '../../components/search/ContentSearch.astro'
import type {
  HomeArticle,
  HomeDirectoryListing,
  HomeEvent,
  HomeTopic,
} from '../../components/home/types'
import {forumPilot} from '../../config/forum'
import {isSectionEnabled} from '../../config/languageSections'
import {getTranslations} from '../../i18n'
import {supportedLanguages, type SupportedLanguage} from '../../i18n/config'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {expandUpcomingOccurrences} from '../../lib/eventOccurrences'
import {
  HOMEPAGE_DIRECTORY_LISTINGS_BY_LANGUAGE_QUERY,
  HOMEPAGE_FEATURED_NEWS_BY_LANGUAGE_QUERY,
  HOMEPAGE_EVENTS_BY_LANGUAGE_QUERY,
  HOMEPAGE_LATEST_NEWS_BY_LANGUAGE_QUERY,
  IMPORTANT_NOW_NEWS_BY_LANGUAGE_QUERY,
  PUBLIC_INFORMATION_TOPICS_BY_LANGUAGE_QUERY,
} from '../../lib/sanity/queries'

interface Props {
  language: SupportedLanguage
}

export function getStaticPaths() {
  return supportedLanguages.map((language) => ({
    params: {lang: language},
    props: {language},
  }))
}

const homepageStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://nepali.no/#website',
      url: 'https://nepali.no/',
      name: 'nepali.no',
      alternateName: ['Nepali.no', 'Nepali No', 'NepaliNO'],
      publisher: {'@id': 'https://nepali.no/#organization'},
    },
    {
      '@type': 'Organization',
      '@id': 'https://nepali.no/#organization',
      name: 'NEPALI.NO',
      alternateName: 'nepali.no',
      url: 'https://nepali.no/',
      logo: {
        '@type': 'ImageObject',
        '@id': 'https://nepali.no/#logo',
        url: 'https://nepali.no/icon-512.png',
        contentUrl: 'https://nepali.no/icon-512.png',
        width: 512,
        height: 512,
      },
    },
  ],
}

const {language} = Astro.props
const labels = getTranslations(language)
const alternateLanguage: SupportedLanguage = language === 'ne' ? 'nb' : 'ne'
const showInformation = isSectionEnabled(language, 'information')
const showEvents = isSectionEnabled(language, 'events')
const showDirectory = isSectionEnabled(language, 'directory')
const showForum = forumPilot.enabled && isSectionEnabled(language, 'forum')

const [topics, importantNow, featuredStory, fetchedHomepageEvents, homepageDirectoryListings] =
  await Promise.all([
    showInformation
      ? sanityClient.fetch<HomeTopic[]>(PUBLIC_INFORMATION_TOPICS_BY_LANGUAGE_QUERY, {language})
      : Promise.resolve([]),
    sanityClient.fetch<HomeArticle | null>(IMPORTANT_NOW_NEWS_BY_LANGUAGE_QUERY, {language}),
    sanityClient.fetch<HomeArticle | null>(HOMEPAGE_FEATURED_NEWS_BY_LANGUAGE_QUERY, {language}),
    showEvents
      ? sanityClient.fetch<HomeEvent[]>(HOMEPAGE_EVENTS_BY_LANGUAGE_QUERY, {language})
      : Promise.resolve([]),
    showDirectory
      ? sanityClient.fetch<HomeDirectoryListing[]>(HOMEPAGE_DIRECTORY_LISTINGS_BY_LANGUAGE_QUERY, {language})
      : Promise.resolve([]),
  ])

const latestStories = await sanityClient.fetch<HomeArticle[]>(
  HOMEPAGE_LATEST_NEWS_BY_LANGUAGE_QUERY,
  {language, excludeId: featuredStory?._id ?? null},
)
const now = Date.now()
const homepageEvents = expandUpcomingOccurrences(fetchedHomepageEvents, now)
  .sort((a, b) => Number(!!b.isFeatured) - Number(!!a.isFeatured))
  .slice(0, 3)
---

<BaseLayout
  language={language}
  title={labels.home.metaTitle}
  description={labels.home.metaDescription}
  structuredData={homepageStructuredData}
  bodyClass="homepage-body"
>
  <SiteHeader slot="header" language={language} alternatePath={`/${alternateLanguage}/`} />

  <div class="container homepage">
    <HomeIntroduction language={language}>
      <ContentSearch slot="search" language={language} />
    </HomeIntroduction>
    {showInformation && <HomeGuidanceTopics language={language} topics={topics} />}
    <HomeLatestUpdates
      language={language}
      importantNow={importantNow}
      featuredStory={featuredStory}
      latestStories={latestStories}
    />
    {((showEvents && homepageEvents.length > 0) ||
      (showDirectory && homepageDirectoryListings.length > 0)) && (
      <div class="homepage__community">
        {showEvents && homepageEvents.length > 0 && (
          <HomeUpcomingEvents language={language} events={homepageEvents} now={now} />
        )}
        {showDirectory && homepageDirectoryListings.length > 0 && (
          <HomeDirectoryHighlights language={language} listings={homepageDirectoryListings} />
        )}
      </div>
    )}
    {showForum && forumPilot.homepageDiscussionFeedEnabled && <HomeForumActivity language={language} />}
  </div>

  <SiteFooter slot="footer" language={language} flush />
</BaseLayout>

<style>
  :global(body.homepage-body) {
    background: var(--surface);
  }

  .homepage {
    --home-title-size: 1.0625rem;
    --home-title-weight: 600;
    display: grid;
    width: min(100% - (2 * var(--page-gutter)), 74rem);
    gap: 1.5rem;
    padding-block: 1.25rem 2.5rem;
  }

  .homepage > :not(.homepage__community):not(:first-child) {
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border);
  }

  .homepage__community {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border);
  }

  @media (min-width: 40rem) {
    .homepage {
      gap: 2rem;
      padding-block-start: 1.75rem;
    }

  }

  @media (min-width: 72rem) {
    .homepage {
      gap: 2.5rem;
      padding-block-start: 2rem;
    }
  }
</style>
