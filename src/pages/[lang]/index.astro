---
import {sanityClient} from 'sanity:client'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import {getTranslations} from '../../i18n'
import {
  supportedLanguages,
  type SupportedLanguage,
} from '../../i18n/config'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {urlFor} from '../../lib/sanity/image'
import {
  FEATURED_PUBLIC_INFORMATION_GUIDES_QUERY,
  HOMEPAGE_FEATURED_NEWS_BY_LANGUAGE_QUERY,
  HOMEPAGE_LATEST_NEWS_BY_LANGUAGE_QUERY,
  IMPORTANT_NOW_NEWS_BY_LANGUAGE_QUERY,
} from '../../lib/sanity/queries'

export function getStaticPaths() {
  return supportedLanguages.map((language) => ({
    params: {lang: language},
    props: {language},
  }))
}

interface HomeGuide {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  summary: string
  topic: string
  responsibleAgency: string
  lastReviewedAt: string
  isUrgent?: boolean
}

interface HomeArticleImage {
  asset?: unknown
  alt?: string
  caption?: string
  credit?: string
  hotspot?: unknown
  crop?: unknown
}

interface HomeArticle {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  summary: string
  newsRegion: string
  category: string
  publishedAt: string
  importantUntil?: string
  featuredImage?: HomeArticleImage
}

const {language} = Astro.props
const labels = getTranslations(language)
const alternateLanguage: SupportedLanguage = language === 'ne' ? 'nb' : 'ne'

const [featuredGuides, importantNow, featuredStory] = await Promise.all([
  sanityClient.fetch<HomeGuide[]>(FEATURED_PUBLIC_INFORMATION_GUIDES_QUERY, {
    language,
  }),
  sanityClient.fetch<HomeArticle | null>(IMPORTANT_NOW_NEWS_BY_LANGUAGE_QUERY, {
    language,
  }),
  sanityClient.fetch<HomeArticle | null>(HOMEPAGE_FEATURED_NEWS_BY_LANGUAGE_QUERY, {
    language,
  }),
])

const latestStories = await sanityClient.fetch<HomeArticle[]>(
  HOMEPAGE_LATEST_NEWS_BY_LANGUAGE_QUERY,
  {language, excludeId: featuredStory?._id ?? null},
)

const imageUrl = (image?: HomeArticleImage, width = 1200) =>
  image?.asset ? urlFor(image as any).width(width).fit('crop').auto('format').url() : null
const homepageRegionLabels: Record<string, Record<SupportedLanguage, string>> = {
  norway: {ne: 'नर्वे', nb: 'Norge'},
  nepal: {ne: 'नेपाल', nb: 'Nepal'},
  community: {ne: 'समुदाय', nb: 'Fellesskap'},
  international: {ne: 'अन्तर्राष्ट्रिय', nb: 'Internasjonalt'},
}

const homepageCategoryLabels: Record<string, Record<SupportedLanguage, string>> = {
  'current-affairs': {ne: 'समसामयिक विषय', nb: 'Aktuelt'},
  'immigration-integration': {ne: 'आप्रवासन र एकीकरण', nb: 'Innvandring og integrering'},
  'education-student-life': {ne: 'शिक्षा र विद्यार्थी जीवन', nb: 'Utdanning og studentliv'},
  'employment-economy': {ne: 'रोजगारी र अर्थतन्त्र', nb: 'Arbeidsliv og økonomi'},
  'culture-community': {ne: 'संस्कृति र समुदाय', nb: 'Kultur og fellesskap'},
  'health-welfare': {ne: 'स्वास्थ्य र कल्याण', nb: 'Helse og velferd'},
  sports: {ne: 'खेलकुद', nb: 'Sport'},
}

const getRegionLabel = (value: string) =>
  homepageRegionLabels[value]?.[language] ?? value
const getCategoryLabel = (value: string) =>
  homepageCategoryLabels[value]?.[language] ?? value

const dateLocale = language === 'ne' ? 'ne-NP' : 'nb-NO'
const formatDate = (date: string) =>
  new Date(date).toLocaleDateString(dateLocale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
---

<BaseLayout
  language={language}
  title={labels.home.metaTitle}
  description={labels.home.metaDescription}
>
  <SiteHeader
    slot="header"
    language={language}
    alternatePath={`/${alternateLanguage}/`}
  />

  <section class="home-hero">
    <div class="container home-hero__grid">
      <div class="home-hero__content">
        <p class="eyebrow">{labels.home.eyebrow}</p>
        <h1>{labels.home.title}</h1>
        <p class="lead">{labels.home.introduction}</p>
        <div class="home-hero__actions">
          <a class="button button-primary" href={`/${language}/info/`}>
            {labels.home.primaryAction}
          </a>
          <a class="button button-secondary" href={`/${language}/news/`}>
            {labels.home.secondaryAction}
          </a>
        </div>
      </div>

      <div class="home-hero__pathways" aria-label={labels.home.title}>
        <article class="pathway pathway--understand">
          <span aria-hidden="true">01</span>
          <h2>{labels.home.informationHeading}</h2>
          <p>{labels.home.informationDescription}</p>
        </article>
        <article class="pathway pathway--informed">
          <span aria-hidden="true">02</span>
          <h2>{labels.home.newsHeading}</h2>
          <p>{labels.home.newsDescription}</p>
        </article>
        <article class="pathway pathway--participate">
          <span aria-hidden="true">03</span>
          <h2>{labels.home.discussionsHeading}</h2>
          <p>{labels.home.discussionsDescription}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section home-section" aria-labelledby="home-information-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{labels.home.informationEyebrow}</p>
          <h2 id="home-information-heading">{labels.home.informationHeading}</h2>
          <p>{labels.home.informationDescription}</p>
        </div>
        <a class="section-link" href={`/${language}/info/`}>
          {labels.home.viewAllInformation} <span aria-hidden="true">→</span>
        </a>
      </div>

      {
        featuredGuides.length > 0 ? (
          <ul class="content-grid">
            {featuredGuides.map((guide) => (
              <li>
                <article class="content-card card">
                  <div class="content-card__badges">
                    <span class="badge badge-success">{guide.responsibleAgency}</span>
                    {guide.isUrgent && (
                      <span class="badge badge-brand">{labels.information.urgentLabel}</span>
                    )}
                  </div>
                  <h3>
                    <a href={`/${language}/info/${guide.slug}/`}>{guide.title}</a>
                  </h3>
                  <p>{guide.summary}</p>
                  <a class="content-card__link" href={`/${language}/info/${guide.slug}/`}>
                    {labels.information.readGuide} <span aria-hidden="true">→</span>
                  </a>
                </article>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty-state surface"><p>{labels.home.emptyInformation}</p></div>
        )
      }
    </div>
  </section>

  <section class="section home-news" aria-labelledby="home-news-heading">
    <div class="container">
      {
        importantNow && (
          <aside class="important-now" aria-labelledby="important-now-heading">
            <div class="important-now__label">
              <span aria-hidden="true"></span>
              <strong id="important-now-heading">{labels.home.importantNow}</strong>
            </div>
            <a href={`/${language}/news/${importantNow.slug}/`}>
              {importantNow.title}
            </a>
            {importantNow.importantUntil && (
              <p>
                {labels.home.importantUntil}: {' '}
                <time datetime={importantNow.importantUntil}>
                  {formatDate(importantNow.importantUntil)}
                </time>
              </p>
            )}
          </aside>
        )
      }

      <div class="section-heading news-heading">
        <div>
          <p class="eyebrow">{labels.home.newsEyebrow}</p>
          <h2 id="home-news-heading">{labels.home.newsHeading}</h2>
          <p>{labels.home.newsDescription}</p>
        </div>
        <a class="section-link" href={`/${language}/news/`}>
          {labels.home.viewAllNews} <span aria-hidden="true">→</span>
        </a>
      </div>

      {
        featuredStory || latestStories.length > 0 ? (
          <div class="news-layout">
            {featuredStory && (
              <article class="lead-story">
                {imageUrl(featuredStory.featuredImage) ? (
                  <a
                    class="lead-story__image"
                    href={`/${language}/news/${featuredStory.slug}/`}
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <img
                      src={imageUrl(featuredStory.featuredImage) ?? ''}
                      alt={featuredStory.featuredImage?.alt ?? ''}
                      width="1200"
                      height="720"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ) : (
                  <div class="lead-story__placeholder" aria-hidden="true"></div>
                )}
                <div class="lead-story__content">
                  <p class="story-kicker">
                    {labels.home.featuredStory} · {getRegionLabel(featuredStory.newsRegion)}
                  </p>
                  <h3>
                    <a href={`/${language}/news/${featuredStory.slug}/`}>
                      {featuredStory.title}
                    </a>
                  </h3>
                  <p>{featuredStory.summary}</p>
                  <div class="story-footer">
                    <time datetime={featuredStory.publishedAt}>
                      {formatDate(featuredStory.publishedAt)}
                    </time>
                    <a href={`/${language}/news/${featuredStory.slug}/`}>
                      {labels.home.readFullStory} <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </article>
            )}

            {latestStories.length > 0 && (
              <section
                class:list={['latest-stories', !featuredStory && 'latest-stories--full']}
                aria-labelledby="latest-news-heading"
              >
                <h3 id="latest-news-heading">{labels.home.latestNews}</h3>
                <ol>
                  {latestStories.map((article) => (
                    <li>
                      <article class="latest-story">
                        <div class="latest-story__text">
                          <p class="story-kicker">
                            {getRegionLabel(article.newsRegion)} · {getCategoryLabel(article.category)}
                          </p>
                          <h4>
                            <a href={`/${language}/news/${article.slug}/`}>
                              {article.title}
                            </a>
                          </h4>
                          <time datetime={article.publishedAt}>
                            {formatDate(article.publishedAt)}
                          </time>
                        </div>
                        {imageUrl(article.featuredImage, 360) && (
                          <a
                            class="latest-story__image"
                            href={`/${language}/news/${article.slug}/`}
                            tabindex="-1"
                            aria-hidden="true"
                          >
                            <img
                              src={imageUrl(article.featuredImage, 360) ?? ''}
                              alt=""
                              width="360"
                              height="240"
                              loading="lazy"
                              decoding="async"
                            />
                          </a>
                        )}
                      </article>
                    </li>
                  ))}
                </ol>
              </section>
            )}
          </div>
        ) : (
          <div class="empty-state editorial-empty">
            <span class="editorial-empty__rule" aria-hidden="true"></span>
            <p>{labels.home.emptyNews}</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section discussions" aria-labelledby="home-discussions-heading">
    <div class="container discussions__grid">
      <div>
        <p class="eyebrow">{labels.home.discussionsEyebrow}</p>
        <h2 id="home-discussions-heading">{labels.home.discussionsHeading}</h2>
        <p class="lead">{labels.home.discussionsDescription}</p>
        <span class="badge badge-brand">{labels.home.forumComingSoon}</span>
      </div>

      <div class="discussions__preview" aria-hidden="true">
        <div class="discussion-line discussion-line--wide"></div>
        <div class="discussion-line"></div>
        <div class="discussion-line discussion-line--short"></div>
        <div class="discussion-line discussion-line--wide"></div>
      </div>
    </div>
    <div class="container discussions__notice">
      <p>{labels.home.forumNotice}</p>
    </div>
  </section>

  <section class="section-sm future-sections">
    <div class="container future-sections__grid">
      <article class="future-card">
        <span class="future-card__number" aria-hidden="true">01</span>
        <h2>{labels.home.eventsHeading}</h2>
        <p>{labels.home.eventsDescription}</p>
        <span class="badge">{labels.home.comingSoon}</span>
      </article>
      <article class="future-card">
        <span class="future-card__number" aria-hidden="true">02</span>
        <h2>{labels.home.businessesHeading}</h2>
        <p>{labels.home.businessesDescription}</p>
        <span class="badge">{labels.home.comingSoon}</span>
      </article>
    </div>
  </section>

  <SiteFooter slot="footer" language={language} />
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 85% 15%, rgb(198 42 31 / 0.12), transparent 20rem),
      linear-gradient(135deg, #f5f8fb 0%, #fdfcf9 60%, #fff5f4 100%);
  }

  .home-hero::after {
    content: '';
    position: absolute;
    width: 22rem;
    height: 22rem;
    inset-block-end: -14rem;
    inset-inline-end: 5%;
    border: 1px solid rgb(198 42 31 / 0.13);
    border-radius: 50%;
  }

  .home-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.75fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .home-hero__content h1 {
    max-width: 14ch;
    margin-block-start: 0.75rem;
  }

  .home-hero__content .lead {
    max-width: 43rem;
    margin-block-start: 1.4rem;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-block-start: 2rem;
  }

  .home-hero__pathways {
    display: grid;
    gap: 0.75rem;
  }

  .pathway {
    position: relative;
    padding: 1.1rem 1.2rem 1.2rem 4rem;
    border: 1px solid rgb(48 70 92 / 0.14);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.72);
    backdrop-filter: blur(0.5rem);
  }

  .pathway > span {
    position: absolute;
    inset-block-start: 1.2rem;
    inset-inline-start: 1.15rem;
    color: var(--brand);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .pathway h2 {
    font-size: 1.15rem;
  }

  .pathway p {
    margin-block-start: 0.35rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .home-section--muted {
    background: var(--surface-muted);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-block-end: 2rem;
  }

  .section-heading h2 {
    margin-block-start: 0.55rem;
  }

  .section-heading p:not(.eyebrow) {
    max-width: 45rem;
    margin-block-start: 0.65rem;
    color: var(--text-muted);
  }

  .section-link {
    flex: 0 0 auto;
    color: var(--civic-deep);
    font-weight: 750;
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .content-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: 1.5rem;
  }

  .content-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .content-card h3 {
    margin-block-start: 1.15rem;
  }

  .content-card h3 a {
    color: var(--civic-deep);
    text-decoration: none;
  }

  .content-card h3 a:hover {
    color: var(--brand);
  }

  .content-card > p {
    margin-block: 0.8rem 1.25rem;
    color: var(--text-muted);
  }

  .content-card time {
    margin-block-start: auto;
    color: var(--text-soft);
    font-size: 0.85rem;
  }

  .content-card__link {
    margin-block-start: auto;
    font-weight: 750;
  }

  .empty-state {
    padding: clamp(2rem, 5vw, 3.5rem);
    color: var(--text-muted);
    text-align: center;
  }

  .home-news {
    background: #ffffff;
  }

  .important-now {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
    padding: 0.85rem 1rem;
    border-block: 1px solid #f0b4ae;
    background: #fff8f7;
  }

  .important-now__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--brand);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  html[lang="ne"] .important-now__label {
    font-size: 0.9rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .important-now__label span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--brand);
    box-shadow: 0 0 0 0.25rem rgb(198 42 31 / 0.12);
  }

  .important-now > a {
    color: var(--civic-deep);
    font-weight: 760;
    text-decoration: none;
  }

  .important-now > a:hover {
    color: var(--brand);
  }

  .important-now > p {
    color: var(--text-soft);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .news-heading {
    padding-block-end: 1.4rem;
    border-bottom: 2px solid var(--civic-deep);
  }

  .news-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(18rem, 0.75fr);
    gap: clamp(2rem, 5vw, 4rem);
  }

  .lead-story {
    min-width: 0;
  }

  .lead-story__image,
  .lead-story__placeholder {
    display: block;
    overflow: hidden;
    aspect-ratio: 5 / 3;
    background:
      linear-gradient(135deg, rgb(48 70 92 / 0.9), rgb(23 37 52 / 0.98));
  }

  .lead-story__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .lead-story__image:hover img {
    transform: scale(1.015);
  }

  .lead-story__content {
    padding-block-start: 1.25rem;
  }

  .story-kicker {
    color: var(--brand);
    font-size: 0.76rem;
    font-weight: 780;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  html[lang="ne"] .story-kicker {
    font-size: 0.86rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .lead-story h3 {
    margin-block-start: 0.55rem;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.15;
  }

  .lead-story h3 a,
  .latest-story h4 a {
    color: var(--civic-deep);
    text-decoration: none;
  }

  .lead-story h3 a:hover,
  .latest-story h4 a:hover {
    color: var(--brand);
  }

  .lead-story__content > p:not(.story-kicker) {
    max-width: 52rem;
    margin-block-start: 0.85rem;
    color: var(--text-muted);
  }

  .story-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 1.25rem;
    padding-block-start: 0.9rem;
    border-top: 1px solid var(--border);
    font-size: 0.86rem;
  }

  .story-footer time,
  .latest-story time {
    color: var(--text-soft);
  }

  .story-footer a {
    font-weight: 750;
  }

  .latest-stories {
    border-top: 0.3rem solid var(--brand);
  }

  .latest-stories--full {
    grid-column: 1 / -1;
  }

  .latest-stories > h3 {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--civic-deep);
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  html[lang="ne"] .latest-stories > h3 {
    letter-spacing: 0;
    text-transform: none;
  }

  .latest-stories ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .latest-stories li {
    border-bottom: 1px solid var(--border);
  }

  .latest-story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    padding-block: 1rem;
  }

  .latest-story h4 {
    margin-block: 0.35rem 0.55rem;
    font-size: 1.08rem;
    line-height: 1.3;
  }

  .latest-story__image {
    display: block;
    overflow: hidden;
    width: 6rem;
    aspect-ratio: 3 / 2;
    background: var(--surface-muted);
  }

  .latest-story__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial-empty {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--border-strong);
    background: transparent;
    box-shadow: none;
  }

  .editorial-empty__rule {
    display: block;
    width: 3rem;
    height: 0.2rem;
    margin-inline: auto;
    margin-block-end: 1rem;
    background: var(--brand);
  }

  .discussions {
    background: var(--civic-deep);
    color: rgb(255 255 255 / 0.78);
  }

  .discussions__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    gap: clamp(3rem, 9vw, 7rem);
    align-items: center;
  }

  .discussions h2 {
    max-width: 18ch;
    margin-block-start: 0.65rem;
    color: #ffffff;
  }

  .discussions .lead {
    max-width: 42rem;
    margin-block: 1rem 1.5rem;
    color: rgb(255 255 255 / 0.68);
  }

  .discussions__preview {
    display: grid;
    gap: 0.8rem;
    padding: 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-xl);
    background: rgb(255 255 255 / 0.05);
  }

  .discussion-line {
    height: 3.2rem;
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: var(--radius-md);
    background: linear-gradient(90deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.03));
  }

  .discussion-line--wide {
    width: 100%;
  }

  .discussion-line--short {
    width: 72%;
  }

  .discussions__notice {
    margin-block-start: 2.25rem;
    padding-block-start: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.11);
    color: rgb(255 255 255 / 0.52);
    font-size: 0.875rem;
  }

  .future-sections__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
