---
import {PortableText} from 'astro-portabletext'
import {sanityClient} from 'sanity:client'
import GuidanceTopicIcon from '../../../../components/content/GuidanceTopicIcon.astro'
import SiteFooter from '../../../../components/SiteFooter.astro'
import SiteHeader from '../../../../components/SiteHeader.astro'
import {isSectionEnabled} from '../../../../config/languageSections'
import {getTranslations} from '../../../../i18n'
import type {SupportedLanguage} from '../../../../i18n/config'
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import {
  formatGuideDate,
  guideHref,
  sortGuidesByRecency,
} from '../../../../lib/guidanceHub'
import {
  PUBLIC_INFORMATION_GUIDES_BY_TOPIC_QUERY,
  PUBLIC_INFORMATION_TOPIC_BY_SLUG_QUERY,
} from '../../../../lib/sanity/queries'

interface TopicTranslation {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  isActive?: boolean
}

interface TopicGuide {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  summary: string
  topic: string
  intendedAudience?: string[]
  responsibleAgency: string
  publishedAt?: string
  lastReviewedAt: string
  nextReviewAt?: string
  status: string
  isFeatured?: boolean
  isUrgent?: boolean
}

interface TopicHub {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  topicKey: string
  summary: string
  introduction?: any[]
  displayOrder: number
  iconKey?: string
  seoDescription?: string
  translation?: TopicTranslation
  featuredGuides?: TopicGuide[]
}

interface TopicPath {
  slug: string
  language: SupportedLanguage
}

export async function getStaticPaths() {
  const topics = await sanityClient.fetch<TopicPath[]>(`
    *[
      _type == "publicInformationTopic" &&
      isActive == true &&
      language in ["ne", "nb"] &&
      defined(slug.current)
    ] {
      "slug": slug.current,
      language
    }
  `)

  return topics
    .filter(({language}) => isSectionEnabled(language, 'information'))
    .map(({slug, language}) => ({
      params: {lang: language, slug},
    }))
}

const {lang, slug} = Astro.params

if ((lang !== 'ne' && lang !== 'nb') || !slug) {
  return Astro.redirect('/ne/info/')
}

const language: SupportedLanguage = lang
const topic = await sanityClient.fetch<TopicHub | null>(
  PUBLIC_INFORMATION_TOPIC_BY_SLUG_QUERY,
  {language, slug},
)

if (!topic) {
  return Astro.redirect(`/${language}/info/`)
}

const allGuides = await sanityClient.fetch<TopicGuide[]>(
  PUBLIC_INFORMATION_GUIDES_BY_TOPIC_QUERY,
  {language, topicKey: topic.topicKey},
)

const sortedAllGuides = sortGuidesByRecency(allGuides)
const urgentGuides = sortedAllGuides.filter((guide) => Boolean(guide.isUrgent))

const curatedFeatured = (topic.featuredGuides ?? []).filter(
  (guide) =>
    guide &&
    guide.language === language &&
    guide.topic === topic.topicKey &&
    guide.status === 'active',
)
const featuredGuides =
  curatedFeatured.length > 0
    ? curatedFeatured.slice(0, 3)
    : sortedAllGuides.filter((guide) => Boolean(guide.isFeatured)).slice(0, 3)

const featuredIds = new Set(featuredGuides.map((guide) => guide._id))
const remainingGuides = sortedAllGuides.filter((guide) => !featuredIds.has(guide._id))

const alternateLanguage: SupportedLanguage = language === 'ne' ? 'nb' : 'ne'
const alternatePath =
  topic.translation?.isActive && topic.translation.language === alternateLanguage
    ? `/${topic.translation.language}/info/topic/${topic.translation.slug}/`
    : `/${alternateLanguage}/info/`

const labels = getTranslations(language)
const infoLabels = labels.information

const copy =
  language === 'ne'
    ? {
        section: 'मार्गदर्शन',
        featured: 'सुरु गर्न उपयोगी जानकारी',
        allGuides: 'यस विषयका सबै जानकारी',
        guide: 'प्रकाशित मार्गदर्शन',
        guides: 'प्रकाशित मार्गदर्शनहरू',
        read: 'पूरा जानकारी पढ्नुहोस्',
        reviewed: 'पछिल्लो समीक्षा',
        urgent: 'अत्यावश्यक जानकारी',
        emptyTitle: 'यस विषयमा मार्गदर्शन तयार हुँदैछन्',
        emptyText:
          'प्रमाणित र आधिकारिक स्रोतमा आधारित सामग्री तयार भएपछि यहाँ प्रकाशित गरिनेछ।',
        translation: 'अर्को भाषामा हेर्नुहोस्',
      }
    : {
        section: 'Livet i Norge',
        featured: 'Nyttige veiledninger å starte med',
        allGuides: 'Alle veiledninger i dette temaet',
        guide: 'publisert veiledning',
        guides: 'publiserte veiledninger',
        read: 'Les veiledningen',
        reviewed: 'Sist gjennomgått',
        urgent: 'Viktig informasjon',
        emptyTitle: 'Veiledninger for dette temaet er under arbeid',
        emptyText:
          'Innhold basert på kontrollerte og offisielle kilder publiseres her når det er klart.',
        translation: 'Se på et annet språk',
      }

const guideCount = allGuides.length
const guideCountText = `${guideCount} ${guideCount === 1 ? copy.guide : copy.guides}`
---

<BaseLayout
  language={language}
  title={`${topic.title} | nepali.no`}
  bodyClass="guidance-topic-hub"
  description={topic.seoDescription || topic.summary}
>
  <SiteHeader slot="header" language={language} alternatePath={alternatePath} />

  <div class="topic-hub container">
    <header class="topic-masthead">
      <nav class="breadcrumbs" aria-label={copy.section}>
        <a href={`/${language}/`}>{labels.navigation.home}</a>
        <span aria-hidden="true">/</span>
        <a href={`/${language}/info/`}>{copy.section}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{topic.title}</span>
      </nav>

      <div class="masthead-main">
        <div class="masthead-title-row">
          <span class="topic-icon">
            <GuidanceTopicIcon topicKey={topic.topicKey} />
          </span>
          <div>
            <h1>{topic.title}</h1>
            <p class="topic-summary">{topic.summary}</p>
          </div>
        </div>

        <aside class="masthead-aside" aria-label={guideCountText}>
          <span class="topic-count">{guideCountText}</span>
          {topic.translation?.isActive && (
            <a href={alternatePath} hreflang={topic.translation.language}>
              {copy.translation}
            </a>
          )}
        </aside>
      </div>
    </header>

    {topic.introduction && topic.introduction.length > 0 && (
      <section class="topic-intro">
        <div class="prose topic-intro__content">
          <PortableText value={topic.introduction} />
        </div>
      </section>
    )}

    {urgentGuides.length > 0 && (
      <aside class="urgent-strip" aria-labelledby="topic-urgent-heading">
        <h2 id="topic-urgent-heading" class="urgent-label">
          {copy.urgent}
        </h2>
        <ul class="urgent-list">
          {urgentGuides.map((guide) => (
            <li>
              <a href={guideHref(language, guide.slug)}>
                <span>{guide.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    {guideCount === 0 ? (
      <section class="topic-empty">
        <h2>{copy.emptyTitle}</h2>
        <p>{copy.emptyText}</p>
        <a class="back-link" href={`/${language}/info/`}>
          <span aria-hidden="true">←</span>
          <span>{infoLabels.backToHub}</span>
        </a>
      </section>
    ) : (
      <>
        {featuredGuides.length > 0 && (
          <section class="featured-band" aria-labelledby="featured-guides-heading">
            <h2 id="featured-guides-heading" class="section-heading">
              {copy.featured}
            </h2>
            <div
              class:list={[
                'featured-composition',
                {'has-supporting': featuredGuides.length > 1},
              ]}
            >
              <article class="featured-lead">
                <p class="featured-kicker">
                  {[
                    infoLabels.featuredSpotlightLabel,
                    featuredGuides[0].responsibleAgency,
                  ]
                    .filter(Boolean)
                    .join(' · ')}
                </p>
                <h3>
                  <a href={guideHref(language, featuredGuides[0].slug)}>
                    {featuredGuides[0].title}
                  </a>
                </h3>
                <p class="featured-summary">{featuredGuides[0].summary}</p>
                <div class="featured-footer">
                  <span class="guide-date">
                    {copy.reviewed}:{' '}
                    {formatGuideDate(
                      featuredGuides[0].lastReviewedAt || featuredGuides[0].publishedAt,
                      language,
                    )}
                  </span>
                  <a
                    class="guide-action"
                    href={guideHref(language, featuredGuides[0].slug)}
                  >
                    <span>{copy.read}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>

              {featuredGuides.length > 1 && (
                <div class="featured-supporting">
                  {featuredGuides.slice(1).map((guide) => {
                    const reviewed = formatGuideDate(
                      guide.lastReviewedAt || guide.publishedAt,
                      language,
                    )
                    return (
                      <article class="supporting-item">
                        <h3>
                          <a href={guideHref(language, guide.slug)}>{guide.title}</a>
                        </h3>
                        <p class="supporting-summary">{guide.summary}</p>
                        <p class="supporting-meta">
                          {[guide.responsibleAgency, reviewed].filter(Boolean).join(' · ')}
                        </p>
                      </article>
                    )
                  })}
                </div>
              )}
            </div>
          </section>
        )}

        {remainingGuides.length > 0 && (
          <section class="directory-band" aria-labelledby="all-topic-guides-heading">
            <h2 id="all-topic-guides-heading" class="section-heading">
              {copy.allGuides}
            </h2>
            <ol class="topic-guide-list">
              {remainingGuides.map((guide) => {
                const reviewed = formatGuideDate(
                  guide.lastReviewedAt || guide.publishedAt,
                  language,
                )
                const metaLine = [guide.responsibleAgency, reviewed]
                  .filter(Boolean)
                  .join(' · ')
                return (
                  <li>
                    <article class="directory-item">
                      <h3>
                        <a href={guideHref(language, guide.slug)}>{guide.title}</a>
                      </h3>
                      <p class="directory-summary">{guide.summary}</p>
                      {metaLine && <p class="directory-meta">{metaLine}</p>}
                      <a class="guide-action" href={guideHref(language, guide.slug)}>
                        <span>{copy.read}</span>
                        <span aria-hidden="true">→</span>
                      </a>
                    </article>
                  </li>
                )
              })}
            </ol>
          </section>
        )}

        <nav class="topic-footer-nav" aria-label={infoLabels.backToHub}>
          <a class="back-link" href={`/${language}/info/`}>
            <span aria-hidden="true">←</span>
            <span>{infoLabels.backToHub}</span>
          </a>
        </nav>
      </>
    )}
  </div>

  <SiteFooter slot="footer" language={language} flush />
</BaseLayout>

<style>
  .topic-hub {
    padding-block-end: 2.5rem;
  }

  .topic-masthead {
    margin-block: 1.25rem 1.75rem;
    padding-block: 0.75rem 1.25rem;
    border-top: 3px solid var(--civic-deep);
    border-bottom: 1px solid var(--border-strong);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-block-end: 0.9rem;
    color: var(--text-soft);
    font-size: 0.875rem;
  }

  .breadcrumbs a {
    color: var(--civic);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    text-decoration: underline;
  }

  .masthead-main {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .masthead-title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    max-width: 52rem;
  }

  .topic-icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    margin-block-start: 0.35rem;
    color: var(--civic-deep);
  }

  h1 {
    margin: 0;
    color: var(--civic-deep);
    font-size: clamp(1.85rem, 3.6vw, 2.75rem);
    line-height: 1.3;
  }

  .topic-summary {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .masthead-aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding-block-start: 0.25rem;
  }

  .topic-count {
    color: var(--text-muted);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .masthead-aside a {
    color: var(--civic);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .topic-intro {
    margin-block-end: 2rem;
  }

  .topic-intro__content {
    max-width: 66ch;
  }

  .urgent-strip {
    margin-block-end: 2rem;
    padding: 0.85rem 1rem;
    border-inline-start: 3px solid var(--brand);
    background: var(--color-brand-50);
  }

  .urgent-label {
    margin: 0 0 0.35rem;
    color: var(--brand);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .urgent-list {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .urgent-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 44px;
    color: var(--civic-deep);
    font-weight: 600;
    text-decoration: none;
  }

  .urgent-list a:hover {
    text-decoration: underline;
  }

  .section-heading {
    margin: 0 0 1.25rem;
    padding-block-end: 0.6rem;
    border-bottom: 2px solid var(--civic-deep);
    color: var(--civic-deep);
    font-size: 1.5rem;
  }

  .featured-band {
    margin-block-end: 2.5rem;
  }

  .featured-composition {
    display: grid;
    gap: 1.75rem;
    align-items: start;
  }

  .featured-lead {
    display: grid;
    gap: 0.75rem;
    padding: 1.35rem 1.5rem;
    border-top: 2px solid var(--civic-deep);
    background: var(--surface-warm);
  }

  .featured-kicker {
    margin: 0;
    color: var(--civic);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .featured-lead h3,
  .supporting-item h3,
  .directory-item h3 {
    margin: 0;
    line-height: 1.4;
  }

  .featured-lead h3 {
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
  }

  .featured-lead h3 a,
  .supporting-item h3 a,
  .directory-item h3 a {
    color: var(--civic-deep);
    text-decoration: none;
  }

  .featured-lead h3 a:hover,
  .supporting-item h3 a:hover,
  .directory-item h3 a:hover {
    text-decoration: underline;
  }

  .featured-summary,
  .supporting-summary,
  .directory-summary {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .featured-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    margin-block-start: 0.25rem;
    padding-block-start: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .guide-date,
  .supporting-meta,
  .directory-meta {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.8125rem;
  }

  .guide-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    min-height: 44px;
    color: var(--civic-deep);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .guide-action:hover {
    text-decoration: underline;
  }

  .featured-supporting {
    display: grid;
    gap: 1.25rem;
  }

  .supporting-item {
    display: grid;
    gap: 0.45rem;
    padding-block-end: 1.15rem;
    border-bottom: 1px solid var(--border);
  }

  .supporting-item h3 {
    font-size: 1.15rem;
  }

  .directory-band {
    margin-block-start: 2rem;
  }

  .topic-guide-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topic-guide-list li {
    min-width: 0;
    padding-block-start: 1rem;
    border-top: 1px solid var(--border);
  }

  .directory-item {
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }

  .directory-item h3 {
    font-size: 1.125rem;
  }

  .topic-empty {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border-top: 2px solid var(--civic-deep);
    background: var(--surface-muted);
  }

  .topic-empty h2 {
    margin: 0;
    color: var(--civic-deep);
  }

  .topic-empty p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .topic-footer-nav {
    margin-block-start: 2.5rem;
    padding-block-start: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    min-height: 44px;
    color: var(--civic-deep);
    font-weight: 600;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  @media (min-width: 48rem) {
    .topic-guide-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .featured-composition.has-supporting {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: 2rem;
    }

    .topic-guide-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
