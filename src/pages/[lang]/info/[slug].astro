---
import {sanityClient} from 'sanity:client'
import GuideView from '../../../components/articles/GuideView.astro'
import type {GuideDocument} from '../../../components/articles/GuideView.astro'
import {isSectionEnabled} from '../../../config/languageSections'
import type {SupportedLanguage} from '../../../i18n/config'
import {PUBLIC_INFORMATION_GUIDE_BY_SLUG_QUERY} from '../../../lib/sanity/queries'

interface GuidePath {
  slug: string
  language: SupportedLanguage
}

export async function getStaticPaths() {
  const paths = await sanityClient.fetch<GuidePath[]>(`
    *[
      _type == "publicInformationGuide" &&
      defined(slug.current) &&
      language in ["ne", "nb"] &&
      status == "active"
    ] {
      "slug": slug.current,
      language
    }
  `)

  return paths
    .filter(({language}) => isSectionEnabled(language, 'information'))
    .map(({slug, language}) => ({
    params: {
      lang: language,
      slug,
    },
  }))
}

const {lang, slug} = Astro.params

if ((lang !== 'ne' && lang !== 'nb') || !slug) {
  return Astro.redirect('/ne/info/')
}

const language: SupportedLanguage = lang
const guide = await sanityClient.fetch<GuideDocument | null>(
  PUBLIC_INFORMATION_GUIDE_BY_SLUG_QUERY,
  {language, slug},
)

if (!guide) {
  return Astro.redirect(`/${language}/info/`)
}
---

<GuideView guide={guide} language={language} />
