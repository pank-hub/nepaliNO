---
import {sanityClient} from 'sanity:client'
import GuidanceMasthead from '../../../components/guidance/GuidanceMasthead.astro'
import GuidanceRecentPackage from '../../../components/guidance/GuidanceRecentPackage.astro'
import GuidanceTopicShowcase from '../../../components/guidance/GuidanceTopicShowcase.astro'
import SiteFooter from '../../../components/SiteFooter.astro'
import SiteHeader from '../../../components/SiteHeader.astro'
import {getLanguagesWithSection} from '../../../config/languageSections'
import {getTranslations} from '../../../i18n'
import type {SupportedLanguage} from '../../../i18n/config'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import {
  composeGuidanceHub,
  formatGuideDate,
  guideHref,
  sortGuidesByRecency,
  type GuidanceGuideItem,
  type GuidanceTopicItem,
} from '../../../lib/guidanceHub'
import {buildGuideSearchText} from '../../../lib/guideSearch'
import {
  ACTIVE_PUBLIC_INFORMATION_GUIDES_QUERY,
  PUBLIC_INFORMATION_TOPICS_BY_LANGUAGE_QUERY,
} from '../../../lib/sanity/queries'

export function getStaticPaths() {
  return getLanguagesWithSection('information').map((language) => ({
    params: {lang: language},
    props: {language},
  }))
}

const {language} = Astro.props
const labels = getTranslations(language)
const alternateLanguage: SupportedLanguage = language === 'ne' ? 'nb' : 'ne'

const [sanityTopics, guides] = await Promise.all([
  sanityClient.fetch<GuidanceTopicItem[]>(PUBLIC_INFORMATION_TOPICS_BY_LANGUAGE_QUERY, {
    language,
  }),
  sanityClient.fetch<GuidanceGuideItem[]>(ACTIVE_PUBLIC_INFORMATION_GUIDES_QUERY, {
    language,
  }),
])

const hub = composeGuidanceHub(sanityTopics, guides)
const orderedTopics = hub.orderedTopics
const activeTopicKeys = new Set(orderedTopics.map((topic) => topic.topicKey))
const sortedGuides = sortGuidesByRecency(guides)
const fallbackGuides = hub.fallbackGuides
const fallbackGuideIds = new Set(fallbackGuides.map((guide) => guide._id))
const hasRecentContent = Boolean(hub.urgentGuide || hub.leadGuide)
const showGuidesSection = orderedTopics.length === 0 || guides.length > 0
const guidesVisibleByDefault = orderedTopics.length === 0 || fallbackGuides.length > 0

const searchableGuides = sortedGuides.map((guide) => ({
  guide,
  searchText: buildGuideSearchText(guide),
  inDefaultView: orderedTopics.length === 0 || fallbackGuideIds.has(guide._id),
}))

const copy =
  language === 'ne'
    ? {
        fallbackEyebrow: 'थप उपयोगी जानकारी',
        fallbackHeading: 'अन्य प्रकाशित जानकारी',
        fallbackDescription:
          'विषय पृष्ठमा समावेश हुन बाँकी सक्रिय जानकारी यहाँ उपलब्ध छन्।',
      }
    : {
        fallbackEyebrow: 'Mer nyttig informasjon',
        fallbackHeading: 'Andre publiserte veiledninger',
        fallbackDescription:
          'Aktive veiledninger som ennå ikke tilhører en offentlig temaside, vises her.',
      }
---

<BaseLayout
  language={language}
  title={`${labels.information.pageTitle} | nepali.no`}
  bodyClass="guidance-hub"
  description={labels.information.pageDescription}
>
  <SiteHeader
    slot="header"
    language={language}
    alternatePath={`/${alternateLanguage}/info/`}
  />

  <div class="guidance-hub container">
    <GuidanceMasthead
      language={language}
      topicCount={orderedTopics.length}
      guideCount={guides.length}
      quickTopics={hub.coreTopics.map((item) => item.topic)}
      hasRecent={hasRecentContent}
    />

    {guides.length > 0 && (
      <section class="info-search" hidden data-guide-search-section>
        <form class="info-search__form" role="search" data-guide-search-form>
          <label class="sr-only" for="guide-search-input">
            {labels.information.searchLabel}
          </label>
          <input
            id="guide-search-input"
            type="search"
            name="q"
            autocomplete="off"
            placeholder={labels.information.searchPlaceholder}
            aria-describedby="guide-search-hint guide-search-status"
            data-guide-search-input
          />
          <p id="guide-search-hint" class="sr-only">
            {labels.information.searchHint}
          </p>
          <p
            id="guide-search-status"
            class="sr-only"
            role="status"
            aria-live="polite"
            data-guide-search-status
            data-count-one={labels.information.searchResultCount.one}
            data-count-other={labels.information.searchResultCount.other}
          ></p>
        </form>
      </section>
    )}

    {hasRecentContent && (
      <section
        class="recent-section section-sm"
        aria-labelledby="recent-guidance-heading"
        data-recent-section
      >
        <GuidanceRecentPackage
          language={language}
          urgentGuide={hub.urgentGuide}
          leadGuide={hub.leadGuide}
          recentGuides={hub.recentGuides}
          topicTitles={hub.topicTitles}
        />
      </section>
    )}

    {orderedTopics.length > 0 && (
      <GuidanceTopicShowcase
        language={language}
        coreTopics={hub.coreTopics}
        directoryTopics={hub.directoryTopics}
      />
    )}

    {!hasRecentContent && orderedTopics.length === 0 && (
      <section class="empty-section section-sm" data-info-empty>
        <div class="empty-state">
          <h2>{labels.information.emptyHeading}</h2>
          <p>{labels.information.emptyMessage}</p>
        </div>
      </section>
    )}

    <section class="info-trust-strip" aria-labelledby="information-disclaimer-title">
      <aside class="trust-notice">
        <h2 id="information-disclaimer-title">
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 11v6M12 7h.01"></path>
          </svg>
          <span>{labels.information.disclaimerTitle}</span>
        </h2>
        <p>{labels.information.disclaimer}</p>
      </aside>
    </section>

    {showGuidesSection && (
      <section
        class="guides-section section-sm"
        hidden={!guidesVisibleByDefault}
        aria-labelledby="guides-section-heading"
        data-guides-section
        data-default-visible={guidesVisibleByDefault ? 'true' : 'false'}
      >
        <div class="guides-header" hidden={!guidesVisibleByDefault} data-guides-header>
          <p class="guides-eyebrow">{copy.fallbackEyebrow}</p>
          <h2 id="guides-section-heading">{copy.fallbackHeading}</h2>
          <p class="guides-intro">{copy.fallbackDescription}</p>
        </div>

        <div class="search-results-header" hidden data-search-results-heading>
          <h2>{labels.information.searchResultsHeading}</h2>
          <p class="search-results-summary" data-search-results-summary></p>
        </div>

        <ul class="guide-grid">
          {searchableGuides.map(({guide, searchText, inDefaultView}) => {
            const topicLabel =
              guide.topic && activeTopicKeys.has(guide.topic)
                ? hub.topicTitles[guide.topic]
                : undefined
            const displayDate = formatGuideDate(
              guide.lastReviewedAt ?? guide.publishedAt,
              language,
            )
            const metaLine = [topicLabel, guide.responsibleAgency, displayDate]
              .filter(Boolean)
              .join(' · ')
            return (
              <li
                hidden={!inDefaultView}
                data-guide-item
                data-default-visible={inDefaultView ? 'true' : 'false'}
                data-search-text={searchText}
              >
                <article class="guide-row">
                  <div class="guide-row__header">
                    <h3>
                      <a href={guideHref(language, guide.slug)}>{guide.title}</a>
                    </h3>
                    {guide.isUrgent && (
                      <span class="guide-urgent-note">{labels.information.urgentLabel}</span>
                    )}
                  </div>
                  {metaLine && <p class="guide-row__meta">{metaLine}</p>}
                  <p class="guide-row__summary">{guide.summary}</p>
                  <a class="guide-row__link" href={guideHref(language, guide.slug)}>
                    <span>{labels.information.readGuide}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </article>
              </li>
            )
          })}
        </ul>

        <div class="empty-state" hidden data-guide-search-empty>
          <h3>{labels.information.searchNoResultsHeading}</h3>
          <p>{labels.information.searchNoResultsMessage}</p>
        </div>
      </section>
    )}
  </div>

  <SiteFooter slot="footer" language={language} flush />
</BaseLayout>

<script>
  import {matchesGuideSearch} from '../../../lib/guideSearch'

  const searchSection = document.querySelector<HTMLElement>('[data-guide-search-section]')
  const searchForm = document.querySelector<HTMLFormElement>('[data-guide-search-form]')
  const searchInput = document.querySelector<HTMLInputElement>('[data-guide-search-input]')
  const searchStatus = document.querySelector<HTMLElement>('[data-guide-search-status]')
  const recentSection = document.querySelector<HTMLElement>('[data-recent-section]')
  const topicsSection = document.querySelector<HTMLElement>('[data-topics-section]')
  const infoEmptySection = document.querySelector<HTMLElement>('[data-info-empty]')
  const guidesSection = document.querySelector<HTMLElement>('[data-guides-section]')
  const guidesHeader = document.querySelector<HTMLElement>('[data-guides-header]')
  const searchResultsHeading = document.querySelector<HTMLElement>(
    '[data-search-results-heading]',
  )
  const searchResultsSummary = document.querySelector<HTMLElement>(
    '[data-search-results-summary]',
  )
  const searchEmptyState = document.querySelector<HTMLElement>('[data-guide-search-empty]')
  const guideItems = Array.from(document.querySelectorAll<HTMLElement>('[data-guide-item]'))

  if (searchSection && searchInput && guidesSection) {
    searchSection.hidden = false
    const guidesVisibleByDefault = guidesSection.dataset.defaultVisible === 'true'
    const countOne = searchStatus?.dataset.countOne ?? '{count} result'
    const countOther = searchStatus?.dataset.countOther ?? '{count} results'

    const formatCount = (count: number) =>
      (count === 1 ? countOne : countOther).replace('{count}', String(count))

    const updateSearch = () => {
      const query = searchInput.value.trim()
      const searching = query.length > 0

      if (!searching) {
        if (recentSection) recentSection.hidden = false
        if (topicsSection) topicsSection.hidden = false
        if (infoEmptySection) infoEmptySection.hidden = false
        guidesSection.hidden = !guidesVisibleByDefault
        if (guidesHeader) guidesHeader.hidden = !guidesVisibleByDefault
        if (searchResultsHeading) searchResultsHeading.hidden = true
        if (searchEmptyState) searchEmptyState.hidden = true
        if (searchStatus) searchStatus.textContent = ''

        for (const item of guideItems) {
          item.hidden = item.dataset.defaultVisible !== 'true'
        }
        return
      }

      if (recentSection) recentSection.hidden = true
      if (topicsSection) topicsSection.hidden = true
      if (infoEmptySection) infoEmptySection.hidden = true
      guidesSection.hidden = false
      if (guidesHeader) guidesHeader.hidden = true
      if (searchResultsHeading) searchResultsHeading.hidden = false

      let matches = 0
      for (const item of guideItems) {
        const matched = matchesGuideSearch(item.dataset.searchText ?? '', query)
        item.hidden = !matched
        if (matched) matches += 1
      }

      const countMessage = formatCount(matches)
      if (searchStatus) searchStatus.textContent = countMessage
      if (searchResultsSummary) searchResultsSummary.textContent = countMessage
      if (searchEmptyState) searchEmptyState.hidden = matches > 0
    }

    searchForm?.addEventListener('submit', (event) => {
      event.preventDefault()
      updateSearch()
    })

    searchInput.addEventListener('input', updateSearch)
    updateSearch()
  }
</script>

<style>
  .guidance-hub {
    padding-block-end: 2.5rem;
  }

  .info-search {
    padding-block: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .info-search__form {
    max-width: 44rem;
  }

  .info-search input[type='search'] {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.95rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }

  .info-search input[type='search']:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-color: var(--civic-deep);
  }

  .recent-section {
    padding-block: 1.5rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .info-trust-strip {
    margin-block-start: 2.25rem;
  }

  .trust-notice {
    max-width: 66rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
  }

  .trust-notice h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.35rem;
    font-size: 1rem;
    color: var(--civic-deep);
  }

  .trust-notice h2 svg {
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    color: var(--civic-deep);
  }

  .trust-notice p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.8;
    font-size: 0.9375rem;
  }

  .guides-section {
    margin-block-start: 2rem;
  }

  .guides-header,
  .search-results-header {
    margin-block-end: 1.25rem;
    padding-block-end: 0.6rem;
    border-bottom: 2px solid var(--civic-deep);
  }

  .guides-eyebrow {
    margin: 0 0 0.2rem;
    color: var(--civic);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .guides-header h2,
  .search-results-header h2 {
    margin: 0;
    color: var(--civic-deep);
    font-size: 1.5rem;
  }

  .guides-intro,
  .search-results-summary {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .guide-grid {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-grid > li {
    min-width: 0;
    padding-block: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .guide-row {
    display: grid;
    gap: 0.4rem;
  }

  .guide-row__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 0.75rem;
  }

  .guide-row__header h3 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.45;
  }

  .guide-row__header h3 a {
    color: var(--civic-deep);
    text-decoration: none;
  }

  .guide-row__header h3 a:hover {
    text-decoration: underline;
  }

  .guide-urgent-note {
    color: var(--brand);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .guide-row__meta {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.8125rem;
  }

  .guide-row__summary {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .guide-row__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    min-height: 44px;
    color: var(--civic-deep);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .guide-row__link:hover {
    text-decoration: underline;
  }

  .empty-state {
    padding: 1.5rem;
    border-top: 2px solid var(--civic-deep);
    background: var(--surface-muted);
  }

  .empty-state h2,
  .empty-state h3 {
    margin: 0 0 0.4rem;
    color: var(--civic-deep);
  }

  .empty-state p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.75;
  }

  @media (min-width: 48rem) {
    .guide-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 2rem;
    }
  }
</style>
