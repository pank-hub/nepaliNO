---
import {sanityClient} from 'sanity:client'
import SiteFooter from '../../../components/SiteFooter.astro'
import SiteHeader from '../../../components/SiteHeader.astro'
import {getTranslations} from '../../../i18n'
import {
  supportedLanguages,
  type SupportedLanguage,
} from '../../../i18n/config'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import {
  ACTIVE_PUBLIC_INFORMATION_GUIDES_QUERY,
  PUBLIC_INFORMATION_TOPICS_BY_LANGUAGE_QUERY,
} from '../../../lib/sanity/queries'

export function getStaticPaths() {
  return supportedLanguages.map((language) => ({
    params: {lang: language},
    props: {language},
  }))
}

interface GuideSummary {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  summary: string
  topic: string
  intendedAudience?: string[]
  responsibleAgency: string
  officialSourceUrl: string
  publishedAt: string
  lastReviewedAt: string
  nextReviewAt: string
  isFeatured?: boolean
  isUrgent?: boolean
}

interface TopicSummary {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  topicKey: string
  summary: string
  displayOrder: number
  iconKey?: string
  seoDescription?: string
  guideCount: number
}

const {language} = Astro.props
const labels = getTranslations(language)
const alternateLanguage: SupportedLanguage = language === 'ne' ? 'nb' : 'ne'

const [topics, guides] = await Promise.all([
  sanityClient.fetch<TopicSummary[]>(
    PUBLIC_INFORMATION_TOPICS_BY_LANGUAGE_QUERY,
    {language},
  ),
  sanityClient.fetch<GuideSummary[]>(ACTIVE_PUBLIC_INFORMATION_GUIDES_QUERY, {
    language,
  }),
])

const activeTopicKeys = new Set(topics.map((topic) => topic.topicKey))
const fallbackGuides = guides.filter((guide) => !activeTopicKeys.has(guide.topic))

const dateLocale = language === 'ne' ? 'ne-NP' : 'nb-NO'
const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString(dateLocale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })

const copy =
  language === 'ne'
    ? {
        topicEyebrow: 'विषयअनुसार जानकारी',
        topicHeading: 'आफूलाई चाहिएको विषय छान्नुहोस्',
        topicDescription:
          'सम्बन्धित आधिकारिक स्रोतमा आधारित जानकारी विषयअनुसार व्यवस्थित गरिएको छ।',
        openTopic: 'विषय खोल्नुहोस्',
        article: 'जानकारीमूलक लेख',
        articles: 'जानकारीमूलक लेखहरू',
        fallbackEyebrow: 'थप उपयोगी जानकारी',
        fallbackHeading: 'अन्य प्रकाशित जानकारी',
        fallbackDescription:
          'विषय पृष्ठमा समावेश हुन बाँकी सक्रिय जानकारी यहाँ उपलब्ध छन्।',
      }
    : {
        topicEyebrow: 'Informasjon etter tema',
        topicHeading: 'Velg temaet du trenger',
        topicDescription:
          'Informasjon basert på relevante offisielle kilder er organisert etter tema.',
        openTopic: 'Åpne temaet',
        article: 'veiledning',
        articles: 'veiledninger',
        fallbackEyebrow: 'Mer nyttig informasjon',
        fallbackHeading: 'Andre publiserte veiledninger',
        fallbackDescription:
          'Aktive veiledninger som ennå ikke tilhører en offentlig temaside, vises her.',
      }
---

<BaseLayout
  language={language}
  title={`${labels.information.pageTitle} | nepali.no`}
  description={labels.information.pageDescription}
>
  <SiteHeader
    slot="header"
    language={language}
    alternatePath={`/${alternateLanguage}/info/`}
  />

  <main class="information-page">
    <header class="info-hero">
      <div class="container info-hero__inner">
        <div class="reading-width">
          <h1>{labels.information.pageTitle}</h1>
          <p class="lead">{labels.information.pageDescription}</p>
        </div>
      </div>
    </header>

    <section class="info-trust-strip">
      <div class="container">
        <aside class="trust-notice" aria-labelledby="information-disclaimer-title">
          <div class="trust-notice__symbol" aria-hidden="true">i</div>
          <div>
            <h2 id="information-disclaimer-title">
              {labels.information.disclaimerTitle}
            </h2>
            <p>{labels.information.disclaimer}</p>
          </div>
        </aside>
      </div>
    </section>

    {topics.length > 0 && (
      <section class="topics-section section-sm" aria-labelledby="topics-heading">
        <div class="container">
          <div class="section-heading section-heading--split">
            <div>
              <p class="eyebrow">{copy.topicEyebrow}</p>
              <h2 id="topics-heading">{copy.topicHeading}</h2>
            </div>
            <p>{copy.topicDescription}</p>
          </div>

          <ol class="topic-grid">
            {topics.map((topic, index) => (
              <li>
                <article class:list={['topic-card', index === 0 && 'topic-card--primary']}>
                  <div class="topic-card__number" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </div>

                  <div class="topic-card__content">
                    <h3>
                      <a href={`/${language}/info/topic/${topic.slug}/`}>
                        {topic.title}
                      </a>
                    </h3>
                    <p>{topic.summary}</p>
                  </div>

                  <div class="topic-card__footer">
                    <span>
                      {topic.guideCount}{' '}
                      {topic.guideCount === 1 ? copy.article : copy.articles}
                    </span>
                    <a href={`/${language}/info/topic/${topic.slug}/`}>
                      {copy.openTopic} <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </article>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {(topics.length === 0 || fallbackGuides.length > 0) && (
      <section class="guides-section section-sm" aria-labelledby="guides-heading">
        <div class="container">
          <div class="section-heading section-heading--split">
            <div>
              <p class="eyebrow">
                {topics.length > 0
                  ? copy.fallbackEyebrow
                  : labels.information.officialSource}
              </p>
              <h2 id="guides-heading">
                {topics.length > 0
                  ? copy.fallbackHeading
                  : labels.information.latestHeading}
              </h2>
            </div>
            {topics.length > 0 && <p>{copy.fallbackDescription}</p>}
          </div>

          {guides.length === 0 ? (
            <div class="empty-state surface">
              <h3>{labels.information.emptyHeading}</h3>
              <p>{labels.information.emptyMessage}</p>
            </div>
          ) : (
            <ul class="guide-grid">
              {(topics.length > 0 ? fallbackGuides : guides).map((guide) => (
                <li>
                  <article class="guide-card card">
                    <div class="guide-card__topline">
                      <span class="badge badge-success">
                        {guide.responsibleAgency}
                      </span>

                      {guide.isUrgent && (
                        <span class="badge badge-brand">
                          {labels.information.urgentLabel}
                        </span>
                      )}
                    </div>

                    <div class="guide-card__content">
                      <h3>
                        <a href={`/${language}/info/${guide.slug}/`}>
                          {guide.title}
                        </a>
                      </h3>
                      <p>{guide.summary}</p>
                    </div>

                    <dl class="guide-card__meta">
                      <div>
                        <dt>{labels.information.lastReviewed}</dt>
                        <dd>
                          <time datetime={guide.lastReviewedAt}>
                            {formatDate(guide.lastReviewedAt)}
                          </time>
                        </dd>
                      </div>
                      <div>
                        <dt>{labels.information.nextReview}</dt>
                        <dd>
                          <time datetime={guide.nextReviewAt}>
                            {formatDate(guide.nextReviewAt)}
                          </time>
                        </dd>
                      </div>
                    </dl>

                    <div class="guide-card__actions">
                      <a
                        class="button button-primary"
                        href={`/${language}/info/${guide.slug}/`}
                      >
                        {labels.information.readGuide}
                      </a>
                      <a
                        class="official-link"
                        href={guide.officialSourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {labels.information.officialSource}
                        <span aria-hidden="true">↗</span>
                      </a>
                    </div>
                  </article>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )}
  </main>

  <SiteFooter slot="footer" language={language} />
</BaseLayout>

<style>
  .information-page {
    background: #fff;
  }

  .info-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 88% 20%, rgb(198 42 31 / 0.1), transparent 18rem),
      linear-gradient(135deg, #f5f8fb 0%, #fdfcf9 62%, #fff5f4 100%);
  }

  .info-hero::after {
    content: '';
    position: absolute;
    width: 16rem;
    height: 16rem;
    inset-block-end: -10rem;
    inset-inline-end: 8%;
    border: 1px solid rgb(198 42 31 / 0.13);
    border-radius: 50%;
  }

  .info-hero__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .info-hero h1 {
    max-width: 18ch;
  }

  .info-hero .lead {
    max-width: 48rem;
    margin-block-start: 0.85rem;
  }

  .info-trust-strip {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-muted);
  }

  .trust-notice {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    max-width: 62rem;
  }

  .trust-notice__symbol {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border-radius: 50%;
    background: var(--civic);
    color: #fff;
    font-family: Georgia, serif;
    font-weight: 700;
  }

  .trust-notice h2 {
    font-size: 1rem;
  }

  .trust-notice p {
    margin-block-start: 0.45rem;
    color: var(--text-muted);
  }

  .section-heading {
    margin-block-end: 1.5rem;
    padding-block-end: 1rem;
    border-bottom: 2px solid var(--civic-deep);
  }

  .section-heading--split {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: end;
  }

  .section-heading h2 {
    margin-block-start: 0.5rem;
  }

  .section-heading > p {
    max-width: 42rem;
    color: var(--text-muted);
  }

  .topics-section {
    background: #f3f6f9;
    border-block: 1px solid var(--border);
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border-strong);
    background: var(--border-strong);
    list-style: none;
  }

  .topic-grid > li:only-child {
    grid-column: 1 / -1;
  }

  .topic-grid > li:first-child {
    grid-column: 1 / -1;
  }

  .topic-grid > li:only-child .topic-card {
    min-height: 16rem;
  }

  .topic-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'number content'
      'footer footer';
    gap: 1.25rem;
    min-height: 17rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: #fff;
  }

  .topic-card--primary {
    grid-template-columns: auto minmax(0, 1fr) minmax(12rem, 0.55fr);
    grid-template-areas: 'number content footer';
    align-items: center;
    min-height: 18rem;
    background: var(--civic-deep);
  }

  .topic-card__number {
    grid-area: number;
    color: var(--brand);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .topic-card__content {
    grid-area: content;
  }

  .topic-card h3 {
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    line-height: 1.2;
  }

  .topic-card h3 a {
    color: var(--civic-deep);
    text-decoration: none;
  }

  .topic-card--primary h3 {
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .topic-card--primary h3 a,
  .topic-card--primary .topic-card__footer a {
    color: #fff;
  }

  .topic-card--primary .topic-card__content p,
  .topic-card--primary .topic-card__footer > span {
    color: rgb(255 255 255 / 0.72);
  }

  .topic-card--primary .topic-card__footer {
    align-items: start;
    flex-direction: column;
    justify-content: center;
    margin-block-start: 0;
    padding-block-start: 0;
    padding-inline-start: clamp(1rem, 3vw, 2rem);
    border-block: 0;
    border-inline-start: 1px solid rgb(255 255 255 / 0.2);
  }

  .topic-card h3 a:hover {
    color: var(--brand);
  }

  .topic-card__content p {
    margin-block-start: 0.8rem;
    color: var(--text-muted);
  }

  .topic-card__footer {
    grid-area: footer;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    align-items: end;
    margin-block-start: auto;
    padding-block-start: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .topic-card__footer > span {
    color: var(--text-soft);
    font-size: 0.82rem;
    font-weight: 680;
  }

  .topic-card__footer a {
    color: var(--civic-deep);
    font-weight: 760;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .guide-card__topline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .guide-card__content {
    margin-block-start: 1.25rem;
  }

  .guide-card__content h3 a {
    color: var(--civic-deep);
    text-decoration: none;
  }

  .guide-card__content h3 a:hover {
    color: var(--brand);
  }

  .guide-card__content p {
    margin-block-start: 0.85rem;
    color: var(--text-muted);
  }

  .guide-card__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block: 1.5rem;
    padding-block: 1rem;
    border-block: 1px solid var(--border);
  }

  .guide-card__meta dt {
    color: var(--text-soft);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  html[lang='ne'] .guide-card__meta dt {
    font-size: 0.82rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .guide-card__meta dd {
    margin: 0.25rem 0 0;
    color: var(--civic-deep);
    font-size: 0.9rem;
    font-weight: 650;
  }

  .guide-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: auto;
  }

  .official-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--civic);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .empty-state {
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .empty-state p {
    margin-block-start: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 48rem) {
    .section-heading--split,
    .topic-grid,
    .guide-grid {
      grid-template-columns: 1fr;
    }

    .section-heading--split {
      align-items: start;
      gap: 0.75rem;
    }

    .topic-card {
      min-height: 0;
    }

    .topic-card--primary {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'number content'
        'footer footer';
    }

    .topic-card--primary .topic-card__footer {
      align-items: end;
      flex-direction: row;
      justify-content: space-between;
      margin-block-start: auto;
      padding-block-start: 1.25rem;
      padding-inline-start: 0;
      border-block-start: 1px solid rgb(255 255 255 / 0.2);
      border-inline-start: 0;
    }

    .guide-card__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .official-link {
      min-height: 2.75rem;
      justify-content: center;
    }
  }

  @media (max-width: 30rem) {
    .info-hero__inner {
      padding-block: 2.75rem 3.25rem;
    }

    .topic-card {
      grid-template-columns: 1fr;
      grid-template-areas:
        'number'
        'content'
        'footer';
      gap: 0.75rem;
    }

    .topic-card--primary {
      grid-template-columns: 1fr;
      grid-template-areas:
        'number'
        'content'
        'footer';
    }

    .guide-card__meta {
      grid-template-columns: 1fr;
    }
  }
</style>
