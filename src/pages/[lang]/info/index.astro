---
import {sanityClient} from 'sanity:client'
import SiteFooter from '../../../components/SiteFooter.astro'
import SiteHeader from '../../../components/SiteHeader.astro'
import {getTranslations} from '../../../i18n'
import {getLanguagesWithSection} from '../../../config/languageSections'
import {orderGuidanceHubTopics} from '../../../config/guidanceHub'
import type {SupportedLanguage} from '../../../i18n/config'
import GuidanceTopicIcon from '../../../components/content/GuidanceTopicIcon.astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import {buildGuideSearchText} from '../../../lib/guideSearch'
import {
  ACTIVE_PUBLIC_INFORMATION_GUIDES_QUERY,
  PUBLIC_INFORMATION_TOPICS_BY_LANGUAGE_QUERY,
} from '../../../lib/sanity/queries'

export function getStaticPaths() {
  return getLanguagesWithSection('information').map((language) => ({
    params: {lang: language},
    props: {language},
  }))
}

interface GuideSummary {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  summary: string
  searchKeywords?: string[] | null
  topic: string
  intendedAudience?: string[]
  responsibleAgency: string
  officialSourceUrl: string
  publishedAt: string
  lastReviewedAt: string
  nextReviewAt: string
  isFeatured?: boolean
  isUrgent?: boolean
}

interface TopicSummary {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  topicKey: string
  summary: string
  displayOrder: number
  iconKey?: string
  seoDescription?: string
  guideCount: number
}

const {language} = Astro.props
const labels = getTranslations(language)
const alternateLanguage: SupportedLanguage = language === 'ne' ? 'nb' : 'ne'

const [sanityTopics, guides] = await Promise.all([
  sanityClient.fetch<TopicSummary[]>(
    PUBLIC_INFORMATION_TOPICS_BY_LANGUAGE_QUERY,
    {language},
  ),
  sanityClient.fetch<GuideSummary[]>(ACTIVE_PUBLIC_INFORMATION_GUIDES_QUERY, {
    language,
  }),
])

const topics = orderGuidanceHubTopics(sanityTopics)
const activeTopicKeys = new Set(topics.map((topic) => topic.topicKey))
const fallbackGuides = guides.filter((guide) => !activeTopicKeys.has(guide.topic))
const fallbackGuideIds = new Set(fallbackGuides.map((guide) => guide._id))
const showGuidesSection = topics.length === 0 || guides.length > 0
const guidesVisibleByDefault = topics.length === 0 || fallbackGuides.length > 0
const searchableGuides = guides.map((guide) => ({
  guide,
  searchText: buildGuideSearchText(guide),
  inDefaultView: topics.length === 0 || fallbackGuideIds.has(guide._id),
}))

const formattedCount = (count: number) => new Intl.NumberFormat(language).format(count)
const guideCountLabel = (count: number) =>
  (count === 1
    ? labels.information.topicGuideCount.one
    : labels.information.topicGuideCount.other
  ).replace('{count}', formattedCount(count))

const dateLocale = language === 'ne' ? 'ne-NP' : 'nb-NO'
const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString(dateLocale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })

const copy =
  language === 'ne'
    ? {
        fallbackEyebrow: 'थप उपयोगी जानकारी',
        fallbackHeading: 'अन्य प्रकाशित जानकारी',
        fallbackDescription:
          'विषय पृष्ठमा समावेश हुन बाँकी सक्रिय जानकारी यहाँ उपलब्ध छन्।',
      }
    : {
        fallbackEyebrow: 'Mer nyttig informasjon',
        fallbackHeading: 'Andre publiserte veiledninger',
        fallbackDescription:
          'Aktive veiledninger som ennå ikke tilhører en offentlig temaside, vises her.',
      }
---

<BaseLayout
  language={language}
  title={`${labels.information.pageTitle} | nepali.no`}
  description={labels.information.pageDescription}
>
  <SiteHeader
    slot="header"
    language={language}
    alternatePath={`/${alternateLanguage}/info/`}
  />

  <main class="information-page">
    <header class="info-hero">
      <div class="container info-hero__inner">
        <div class="reading-width info-hero__content">
          <h1>{labels.information.pageTitle}</h1>
          <p class="lead">{labels.information.pageDescription}</p>
        </div>
      </div>
    </header>

    {guides.length > 0 && (
      <section class="info-search" hidden data-guide-search-section>
        <div class="container info-search__inner">
          <form class="info-search__form" role="search" data-guide-search-form>
            <label class="sr-only" for="guide-search-input">{labels.information.searchLabel}</label>
            <div class="info-search__entry">
              <svg class="info-search__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m16 16 4 4"></path>
              </svg>
              <input
                id="guide-search-input"
                type="search"
                name="q"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder={labels.information.searchPlaceholder}
                aria-describedby="guide-search-hint guide-search-status"
                data-guide-search-input
              />
            </div>
            <p id="guide-search-hint" class="sr-only">{labels.information.searchHint}</p>
            <p
              id="guide-search-status" class="sr-only"
              role="status"
              aria-live="polite"
              data-guide-search-status
              data-count-one={labels.information.searchResultCount.one}
              data-count-other={labels.information.searchResultCount.other}
            >
            </p>
          </form>
        </div>
      </section>
    )}

    <section class="info-trust-strip" aria-labelledby="information-disclaimer-title">
      <div class="container">
        <aside class="trust-notice">
          <h2 id="information-disclaimer-title">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 11v6M12 7h.01"></path>
            </svg>
            <span>{labels.information.disclaimerTitle}</span>
          </h2>
          <p>{labels.information.disclaimer}</p>
        </aside>
      </div>
    </section>

    {topics.length > 0 && (
      <section
        class="topics-section section-sm"
        aria-labelledby="topics-heading"
        data-topics-section
      >
        <div class="container">
          <div class="topics-heading">
            <h2 id="topics-heading">{labels.information.topicHeading}</h2>
          </div>

          <ul class="topic-grid">
            {topics.map((topic) => (
              <li data-topic-key={topic.topicKey} data-icon-key={topic.iconKey ?? ''} data-guide-count={topic.guideCount}>
                <a
                  class="topic-card"
                  href={`/${language}/info/topic/${topic.slug}/`}
                  aria-labelledby={`topic-title-${topic._id}`}
                >
                  <div class="topic-card__topline">
                    <GuidanceTopicIcon topicKey={topic.topicKey} />
                    <h3 id={`topic-title-${topic._id}`} class="topic-card__title">
                        {topic.title}
                    </h3>
                    <span class="topic-card__arrow" aria-hidden="true">→</span>
                  </div>
                  <p class="topic-card__summary">{topic.summary}</p>
                  <div class="topic-card__metadata">
                    <span class="topic-card__count">{guideCountLabel(topic.guideCount)}</span>
                    {topic.guideCount === 0 && (
                      <span class="topic-card__empty">{labels.information.noPublishedTopicGuides}</span>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {showGuidesSection && (
      <section
        class="guides-section section-sm"
        aria-labelledby="guides-heading"
        hidden={!guidesVisibleByDefault}
        data-guides-section
        data-visible-by-default={guidesVisibleByDefault ? 'true' : 'false'}
      >
        <div class="container">
          <div class="section-heading section-heading--split">
            <div>
              <p class="eyebrow" data-guides-eyebrow>
                {topics.length > 0
                  ? copy.fallbackEyebrow
                  : labels.information.officialSource}
              </p>
              <h2
                id="guides-heading"
                data-default-heading={topics.length > 0
                  ? copy.fallbackHeading
                  : labels.information.latestHeading}
                data-search-heading={labels.information.searchResultsHeading}
              >
                {topics.length > 0
                  ? copy.fallbackHeading
                  : labels.information.latestHeading}
              </h2>
            </div>
            {topics.length > 0 && <p data-guides-description>{copy.fallbackDescription}</p>}
          </div>

          {guides.length === 0 ? (
            <div class="empty-state surface">
              <h3>{labels.information.emptyHeading}</h3>
              <p>{labels.information.emptyMessage}</p>
            </div>
          ) : (
            <ul class="guide-grid">
              {searchableGuides.map(({guide, searchText, inDefaultView}) => (
                <li
                  hidden={!inDefaultView}
                  data-guide-item
                  data-default-visible={inDefaultView ? 'true' : 'false'}
                  data-search-text={searchText}
                >
                  <article class="guide-card card">
                    <div class="guide-card__topline">
                      <span class="badge badge-success">
                        {guide.responsibleAgency}
                      </span>

                      {guide.isUrgent && (
                        <span class="badge badge-brand">
                          {labels.information.urgentLabel}
                        </span>
                      )}
                    </div>

                    <div class="guide-card__content">
                      <h3>
                        <a href={`/${language}/info/${guide.slug}/`}>
                          {guide.title}
                        </a>
                      </h3>
                      <p>{guide.summary}</p>
                    </div>

                    <dl class="guide-card__meta">
                      <div>
                        <dt>{labels.information.lastReviewed}</dt>
                        <dd>
                          <time datetime={guide.lastReviewedAt}>
                            {formatDate(guide.lastReviewedAt)}
                          </time>
                        </dd>
                      </div>
                      <div>
                        <dt>{labels.information.nextReview}</dt>
                        <dd>
                          <time datetime={guide.nextReviewAt}>
                            {formatDate(guide.nextReviewAt)}
                          </time>
                        </dd>
                      </div>
                    </dl>

                    <div class="guide-card__actions">
                      <a
                        class="button button-primary"
                        href={`/${language}/info/${guide.slug}/`}
                      >
                        {labels.information.readGuide}
                      </a>
                      <a
                        class="official-link"
                        href={guide.officialSourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {labels.information.officialSource}
                        <span aria-hidden="true">↗</span>
                      </a>
                    </div>
                  </article>
                </li>
              ))}
            </ul>
          )}

          {guides.length > 0 && (
            <div class="empty-state surface" hidden data-guide-search-empty>
              <h3>{labels.information.searchNoResultsHeading}</h3>
              <p>{labels.information.searchNoResultsMessage}</p>
            </div>
          )}
        </div>
      </section>
    )}
  </main>

  <SiteFooter slot="footer" language={language} />
</BaseLayout>

<style>
  .information-page {
    background: var(--surface);
  }

  .info-hero {
    border-block-end: 1px solid var(--border);
    background: linear-gradient(125deg, var(--surface-muted), var(--surface-warm) 58%, var(--color-brand-50));
  }

  .info-hero__inner {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }

  .info-hero h1 {
    max-width: 18ch;
  }

  .info-hero .lead {
    max-width: 48rem;
    margin-block-start: 0.5rem;
  }

  .info-trust-strip {
    padding-block: 0.75rem 0;
  }

  .trust-notice {
    max-width: 66rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
  }

  .trust-notice h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .trust-notice h2 svg {
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    color: var(--civic-deep);
  }

  .trust-notice p {
    margin-block-start: 0.2rem;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .topics-section {
    padding-block: 1.5rem 3rem;
  }

  .topics-heading {
    margin-block-end: 1rem;
  }

  .topics-heading h2 {
    font-size: clamp(1.2rem, 3vw, 1.5rem);
  }

  .topic-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topic-grid > li {
    min-width: 0;
  }

  .topic-card {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    min-height: 44px;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .topic-card__topline {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.6rem;
  }

  .topic-card__topline :global(svg) {
    width: 22px;
    height: 22px;
    color: var(--civic-deep);
  }

  .topic-card__title {
    min-width: 0;
    color: var(--civic-deep);
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .topic-card__arrow {
    color: var(--brand);
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .topic-card__summary {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .topic-card__metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    color: var(--text-soft);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .topic-card__count {
    font-weight: 600;
  }

  .topic-card__empty {
    color: var(--text-muted);
  }

  .topic-card:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .topic-card:hover .topic-card__title {
    text-decoration: underline;
    text-decoration-color: var(--brand);
    text-underline-offset: 0.15em;
  }

  .topic-card:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .info-search {
    padding-block: 1rem 0.75rem;
  }

  .info-search__form {
    display: grid;
    max-width: 48rem;
    gap: 0.5rem;
  }

  .info-search__entry {
    position: relative;
    min-width: 0;
  }

  .info-search__icon {
    position: absolute;
    inset-inline-start: 1.25rem;
    top: 50%;
    width: 1.375rem;
    height: 1.375rem;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  .info-search__form input {
    display: block;
    width: 100%;
    min-width: 0;
    height: 3.625rem;
    padding: 0 1.5rem 0 3.25rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background: #fff;
    box-shadow: 0 2px 6px rgb(15 23 42 / 7%);
    color: var(--civic-deep);
    font: inherit;
    text-overflow: ellipsis;
  }

  .info-search__form input:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .info-search__form input::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }

  .info-search__status {
    min-height: 1.4em;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .guide-card__topline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .guide-card__content {
    margin-block-start: 1.25rem;
  }

  .guide-card__content h3 a {
    color: var(--civic-deep);
    text-decoration: none;
  }

  .guide-card__content h3 a:hover {
    color: var(--brand);
  }

  .guide-card__content p {
    margin-block-start: 0.85rem;
    color: var(--text-muted);
  }

  .guide-card__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block: 1.5rem;
    padding-block: 1rem;
    border-block: 1px solid var(--border);
  }

  .guide-card__meta dt {
    color: var(--text-soft);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  html[lang='ne'] .guide-card__meta dt {
    font-size: 0.82rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .guide-card__meta dd {
    margin: 0.25rem 0 0;
    color: var(--civic-deep);
    font-size: 0.9rem;
    font-weight: 650;
  }

  .guide-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: auto;
  }

  .official-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--civic);
    font-size: 0.875rem;
    font-weight: 700;
  }

  [data-guide-search-section][hidden],
  [data-topics-section][hidden],
  [data-guides-section][hidden],
  [data-guide-item][hidden],
  [data-guide-search-empty][hidden],
  [data-guides-eyebrow][hidden],
  [data-guides-description][hidden] {
    display: none !important;
  }

  .empty-state {
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .empty-state p {
    margin-block-start: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 48rem) {
    .guide-grid {
      grid-template-columns: 1fr;
    }

    .guide-card__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .official-link {
      min-height: 2.75rem;
      justify-content: center;
    }
  }

  @media (min-width: 44rem) {
    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .info-search__form input {
      height: 3.875rem;
    }
  }

  @media (min-width: 68rem) {
    .topic-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .guide-card__meta {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import {matchesGuideSearch} from '../../../lib/guideSearch'

  const searchSection = document.querySelector<HTMLElement>('[data-guide-search-section]')
  const form = document.querySelector<HTMLFormElement>('[data-guide-search-form]')
  const input = document.querySelector<HTMLInputElement>('[data-guide-search-input]')
  const status = document.querySelector<HTMLElement>('[data-guide-search-status]')
  const topicsSection = document.querySelector<HTMLElement>('[data-topics-section]')
  const guidesSection = document.querySelector<HTMLElement>('[data-guides-section]')
  const heading = guidesSection?.querySelector<HTMLElement>('#guides-heading')
  const eyebrow = guidesSection?.querySelector<HTMLElement>('[data-guides-eyebrow]')
  const description = guidesSection?.querySelector<HTMLElement>('[data-guides-description]')
  const emptyState = document.querySelector<HTMLElement>('[data-guide-search-empty]')
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-guide-item]'))

  if (searchSection && form && input && status && guidesSection && heading) {
    const guidesVisibleByDefault = guidesSection.dataset.visibleByDefault === 'true'

    const update = () => {
      const query = input.value
      const searching = query.trim().length > 0
      let matches = 0

      for (const item of items) {
        const visible = searching
          ? matchesGuideSearch(item.dataset.searchText ?? '', query)
          : item.dataset.defaultVisible === 'true'
        item.hidden = !visible
        if (searching && visible) matches += 1
      }

      topicsSection && (topicsSection.hidden = searching)
      guidesSection.hidden = searching ? false : !guidesVisibleByDefault
      heading.textContent =
        (searching ? heading.dataset.searchHeading : heading.dataset.defaultHeading) ?? ''
      eyebrow && (eyebrow.hidden = searching)
      description && (description.hidden = searching)
      emptyState && (emptyState.hidden = !(searching && matches === 0))

      const template = matches === 1 ? status.dataset.countOne : status.dataset.countOther
      status.textContent = searching && template ? template.replace('{count}', String(matches)) : ''
    }

    searchSection.hidden = false
    form.addEventListener('submit', (event) => event.preventDefault())
    input.addEventListener('input', update)
    update()
  }
</script>
