---
import NewsHubPage from '../../../components/news/NewsHubPage.astro'
import {isSupportedLanguage} from '../../../i18n/config'
import {newsPageUrl, parseNewsCategory} from '../../../lib/newsHub'
import {loadNewsHub} from '../../../lib/sanity/loadNewsHub'

export const prerender = false
const language = Astro.params.lang
if (!isSupportedLanguage(language)) return new Response(null, {status: 404})
if (Astro.url.searchParams.has('category') && !parseNewsCategory(Astro.url.searchParams.get('category'))) {
  return Astro.redirect(newsPageUrl(language), 302)
}
const data = await loadNewsHub(language, 1, Astro.url)
---
<NewsHubPage language={language} page={1} data={data} />
