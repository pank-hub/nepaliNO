---
import {sanityClient} from 'sanity:client'
import SiteFooter from '../../../components/SiteFooter.astro'
import SiteHeader from '../../../components/SiteHeader.astro'
import {getTranslations} from '../../../i18n'
import {
  supportedLanguages,
  type SupportedLanguage,
} from '../../../i18n/config'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import {urlFor} from '../../../lib/sanity/image'
import {
  NEWS_ARCHIVE_USEFUL_GUIDES_QUERY,
  NEWS_ARCHIVE_PAGE_BY_LANGUAGE_QUERY,
  NEWS_ARCHIVE_FEATURED_ARTICLES_BY_LANGUAGE_QUERY,
  NEWS_ARTICLE_COUNT_BY_LANGUAGE_QUERY,
} from '../../../lib/sanity/queries'

export function getStaticPaths() {
  return supportedLanguages.map((language) => ({
    params: {lang: language},
    props: {language},
  }))
}

interface ArchiveImage {
  asset?: unknown
  alt?: string
  caption?: string
  credit?: string
  hotspot?: unknown
  crop?: unknown
}

interface ArchiveArticle {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  summary: string
  newsRegion: string
  category: string
  featuredImage?: ArchiveImage
  authorName?: string
  publishedAt: string
  isFeatured?: boolean
}

interface UsefulGuide {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  summary: string
  topic: string
  responsibleAgency: string
  isFeatured?: boolean
  isUrgent?: boolean
}

interface ArchiveLink {
  _id: string
  title: string
  slug: string
  featuredImage?: ArchiveImage
  publishedAt: string
}

const {language} = Astro.props
const labels = getTranslations(language)
const alternateLanguage: SupportedLanguage = language === 'ne' ? 'nb' : 'ne'

const [articles, articleCount, usefulGuides, archiveLinks] = await Promise.all([
  sanityClient.fetch<ArchiveArticle[]>(NEWS_ARCHIVE_FEATURED_ARTICLES_BY_LANGUAGE_QUERY, {
    language,
  }),
  sanityClient.fetch<number>(NEWS_ARTICLE_COUNT_BY_LANGUAGE_QUERY, {language}),
  sanityClient.fetch<UsefulGuide[]>(NEWS_ARCHIVE_USEFUL_GUIDES_QUERY, {
    language,
  }),
  sanityClient.fetch<ArchiveLink[]>(NEWS_ARCHIVE_PAGE_BY_LANGUAGE_QUERY, {
    language,
    start: 9,
    end: 12,
  }),
])

const dateLocale = language === 'ne' ? 'ne-NP' : 'nb-NO'
const formatDate = (date: string) =>
  new Date(date).toLocaleDateString(dateLocale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })

const newsLabels = labels.news
const regionLabels = newsLabels.regions as Record<string, string>
const categoryLabels = newsLabels.categories as Record<string, string>
const getRegionLabel = (value: string) => regionLabels[value] ?? value
const getCategoryLabel = (value: string) => categoryLabels[value] ?? value
const imageUrl = (image?: ArchiveImage, width = 1200) =>
  image?.asset
    ? urlFor(image as any).width(width).fit('crop').auto('format').url()
    : null

const featuredArticle =
  articles.find((article) => article.isFeatured) ?? articles[0] ?? null
const latestArticles = featuredArticle
  ? articles.filter((article) => article._id !== featuredArticle._id)
  : articles
const supportingArticles = latestArticles.slice(0, 2)
const cardArticles = latestArticles.slice(2)

const usefulInformationTitle = newsLabels.usefulInformation
const usefulInformationDescription = newsLabels.usefulInformationDescription
const readGuideLabel = newsLabels.readGuide
---

<BaseLayout
  language={language}
  title={`${labels.news.pageTitle} | nepali.no`}
  description={labels.news.pageDescription}
>
  <SiteHeader
    slot="header"
    language={language}
    alternatePath={`/${alternateLanguage}/news/`}
  />

  <header class="news-hero">
    <div class="container news-hero__inner">
      <h1>{labels.news.pageTitle}</h1>
      <p class="lead">{labels.news.pageDescription}</p>
    </div>
  </header>

  <main class="news-archive">
    <section class="section" aria-labelledby="latest-news-heading">
      <div class="container">
        <div class="archive-heading">
          <h2 id="latest-news-heading">{labels.news.latestHeading}</h2>
          {articleCount > articles.length && (
            <a class="archive-heading__link" href={`/${language}/news/page/2/`}>
              {newsLabels.browseArchive} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>

          {articles.length === 0 ? (
            <div class="empty-state">
              <span aria-hidden="true"></span>
              <h3>{labels.news.emptyHeading}</h3>
              <p>{labels.news.emptyMessage}</p>
            </div>
          ) : (
            <>
              {featuredArticle && (
                <article class="archive-lead">
                  <div class="archive-lead__content">
                    <p class="story-kicker">
                      {featuredArticle.isFeatured && <>{labels.home.featuredStory} · </>}
                      {getRegionLabel(featuredArticle.newsRegion)} · {getCategoryLabel(featuredArticle.category)}
                    </p>
                    <h3><a href={`/${language}/news/${featuredArticle.slug}/`}>{featuredArticle.title}</a></h3>
                    <p class="archive-lead__summary">{featuredArticle.summary}</p>
                    <div class="story-meta">
                      <time datetime={featuredArticle.publishedAt}>{formatDate(featuredArticle.publishedAt)}</time>
                      {featuredArticle.authorName && <span>{featuredArticle.authorName}</span>}
                    </div>
                    <a class="story-link" href={`/${language}/news/${featuredArticle.slug}/`}>
                      {labels.news.readMore} <span aria-hidden="true">→</span>
                    </a>
                  </div>
                  {imageUrl(featuredArticle.featuredImage) ? (
                    <a class="archive-lead__image" href={`/${language}/news/${featuredArticle.slug}/`} tabindex="-1" aria-hidden="true">
                      <img src={imageUrl(featuredArticle.featuredImage) ?? ''} alt="" width="1200" height="800" loading="eager" decoding="async" />
                    </a>
                  ) : (
                    <div class="archive-lead__placeholder" aria-hidden="true"></div>
                  )}
                </article>
              )}

              {supportingArticles.length > 0 && (
                <section class="archive-supporting" aria-labelledby="more-news-heading">
                  <h3 id="more-news-heading">{newsLabels.moreNews}</h3>
                  <ol>
                    {supportingArticles.map((article) => (
                      <li>
                        <article class="archive-supporting-card">
                          {imageUrl(article.featuredImage, 760) ? (
                            <a class="archive-supporting-card__image" href={`/${language}/news/${article.slug}/`} tabindex="-1" aria-hidden="true">
                              <img src={imageUrl(article.featuredImage, 760) ?? ''} alt="" width="760" height="475" loading="lazy" decoding="async" />
                            </a>
                          ) : (
                            <div class="archive-supporting-card__placeholder" aria-hidden="true"></div>
                          )}
                          <div class="archive-supporting-card__content">
                            <p class="story-kicker">{getRegionLabel(article.newsRegion)} · {getCategoryLabel(article.category)}</p>
                            <h4><a href={`/${language}/news/${article.slug}/`}>{article.title}</a></h4>
                            <p>{article.summary}</p>
                            <div class="story-meta"><time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time></div>
                          </div>
                        </article>
                      </li>
                    ))}
                  </ol>
                </section>
              )}

              {usefulGuides.length > 0 && (
                <section class="useful-information" aria-labelledby="useful-information-heading">
                  <div class="useful-information__heading">
                    <div>
                      <p class="eyebrow">{labels.navigation.information}</p>
                      <h2 id="useful-information-heading">{usefulInformationTitle}</h2>
                    </div>
                    <div class="useful-information__introduction">
                      <p>{usefulInformationDescription}</p>
                      <a href={`/${language}/info/`}>{labels.navigation.information} <span aria-hidden="true">→</span></a>
                    </div>
                  </div>

                  <ol class="guide-links">
                    {usefulGuides.map((guide) => (
                      <li>
                        <article class="guide-link">
                          <div class="guide-link__agency">
                            <span>{guide.responsibleAgency}</span>
                            {guide.isUrgent && <strong>{labels.information.urgentLabel}</strong>}
                          </div>

                          <div class="guide-link__content">
                            <h3>
                              <a href={`/${language}/info/${guide.slug}/`}>{guide.title}</a>
                            </h3>
                            <p>{guide.summary}</p>
                          </div>

                          <a class="guide-link__action" href={`/${language}/info/${guide.slug}/`} aria-label={`${readGuideLabel}: ${guide.title}`}>
                            <span>{readGuideLabel}</span>
                            <span aria-hidden="true">→</span>
                          </a>
                        </article>
                      </li>
                    ))}
                  </ol>
                </section>
              )}

              {cardArticles.length > 0 && (
                <section class="archive-card-section" aria-label={newsLabels.moreNews}>
                  <ol class="archive-card-grid">
                    {cardArticles.map((article) => (
                      <li>
                        <article class="archive-card">
                          {imageUrl(article.featuredImage, 620) ? (
                            <a class="archive-card__image" href={`/${language}/news/${article.slug}/`} tabindex="-1" aria-hidden="true">
                              <img src={imageUrl(article.featuredImage, 620) ?? ''} alt="" width="620" height="390" loading="lazy" decoding="async" />
                            </a>
                          ) : (
                            <div class="archive-card__placeholder" aria-hidden="true"></div>
                          )}
                          <div class="archive-card__content">
                            <p class="story-kicker">{getRegionLabel(article.newsRegion)} · {getCategoryLabel(article.category)}</p>
                            <h4><a href={`/${language}/news/${article.slug}/`}>{article.title}</a></h4>
                            <p>{article.summary}</p>
                            <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
                          </div>
                        </article>
                      </li>
                    ))}
                  </ol>
                </section>
              )}

              {articleCount > articles.length && (
                archiveLinks.length > 0 && (
                  <section class="archive-bottom-links" aria-labelledby="archive-bottom-links-heading">
                    <h3 id="archive-bottom-links-heading">{newsLabels.moreNews}</h3>
                    <ol>
                      {archiveLinks.map((article) => (
                        <li>
                          <a href={`/${language}/news/${article.slug}/`}>
                            {imageUrl(article.featuredImage, 420) && (
                              <img
                                src={imageUrl(article.featuredImage, 420) ?? ''}
                                alt=""
                                width="420"
                                height="263"
                                loading="lazy"
                                decoding="async"
                              />
                            )}
                            <span>{article.title}</span>
                          </a>
                        </li>
                      ))}
                    </ol>
                    <a class="archive-bottom-links__archive" href={`/${language}/news/page/2/`}>
                      <span>{newsLabels.viewOlderNews}</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </section>
                )
              )}
            </>
          )}
      </div>
    </section>
  </main>

  <SiteFooter slot="footer" language={language} flush />
</BaseLayout>

<style>
  .news-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 85% 10%, rgb(198 42 31 / 0.1), transparent 20rem),
      linear-gradient(135deg, #f5f8fb 0%, #fdfcf9 62%, #fff6f5 100%);
  }

  .news-hero::after {
    content: '';
    position: absolute;
    width: 18rem;
    height: 18rem;
    inset-block-end: -12rem;
    inset-inline-end: 7%;
    border: 1px solid rgb(198 42 31 / 0.13);
    border-radius: 50%;
  }

  .news-hero__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.25rem, 5vw, 4rem);
  }

  .news-hero h1 {
    margin-block-start: 0.55rem;
  }

  .news-hero .lead {
    max-width: 45rem;
    margin-block-start: 1rem;
  }

  .news-archive {
    background: #ffffff;
  }

  .archive-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-block-end: 1.5rem;
    padding-block-end: 1rem;
    border-bottom: 2px solid var(--civic-deep);
  }

  .archive-heading__link {
    color: var(--civic-deep);
    font-size: 0.86rem;
    font-weight: 750;
    text-decoration: none;
  }

  .archive-heading__link:hover {
    color: var(--brand);
  }

  .archive-lead {
    display: grid;
    grid-template-columns: minmax(18rem, 0.82fr) minmax(0, 1.3fr);
    grid-template-areas: 'content image';
    min-height: 29rem;
    border-bottom: 1px solid var(--border-strong);
  }

  .archive-lead__content {
    grid-area: content;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.75rem, 4vw, 3.25rem);
    background: var(--surface-warm);
  }

  .story-kicker {
    color: var(--brand);
    font-size: 0.76rem;
    font-weight: 780;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  html[lang='ne'] .story-kicker {
    font-size: 0.86rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .archive-lead h3 {
    margin-block-start: 0.7rem;
    font-size: clamp(2rem, 4.3vw, 3.75rem);
    line-height: 1.12;
  }

  .archive-lead h3 a,
  .archive-row h4 a {
    color: var(--civic-deep);
    text-decoration: none;
  }

  .archive-lead h3 a:hover,
  .archive-row h4 a:hover {
    color: var(--brand);
  }

  .archive-lead__summary {
    margin-block-start: 1rem;
    color: var(--text-muted);
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-block-start: 1rem;
    color: var(--text-soft);
    font-size: 0.84rem;
  }

  .story-meta span::before {
    content: '•';
    margin-inline-end: 1rem;
  }

  .story-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    margin-block-start: 1.4rem;
    color: var(--civic-deep);
    font-weight: 760;
  }

  .archive-lead__image,
  .archive-lead__placeholder {
    grid-area: image;
    display: block;
    overflow: hidden;
    background: linear-gradient(135deg, var(--civic), var(--civic-deep));
  }

  .archive-lead__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .archive-lead__image:hover img {
    transform: scale(1.015);
  }

  .archive-supporting,
  .archive-card-section {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
  }

  .archive-supporting > h3 {
    padding-block-end: 0.8rem;
    border-bottom: 0.25rem solid var(--brand);
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  html[lang='ne'] .archive-supporting > h3 {
    font-size: 1.1rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .archive-supporting ol,
  .archive-card-grid {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .archive-supporting ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    padding-block-start: 1.25rem;
  }

  .archive-supporting-card,
  .archive-card {
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }

  .archive-supporting-card__image,
  .archive-supporting-card__placeholder,
  .archive-card__image,
  .archive-card__placeholder {
    display: block;
    overflow: hidden;
    aspect-ratio: 8 / 5;
    background: linear-gradient(135deg, var(--civic), var(--civic-deep));
  }

  .archive-supporting-card__image img,
  .archive-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
  }

  .archive-supporting-card__image:hover img,
  .archive-card__image:hover img {
    transform: scale(1.015);
  }

  .archive-supporting-card__content,
  .archive-card__content {
    padding: 1.2rem;
  }

  .archive-supporting-card h4,
  .archive-card h4 {
    margin-block-start: 0.45rem;
    line-height: 1.25;
  }

  .archive-supporting-card h4 { font-size: clamp(1.35rem, 2.6vw, 1.85rem); }
  .archive-card h4 { font-size: clamp(1.15rem, 2vw, 1.45rem); }

  .archive-supporting-card h4 a,
  .archive-card h4 a {
    color: var(--civic-deep);
    text-decoration: none;
  }

  .archive-supporting-card h4 a:hover,
  .archive-card h4 a:hover {
    color: var(--brand);
  }

  .archive-supporting-card__content > p:not(.story-kicker),
  .archive-card__content > p:not(.story-kicker) {
    display: -webkit-box;
    overflow: hidden;
    margin-block-start: 0.7rem;
    color: var(--text-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .archive-supporting-card time,
  .archive-card time {
    color: var(--text-soft);
    font-size: 0.84rem;
  }

  .archive-card time { display: block; margin-block-start: 0.9rem; }

  .archive-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .empty-state {
    padding: clamp(2.25rem, 7vw, 5rem);
    border-block: 1px solid var(--border-strong);
    text-align: center;
  }

  .empty-state > span {
    display: block;
    width: 3rem;
    height: 0.2rem;
    margin-inline: auto;
    margin-block-end: 1rem;
    background: var(--brand);
  }

  .empty-state p {
    margin-block-start: 0.65rem;
    color: var(--text-muted);
  }

  .useful-information {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--border);
    border-inline-start: 0.3rem solid var(--brand);
    background: var(--surface-muted);
  }

  .useful-information__heading {
    display: grid;
    grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: end;
    margin-block-end: 1.25rem;
    padding-block-end: 1rem;
    border-bottom: 2px solid var(--civic-deep);
  }

  .useful-information__heading h2 {
    margin-block-start: 0.45rem;
  }

  .useful-information__heading > p {
    max-width: 38rem;
    color: var(--text-muted);
  }

  .useful-information__introduction {
    display: grid;
    gap: 0.8rem;
    max-width: 38rem;
    color: var(--text-muted);
  }

  .useful-information__introduction a {
    color: var(--civic-deep);
    font-weight: 750;
  }

  .guide-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-links > li {
    border-bottom: 1px solid var(--border-strong);
  }

  .guide-link {
    display: grid;
    grid-template-columns: minmax(8rem, 0.4fr) minmax(0, 1.5fr) minmax(11rem, 0.6fr);
    gap: clamp(1rem, 4vw, 3rem);
    align-items: center;
    padding-block: 1.25rem;
  }

  .guide-link__agency {
    display: grid;
    gap: 0.4rem;
    color: var(--brand);
    font-size: 0.78rem;
    font-weight: 780;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  html[lang='ne'] .guide-link__agency {
    font-size: 0.88rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .guide-link__agency strong {
    width: fit-content;
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    background: #fff0ee;
    font-size: 0.68rem;
  }

  .guide-link__content h3 {
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
    line-height: 1.25;
  }

  .guide-link__content h3 a {
    color: var(--civic-deep);
    text-decoration: none;
  }

  .guide-link__content h3 a:hover {
    color: var(--brand);
  }

  .guide-link__content p {
    margin-block-start: 0.45rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .guide-link__action {
    display: inline-flex;
    align-items: center;
    justify-content: end;
    gap: 0.45rem;
    color: var(--civic-deep);
    font-weight: 750;
    text-align: end;
    text-decoration: none;
  }

  .archive-bottom-links {
    position: relative;
    z-index: 0;
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
  }

  .archive-bottom-links::before {
    position: absolute;
    z-index: -1;
    inset: 0 calc(50% - 50vw);
    background: var(--surface-muted);
    content: '';
  }

  .archive-bottom-links h3 {
    margin-block-end: 1.4rem;
    padding-block-end: 0.8rem;
    border-bottom: 2px solid var(--civic-deep);
    color: var(--text-soft);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  html[lang='ne'] .archive-bottom-links h3 {
    font-size: 0.9rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .archive-bottom-links ol {
    counter-reset: archive-links;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .archive-bottom-links li {
    counter-increment: archive-links;
    position: relative;
    padding-block-start: 2.3rem;
    border-top: 1px solid var(--border);
  }

  .archive-bottom-links li::before {
    position: absolute;
    inset-block-start: 0.85rem;
    inset-inline-start: 0;
    display: block;
    color: var(--brand);
    content: '0' counter(archive-links);
    font-size: 0.74rem;
    font-weight: 780;
    letter-spacing: 0.06em;
  }

  .archive-bottom-links a {
    display: grid;
    gap: 0.7rem;
    color: var(--civic-deep);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }

  .archive-bottom-links img {
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
  }

  .archive-bottom-links a:hover {
    color: var(--brand);
  }

  .archive-bottom-links__archive {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    margin-block-start: 2rem;
    padding: 1.1rem 1.25rem;
    background: var(--civic-deep);
    color: #fff !important;
    font-size: clamp(1.05rem, 2vw, 1.3rem) !important;
    font-weight: 780 !important;
  }

