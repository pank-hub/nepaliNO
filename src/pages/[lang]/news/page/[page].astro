---
import NewsHubPage from '../../../../components/news/NewsHubPage.astro'
import {isSupportedLanguage} from '../../../../i18n/config'
import {newsPageUrl, parseNewsCategory} from '../../../../lib/newsHub'
import {loadNewsHub} from '../../../../lib/sanity/loadNewsHub'

export const prerender = false
const language = Astro.params.lang
if (!isSupportedLanguage(language)) return new Response(null, {status: 404})
const pageValue = Astro.params.page ?? ''
if (!/^[1-9]\d*$/.test(pageValue)) return new Response(null, {status: 404})
const page = Number(pageValue)
if (!Number.isSafeInteger(page)) return new Response(null, {status: 404})
const category = parseNewsCategory(Astro.url.searchParams.get('category'))
if (Astro.url.searchParams.has('category') && !category) {
  return Astro.redirect(newsPageUrl(language), 302)
}
if (page === 1) return Astro.redirect(newsPageUrl(language, 1, category), 301)
const data = await loadNewsHub(language, page, Astro.url)
if (page > data.total) return new Response(null, {status: 404})
---
<NewsHubPage language={language} page={page} data={data} />
