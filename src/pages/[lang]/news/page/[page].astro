---
import {sanityClient} from 'sanity:client'
import SiteFooter from '../../../../components/SiteFooter.astro'
import SiteHeader from '../../../../components/SiteHeader.astro'
import {getTranslations} from '../../../../i18n'
import {supportedLanguages, type SupportedLanguage} from '../../../../i18n/config'
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import {urlFor} from '../../../../lib/sanity/image'
import {
  NEWS_ARCHIVE_PAGE_BY_LANGUAGE_QUERY,
  NEWS_ARTICLE_COUNT_BY_LANGUAGE_QUERY,
} from '../../../../lib/sanity/queries'

const CURATED_ARTICLE_COUNT = 9
const ARCHIVE_PAGE_SIZE = 12

export async function getStaticPaths() {
  const curatedArticleCount = 9
  const archivePageSize = 12
  const counts = await Promise.all(
    supportedLanguages.map(async (language) => ({
      language,
      count: await sanityClient.fetch<number>(
        NEWS_ARTICLE_COUNT_BY_LANGUAGE_QUERY,
        {language},
      ),
    })),
  )

  return counts.flatMap(({language, count}) => {
    const archivePageCount = Math.ceil(
      Math.max(count - curatedArticleCount, 0) / archivePageSize,
    )

    return Array.from({length: archivePageCount}, (_, index) => {
      const currentPage = index + 2

      return {
        params: {lang: language, page: String(currentPage)},
        props: {
          language,
          currentPage,
          totalPages: archivePageCount + 1,
        },
      }
    })
  })
}

interface ArchiveImage {
  asset?: unknown
  alt?: string
  hotspot?: unknown
  crop?: unknown
}

interface ArchiveArticle {
  _id: string
  title: string
  slug: string
  summary: string
  newsRegion: string
  category: string
  featuredImage?: ArchiveImage
  publishedAt: string
}

const {language, currentPage, totalPages} = Astro.props as {
  language: SupportedLanguage
  currentPage: number
  totalPages: number
}
const labels = getTranslations(language)
const newsLabels = labels.news
const alternateLanguage: SupportedLanguage = language === 'ne' ? 'nb' : 'ne'
const start = CURATED_ARTICLE_COUNT + (currentPage - 2) * ARCHIVE_PAGE_SIZE
const articles = await sanityClient.fetch<ArchiveArticle[]>(
  NEWS_ARCHIVE_PAGE_BY_LANGUAGE_QUERY,
  {language, start, end: start + ARCHIVE_PAGE_SIZE},
)
const dateLocale = language === 'ne' ? 'ne-NP' : 'nb-NO'
const regionLabels = newsLabels.regions as Record<string, string>
const categoryLabels = newsLabels.categories as Record<string, string>
const formatDate = (date: string) =>
  new Date(date).toLocaleDateString(dateLocale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
const imageUrl = (image?: ArchiveImage) =>
  image?.asset
    ? urlFor(image as any).width(320).height(200).fit('crop').auto('format').url()
    : null
const pageUrl = (page: number) =>
  page === 1 ? `/${language}/news/` : `/${language}/news/page/${page}/`
---

<BaseLayout
  language={language}
  title={`${newsLabels.olderNews} — ${newsLabels.pageLabel(currentPage)} | nepali.no`}
  description={newsLabels.archiveDescription}
>
  <SiteHeader
    slot="header"
    language={language}
    alternatePath={`/${alternateLanguage}/news/page/${currentPage}/`}
  />

  <header class="archive-hero">
    <div class="container">
      <p class="archive-hero__back"><a href={`/${language}/news/`}>{labels.news.pageTitle}</a></p>
      <h1>{newsLabels.olderNews}</h1>
      <p class="lead">{newsLabels.archiveDescription}</p>
    </div>
  </header>

  <section class="section" aria-labelledby="archive-heading">
    <div class="container">
      <div class="archive-heading">
        <h2 id="archive-heading">{newsLabels.pageLabel(currentPage)}</h2>
      </div>

      <ol class="archive-list">
        {articles.map((article) => (
          <li>
            <article>
              {imageUrl(article.featuredImage) && (
                <a class="archive-list__image" href={`/${language}/news/${article.slug}/`} tabindex="-1" aria-hidden="true">
                  <img src={imageUrl(article.featuredImage) ?? ''} alt="" width="320" height="200" loading="lazy" decoding="async" />
                </a>
              )}
              <div class="archive-list__content">
                <p class="story-kicker">
                  {regionLabels[article.newsRegion] ?? article.newsRegion} · {categoryLabels[article.category] ?? article.category}
                </p>
                <h3><a href={`/${language}/news/${article.slug}/`}>{article.title}</a></h3>
                <p>{article.summary}</p>
              </div>
              <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
            </article>
          </li>
        ))}
      </ol>

      <nav class="pagination" aria-label={newsLabels.olderNews}>
        {currentPage > 2 ? (
          <a href={pageUrl(currentPage - 1)}>← {newsLabels.previousPage}</a>
        ) : (
          <a href={pageUrl(1)}>← {newsLabels.previousPage}</a>
        )}
        <ol>
          {Array.from({length: totalPages}, (_, index) => index + 1).map((page) => (
            <li>
              <a href={pageUrl(page)} aria-current={page === currentPage ? 'page' : undefined}>
                {newsLabels.pageLabel(page)}
              </a>
            </li>
          ))}
        </ol>
        {currentPage < totalPages && (
          <a href={pageUrl(currentPage + 1)}>{newsLabels.nextPage} →</a>
        )}
      </nav>
    </div>
  </section>

  <SiteFooter slot="footer" language={language} />
</BaseLayout>

<style>
  .archive-hero { border-bottom: 1px solid var(--border); background: var(--surface-muted); }
  .archive-hero .container { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .archive-hero__back { margin-block-end: .65rem; font-size: .9rem; font-weight: 700; }
  .archive-hero__back a { color: var(--brand); }
  .archive-hero h1 { color: var(--civic-deep); }
  .archive-hero .lead { margin-block-start: .8rem; }
  .archive-heading { margin-block-end: 1.5rem; padding-block-end: 1rem; border-bottom: 2px solid var(--civic-deep); }
  .archive-heading h2 { font-size: clamp(1.3rem, 2.6vw, 1.8rem); }
  .archive-list, .pagination ol { margin: 0; padding: 0; list-style: none; }
  .archive-list { border-top: 1px solid var(--border); }
  .archive-list > li { border-bottom: 1px solid var(--border); }
  .archive-list article { display: grid; grid-template-columns: 10rem minmax(0, 1fr) minmax(7rem, auto); gap: clamp(1rem, 3vw, 2.25rem); align-items: center; padding-block: 1.3rem; }
  .archive-list__image { display: block; overflow: hidden; aspect-ratio: 8 / 5; background: var(--civic); }
  .archive-list__image img { width: 100%; height: 100%; object-fit: cover; transition: transform 250ms ease; }
  .archive-list__image:hover img { transform: scale(1.02); }
  .story-kicker { color: var(--brand); font-size: .74rem; font-weight: 780; letter-spacing: .06em; text-transform: uppercase; }
  html[lang='ne'] .story-kicker { font-size: .86rem; letter-spacing: 0; text-transform: none; }
  .archive-list h3 { margin-block-start: .4rem; font-size: clamp(1.2rem, 2.5vw, 1.7rem); line-height: 1.2; }
  .archive-list h3 a { color: var(--civic-deep); text-decoration: none; }
  .archive-list h3 a:hover { color: var(--brand); }
  .archive-list__content > p:not(.story-kicker) { display: -webkit-box; overflow: hidden; margin-block-start: .5rem; color: var(--text-muted); -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .archive-list time { color: var(--text-soft); font-size: .84rem; font-weight: 650; text-align: end; }
  .pagination { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-block-start: 2rem; }
  .pagination > a { color: var(--civic-deep); font-weight: 750; }
  .pagination ol { display: flex; flex-wrap: wrap; justify-content: center; gap: .35rem; }
  .pagination ol a { display: block; padding: .45rem .65rem; color: var(--civic-deep); font-weight: 700; text-decoration: none; }
  .pagination ol a[aria-current='page'] { background: var(--civic-deep); color: #fff; }
  @media (max-width: 38rem) {
    .archive-list article { grid-template-columns: 1fr; gap: .7rem; }
    .archive-list__image { max-width: 11rem; }
    .archive-list time { text-align: start; }
    .pagination { justify-content: center; }
  }
</style>
