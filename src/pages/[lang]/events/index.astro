---
import {sanityClient} from 'sanity:client'
import EventCard, {type EventCardData} from '../../../components/events/EventCard.astro'
import SiteFooter from '../../../components/SiteFooter.astro'
import SiteHeader from '../../../components/SiteHeader.astro'
import {isSectionEnabled} from '../../../config/languageSections'
import {getTranslations} from '../../../i18n'
import {isSupportedLanguage, type SupportedLanguage} from '../../../i18n/config'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import {expandUpcomingOccurrences} from '../../../lib/eventOccurrences'
import {latestOccurrence} from '../../../lib/eventPresentation'
import {
  PAST_EVENTS_BY_LANGUAGE_QUERY,
  UPCOMING_EVENTS_BY_LANGUAGE_QUERY,
} from '../../../lib/sanity/queries'

export const prerender = false

const {lang} = Astro.params
if (!isSupportedLanguage(lang)) {
  return Astro.redirect('/ne/events/', 302)
}

const language: SupportedLanguage = lang
if (!isSectionEnabled(language, 'events')) {
  return Astro.redirect(`/${language}/`, 302)
}

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=60, stale-while-revalidate=300',
)

const labels = getTranslations(language)
const eventLabels = labels.events
const alternateLanguage: SupportedLanguage = language === 'ne' ? 'nb' : 'ne'

const [fetchedUpcoming, fetchedPast] = await Promise.all([
  sanityClient.fetch<EventCardData[]>(UPCOMING_EVENTS_BY_LANGUAGE_QUERY, {language}),
  sanityClient.fetch<EventCardData[]>(PAST_EVENTS_BY_LANGUAGE_QUERY, {language}),
])

const locale = language === 'ne' ? 'ne-NP' : 'nb-NO'
const eventTimeZone = 'Europe/Oslo'
const now = Date.now()
const currentEventYear = Number(
  new Intl.DateTimeFormat('en', {timeZone: eventTimeZone, year: 'numeric'}).format(new Date(now)),
)

const upcomingEvents = expandUpcomingOccurrences(fetchedUpcoming, now)
const pastEvents = fetchedPast
  .map((event) => latestOccurrence(event))
  .sort(
    (a, b) =>
      new Date(b.endDateTime || b.startDateTime).getTime() -
      new Date(a.endDateTime || a.startDateTime).getTime(),
  )
const recentPastEvents = pastEvents.slice(0, 4)

const categories = eventLabels.categories as Record<string, string>
const availableCategories = Array.from(
  new Set(upcomingEvents.map((event) => event.eventType)),
).map((key) => ({value: key, label: categories[key] ?? key}))
const availableFormats = Array.from(
  new Set(upcomingEvents.map((event) => event.eventFormat)),
)
const formatLabelMap: Record<string, string> = {
  'in-person': eventLabels.inPerson,
  online: eventLabels.online,
  hybrid: eventLabels.hybrid,
}
const hasFreeToggle = upcomingEvents.some((event) => event.isFree === true)
---

<BaseLayout
  language={language}
  title={`${eventLabels.pageTitle} | nepali.no`}
  description={eventLabels.pageDescription}
>
  <SiteHeader
    slot="header"
    language={language}
    alternatePath={`/${alternateLanguage}/events/`}
  />

  <div class="events-hub">
    <header class="events-hero">
      <div class="container events-hero__inner">
        <div class="events-hero__copy">
          <p class="eyebrow">nepali.no</p>
          <h1>{eventLabels.pageTitle}</h1>
          <p class="lead">{eventLabels.pageDescription}</p>
        </div>

        <div class="events-hero__actions">
          <a class="button button-primary" href={`/${language}/events/submit/`}>
            {eventLabels.submitEvent} <span aria-hidden="true">→</span>
          </a>
          <a class="button button-secondary" href={`/${language}/events/past/`}>
            {eventLabels.viewPastEvents}
            {pastEvents.length > 0 && <span class="count-pill">{pastEvents.length}</span>}
          </a>
        </div>
      </div>
    </header>

    <section class="section-sm" aria-labelledby="upcoming-events-heading">
      <div class="container">
        <div class="section-bar">
          <h2 id="upcoming-events-heading">{eventLabels.upcomingHeading}</h2>
          <p class="section-count" data-upcoming-count>
            {eventLabels.eventCount.replace('{count}', String(upcomingEvents.length))}
          </p>
        </div>

        {upcomingEvents.length === 0 ? (
          <div class="empty-state surface">
            <span class="empty-state__rule" aria-hidden="true"></span>
            <h3>{eventLabels.emptyUpcomingHeading}</h3>
            <p>{eventLabels.emptyUpcomingMessage}</p>
            <div class="empty-state__actions">
              <a class="button button-primary" href={`/${language}/events/submit/`}>
                {eventLabels.submitEvent} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        ) : (
          <div data-events-filter-root data-count-template={eventLabels.eventCount}>
            {(availableFormats.length > 1 || availableCategories.length > 1 || hasFreeToggle) && (
              <div class="filter-bar" role="region" aria-label={eventLabels.filterEvents}>
                {availableFormats.length > 1 && (
                  <div class="filter-chips" role="group" aria-label={eventLabels.format}>
                    <button
                      type="button"
                      class="filter-chip is-active"
                      data-filter-format="all"
                      aria-pressed="true"
                    >
                      {eventLabels.allFormats}
                    </button>
                    {availableFormats.map((formatKey) => (
                      <button
                        type="button"
                        class="filter-chip"
                        data-filter-format={formatKey}
                        aria-pressed="false"
                      >
                        {formatLabelMap[formatKey] ?? formatKey}
                      </button>
                    ))}
                  </div>
                )}

                <div class="filter-controls">
                  {availableCategories.length > 1 && (
                    <label class="filter-select">
                      <span class="sr-only">{eventLabels.allCategories}</span>
                      <select data-filter-category>
                        <option value="all">{eventLabels.allCategories}</option>
                        {availableCategories.map((cat) => (
                          <option value={cat.value}>{cat.label}</option>
                        ))}
                      </select>
                    </label>
                  )}

                  {hasFreeToggle && (
                    <label class="filter-toggle">
                      <input type="checkbox" data-filter-free />
                      <span>{eventLabels.freeOnly}</span>
                    </label>
                  )}
                </div>
              </div>
            )}

            <ol class="events-grid" data-events-grid>
              {upcomingEvents.map((event) => (
                <li data-event-item>
                  <EventCard
                    event={event}
                    language={language}
                    eventLabels={eventLabels}
                    locale={locale}
                    timeZone={eventTimeZone}
                    currentYear={currentEventYear}
                    now={now}
                  />
                </li>
              ))}
            </ol>

            <div class="empty-state surface" data-filter-empty hidden>
              <span class="empty-state__rule" aria-hidden="true"></span>
              <p>{eventLabels.noMatchingEvents}</p>
              <div class="empty-state__actions">
                <button type="button" class="button button-secondary" data-filter-reset>
                  {eventLabels.resetFilters}
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </section>

    {recentPastEvents.length > 0 && (
      <section class="section-sm recent-past-section" aria-labelledby="recent-past-heading">
        <div class="container">
          <div class="section-bar">
            <h2 id="recent-past-heading">{eventLabels.recentPastHeading}</h2>
            <a class="section-bar__link" href={`/${language}/events/past/`}>
              {eventLabels.viewPastEvents} ({pastEvents.length}) <span aria-hidden="true">→</span>
            </a>
          </div>

          <ol class="events-grid">
            {recentPastEvents.map((event) => (
              <li>
                <EventCard
                  event={event}
                  language={language}
                  eventLabels={eventLabels}
                  locale={locale}
                  timeZone={eventTimeZone}
                  currentYear={currentEventYear}
                  now={now}
                  pastCard={true}
                />
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}
  </div>

  <SiteFooter slot="footer" language={language} />
</BaseLayout>

<script>
  const initEventFilters = () => {
    const root = document.querySelector<HTMLElement>('[data-events-filter-root]')
    if (!root || root.dataset.initialized === 'true') return
    root.dataset.initialized = 'true'

    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-event-item]'))
    const formatButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter-format]'))
    const categorySelect = root.querySelector<HTMLSelectElement>('[data-filter-category]')
    const freeToggle = root.querySelector<HTMLInputElement>('[data-filter-free]')
    const emptyNotice = root.querySelector<HTMLElement>('[data-filter-empty]')
    const resetButton = root.querySelector<HTMLButtonElement>('[data-filter-reset]')
    const countLabel = document.querySelector<HTMLElement>('[data-upcoming-count]')
    const countTemplate = root.dataset.countTemplate ?? '{count}'

    let activeFormat = 'all'

    const applyFilters = () => {
      const activeCategory = categorySelect?.value ?? 'all'
      const onlyFree = Boolean(freeToggle?.checked)
      let visible = 0

      items.forEach((item) => {
        const card = item.querySelector<HTMLElement>('[data-event-card]')
        if (!card) return
        const matchesFormat = activeFormat === 'all' || card.dataset.eventFormat === activeFormat
        const matchesCategory = activeCategory === 'all' || card.dataset.eventCategory === activeCategory
        const matchesFree = !onlyFree || card.dataset.eventFree === 'true'
        const show = matchesFormat && matchesCategory && matchesFree
        item.hidden = !show
        if (show) visible += 1
      })

      if (emptyNotice) emptyNotice.hidden = visible > 0
      if (countLabel) countLabel.textContent = countTemplate.replace('{count}', String(visible))
    }

    formatButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeFormat = button.dataset.filterFormat ?? 'all'
        formatButtons.forEach((btn) => {
          const isCurrent = btn === button
          btn.classList.toggle('is-active', isCurrent)
          btn.setAttribute('aria-pressed', String(isCurrent))
        })
        applyFilters()
      })
    })

    categorySelect?.addEventListener('change', applyFilters)
    freeToggle?.addEventListener('change', applyFilters)
    resetButton?.addEventListener('click', () => {
      activeFormat = 'all'
      formatButtons.forEach((btn) => {
        const isAll = btn.dataset.filterFormat === 'all'
        btn.classList.toggle('is-active', isAll)
        btn.setAttribute('aria-pressed', String(isAll))
      })
      if (categorySelect) categorySelect.value = 'all'
      if (freeToggle) freeToggle.checked = false
      applyFilters()
    })
  }

  initEventFilters()
  document.addEventListener('astro:page-load', initEventFilters)
</script>

<style>
  .events-hub {
    background: var(--page-bg);
  }

  .events-hero {
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 90% 8%, rgb(198 42 31 / 0.08), transparent 22rem),
      linear-gradient(135deg, #f5f8fb, #ffffff 65%, #fff6f5);
  }

  .events-hero__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    padding-block: clamp(2.25rem, 5vw, 4rem);
  }

  .events-hero__copy {
    max-width: 44rem;
  }

  .events-hero h1 {
    margin-block-start: 0.45rem;
  }

  .events-hero .lead {
    margin-block-start: 0.85rem;
  }

  .events-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .count-pill {
    display: inline-grid;
    min-width: 1.4rem;
    height: 1.4rem;
    padding-inline: 0.35rem;
    place-items: center;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--civic-deep);
    font-size: 0.78rem;
  }

  .section-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block-end: 0.9rem;
    border-bottom: 2px solid var(--civic-deep);
    margin-block-end: 1.5rem;
  }

  .section-bar h2 {
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
  }

  .section-count {
    color: var(--text-soft);
    font-weight: 700;
  }

  .section-bar__link {
    font-weight: 740;
    text-decoration: none;
  }

  .section-bar__link:hover {
    text-decoration: underline;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.25rem;
    margin-block-end: 1.5rem;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .filter-chip {
    min-height: 2.4rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--civic-deep);
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease;
  }

  .filter-chip:hover {
    border-color: var(--civic);
    background: var(--surface-muted);
  }

  .filter-chip.is-active {
    border-color: var(--civic-deep);
    background: var(--civic-deep);
    color: #ffffff;
  }

  .filter-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .filter-select select {
    min-height: 2.4rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--civic-deep);
    font-size: 0.88rem;
    font-weight: 650;
  }

  .filter-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.4rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--civic-deep);
    font-size: 0.88rem;
    font-weight: 650;
    cursor: pointer;
  }

  .filter-toggle input {
    accent-color: var(--brand);
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 1.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .events-grid > li {
    min-width: 0;
  }

  .recent-past-section {
    border-top: 1px solid var(--border);
    background: var(--surface-muted);
  }

  .empty-state {
    padding: clamp(2rem, 6vw, 3.5rem);
    text-align: center;
  }

  .empty-state__rule {
    display: block;
    width: 3rem;
    height: 0.2rem;
    margin: 0 auto 1rem;
    background: var(--brand);
  }

  .empty-state p {
    margin-block-start: 0.55rem;
    color: var(--text-muted);
  }

  .empty-state__actions {
    margin-block-start: 1.25rem;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 52rem) {
    .events-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
