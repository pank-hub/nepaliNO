---
import {PortableText} from 'astro-portabletext'
import {sanityClient} from 'sanity:client'
import SanityPortableImage from '../../../components/SanityPortableImage.astro'
import LocationMap from '../../../components/content/LocationMap.astro'
import TravelHelp from '../../../components/content/TravelHelp.astro'
import SiteFooter from '../../../components/SiteFooter.astro'
import SiteHeader from '../../../components/SiteHeader.astro'
import {isSectionEnabled} from '../../../config/languageSections'
import {getTranslations} from '../../../i18n'
import {isSupportedLanguage, type SupportedLanguage} from '../../../i18n/config'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import {eligibleDestinationCoordinates} from '../../../lib/entur/eligibility'
import {isEnturApiEnabled} from '../../../lib/entur/server/config'
import {getAllDates, nextOccurrence} from '../../../lib/eventOccurrences'
import {
  buildEventIcs,
  formatEventDateRange,
  formatEventTimeRange,
  resolveEventRegistration,
} from '../../../lib/eventPresentation'
import {
  isPublicEventLocation,
  type MapLocation,
  type MapPresentation,
} from '../../../lib/maps/location'
import {isOpenStreetMapUrl} from '../../../lib/maps/publicMapUrl'
import {urlFor} from '../../../lib/sanity/image'
import {EVENT_BY_SLUG_QUERY} from '../../../lib/sanity/queries'

export const prerender = false

interface TranslationSummary {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
}
interface EventImage {
  asset?: unknown
  alt?: string
  caption?: string
  credit?: string
  hotspot?: unknown
  crop?: unknown
}
interface EventDocument {
  _id: string
  title: string
  slug: string
  language: SupportedLanguage
  translation?: TranslationSummary
  summary: string
  _type: 'communityEvent'
  travelHelpEnabled?: boolean
  travelLocation?: unknown
  eventLanguages?: string[]
  otherEventLanguage?: string
  eventType: string
  eventFormat: string
  eventStatus: string
  isAllDay?: boolean
  startDateTime: string
  endDateTime?: string
  additionalDates?: {startDateTime: string; endDateTime?: string}[] | null
  venueName?: string
  address?: string
  postalCode?: string
  city?: string
  mapUrl?: string
  mapLocation?: MapLocation
  mapPresentation?: MapPresentation
  accessibilityInformation?: string
  transportInformation?: string
  onlinePlatform?: string
  onlineUrl?: string
  organizerName: string
  organizerUrl?: string
  organizerEmail?: string
  organizerPhone?: string
  registrationRequirement: string
  registrationStatus: string
  registrationUrl?: string
  registrationDeadline?: string
  isFree?: boolean
  priceNok?: number
  priceDescription?: string
  intendedAudience?: string
  featuredImage?: EventImage
  description?: any[]
  sourceUrl?: string
  lastVerifiedAt: string
}

const {lang, slug} = Astro.params
if (!isSupportedLanguage(lang) || !slug) {
  return Astro.redirect('/ne/events/', 302)
}

const language: SupportedLanguage = lang
if (!isSectionEnabled(language, 'events')) {
  return Astro.redirect(`/${language}/`, 302)
}

const labels = getTranslations(language)
const eventLabels = labels.events
const fetchedEvent = await sanityClient.fetch<EventDocument | null>(EVENT_BY_SLUG_QUERY, {
  language,
  slug,
})
if (!fetchedEvent) {
  return Astro.redirect(`/${language}/events/`, 302)
}

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=60, stale-while-revalidate=300',
)

const alternateLanguage: SupportedLanguage = language === 'ne' ? 'nb' : 'ne'
const activeTranslation =
  fetchedEvent.translation?.slug &&
  fetchedEvent.translation.language === alternateLanguage &&
  isSectionEnabled(alternateLanguage, 'events')
    ? fetchedEvent.translation
    : undefined
const alternatePath = activeTranslation
  ? `/${activeTranslation.language}/events/${activeTranslation.slug}/`
  : `/${alternateLanguage}/events/`

const locale = language === 'ne' ? 'ne-NP' : 'nb-NO'
const eventTimeZone = 'Europe/Oslo'
const now = Date.now()
const event = nextOccurrence(fetchedEvent, now)
const travelDestination = {type: 'communityEvent' as const, id: fetchedEvent._id}
const offerTravelHelp =
  isEnturApiEnabled() &&
  !!eligibleDestinationCoordinates(
    travelDestination,
    {...fetchedEvent, mapLocation: fetchedEvent.travelLocation},
    now,
  )
const allDates = getAllDates(fetchedEvent)
const reg = resolveEventRegistration(event, eventLabels, now)

const formatDate = (value: string) =>
  new Date(value).toLocaleDateString(locale, {
    timeZone: eventTimeZone,
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })

const formats: Record<string, string> = {
  'in-person': eventLabels.inPerson,
  online: eventLabels.online,
  hybrid: eventLabels.hybrid,
}
const categories = eventLabels.categories as Record<string, string>
const statuses = eventLabels.statuses as Record<string, string>
const languages = eventLabels.languages as Record<string, string>

const heroUrl = event.featuredImage?.asset
  ? urlFor(event.featuredImage as any).width(1600).height(900).fit('crop').auto('format').url()
  : null
const socialImageUrl = event.featuredImage?.asset
  ? urlFor(event.featuredImage as any).width(1200).height(630).fit('crop').auto('format').url()
  : undefined
const portableTextComponents = {type: {image: SanityPortableImage}}

const spokenLanguages = [
  ...(event.eventLanguages || []).map((value) => languages[value] ?? value),
  ...(event.otherEventLanguage ? [event.otherEventLanguage] : []),
].join(', ')
const address = [event.address, event.postalCode, event.city].filter(Boolean).join(', ')
const publicMapLocation = isPublicEventLocation(event.eventFormat) ? event.mapLocation : undefined
const mapDescription =
  [event.venueName, address || event.city].filter(Boolean).join(', ') || eventLabels.venue
const mapTitle = event.mapPresentation?.title?.trim()
const additionalMapTitle = mapTitle && ![event.venueName?.trim(), address, mapDescription, eventLabels.venue].includes(mapTitle) ? mapTitle : undefined
const mapUrl = isOpenStreetMapUrl(event.mapUrl) ? undefined : event.mapUrl
const priceLabel = event.isFree
  ? eventLabels.freeEvent
  : event.priceDescription ||
    (typeof event.priceNok === 'number' ? `${event.priceNok} NOK` : eventLabels.paidEvent)

const startDate = new Date(event.startDateTime)
const dateCardDay = new Intl.DateTimeFormat(locale, {
  timeZone: eventTimeZone,
  day: '2-digit',
}).format(startDate)
const dateCardMonth = new Intl.DateTimeFormat(locale, {
  timeZone: eventTimeZone,
  month: 'short',
}).format(startDate)
const dateCardYear = new Intl.DateTimeFormat(locale, {
  timeZone: eventTimeZone,
  year: 'numeric',
}).format(startDate)

const isMultiDay = allDates.length > 1
const spanStart = isMultiDay ? allDates[0].startDateTime : event.startDateTime
const spanEnd = isMultiDay
  ? allDates[allDates.length - 1].endDateTime || allDates[allDates.length - 1].startDateTime
  : event.endDateTime
const dateRangeText = formatEventDateRange(
  spanStart,
  spanEnd,
  locale,
  eventTimeZone,
)
const timeRangeText = isMultiDay
  ? eventLabels.multiDayCount.replace('{count}', String(allDates.length))
  : formatEventTimeRange(
      event.startDateTime,
      event.endDateTime,
      event.isAllDay,
      locale,
      eventTimeZone,
      eventLabels.allDay,
    )

const canonicalEventUrl = new URL(`/${language}/events/${event.slug}/`, Astro.site ?? 'https://nepali.no').toString()
const calendarHref =
  !reg.isPast && event.eventStatus !== 'cancelled'
    ? `data:text/calendar;charset=utf-8,${encodeURIComponent(buildEventIcs(fetchedEvent, canonicalEventUrl))}`
    : undefined

const hasPracticalInfo = Boolean(
  event.accessibilityInformation || event.transportInformation || event.intendedAudience || spokenLanguages,
)
const hasOrganizerContact = Boolean(event.organizerUrl || event.organizerEmail || event.organizerPhone)
---

<BaseLayout
  language={language}
  title={`${event.title} | nepali.no`}
  description={event.summary}
  socialImage={socialImageUrl}
  socialImageAlt={event.featuredImage?.alt || event.title}
>
  <SiteHeader slot="header" language={language} alternatePath={alternatePath} />

  <article class="event-page">
    <header class="event-stage">
      <div class="container event-stage__inner">
        <nav class="breadcrumbs" aria-label={eventLabels.pageTitle}>
          <a href={`/${language}/`}>{labels.navigation.home}</a>
          <span aria-hidden="true">/</span>
          <a href={`/${language}/events/`}>{eventLabels.pageTitle}</a>
        </nav>

        <div class="event-pills">
          {!reg.isPast && reg.isOngoing && (
            <strong class="ev-pill ev-pill--live">{eventLabels.ongoing}</strong>
          )}
          {reg.isPast && <strong class="ev-pill ev-pill--past">{eventLabels.completed}</strong>}
          {event.eventStatus !== 'scheduled' && (
            <strong class:list={['ev-pill', `ev-pill--${event.eventStatus}`]}>
              {statuses[event.eventStatus] ?? event.eventStatus}
            </strong>
          )}
          <span class="ev-pill">{categories[event.eventType] ?? event.eventType}</span>
          <span class="ev-pill">{formats[event.eventFormat] ?? event.eventFormat}</span>
          {event.isFree === true && (
            <span class="ev-pill ev-pill--free">{eventLabels.freeEvent}</span>
          )}
        </div>

        <div class="event-split">
          <div class="event-split__primary">
            <h1>{event.title}</h1>
            <p class="lead">{event.summary}</p>

            <p class="event-byline">
              <span>{eventLabels.organizer}:</span>
              {event.organizerUrl ? (
                <a href={event.organizerUrl} target="_blank" rel="noopener noreferrer">
                  {event.organizerName} <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <strong>{event.organizerName}</strong>
              )}
            </p>

            {heroUrl && (
              <figure class="event-poster">
                <img
                  src={heroUrl}
                  alt={event.featuredImage?.alt ?? ''}
                  width="1600"
                  height="900"
                  decoding="async"
                />
                {(event.featuredImage?.caption || event.featuredImage?.credit) && (
                  <figcaption>
                    {event.featuredImage?.caption && <span>{event.featuredImage.caption}</span>}
                    {event.featuredImage?.credit && <span>{event.featuredImage.credit}</span>}
                  </figcaption>
                )}
              </figure>
            )}
          </div>

          <aside class="event-action-card surface" aria-label={eventLabels.eventDetails}>
            <div class="event-action-card__head">
              <time class="event-date-badge" datetime={event.startDateTime}>
                <span class="event-date-badge__month">{dateCardMonth}</span>
                <strong>{dateCardDay}</strong>
                <span class="event-date-badge__year">{dateCardYear}</span>
              </time>

              <div>
                <p class="event-action-card__date">{dateRangeText}</p>
                <p class="event-action-card__time">{timeRangeText}</p>
              </div>
            </div>

            <dl class="event-facts">
              {allDates.length > 1 && (
                <div>
                  <dt>{eventLabels.dailySchedule}</dt>
                  <dd>
                    <ul class="event-all-dates">
                      {allDates.map((d) => (
                        <li>
                          <time datetime={d.startDateTime}>
                            {formatEventDateRange(d.startDateTime, d.endDateTime, locale, eventTimeZone)}
                            {' · '}
                            {formatEventTimeRange(
                              d.startDateTime,
                              d.endDateTime,
                              event.isAllDay,
                              locale,
                              eventTimeZone,
                              eventLabels.allDay,
                            )}
                          </time>
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}

              <div>
                <dt>{eventLabels.format}</dt>
                <dd>{formats[event.eventFormat] ?? event.eventFormat}</dd>
              </div>

              {(event.venueName || address) && (
                <div>
                  <dt>{eventLabels.venue}</dt>
                  <dd>
                    {event.venueName && <strong>{event.venueName}</strong>}
                    {event.venueName && address && <br />}
                    {address}
                  </dd>
                </div>
              )}

              {(event.onlinePlatform || event.onlineUrl) && (
                <div>
                  <dt>{eventLabels.onlineAccess}</dt>
                  <dd>
                    {event.onlinePlatform && <span>{event.onlinePlatform}</span>}
                    {event.onlinePlatform && event.onlineUrl && <br />}
                    {event.onlineUrl && (
                      <a href={event.onlineUrl} target="_blank" rel="noopener noreferrer">
                        {eventLabels.joinOnline} <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </dd>
                </div>
              )}

              <div>
                <dt>{eventLabels.price}</dt>
                <dd>{priceLabel}</dd>
              </div>

              {reg.needsAction && (
                <div>
                  <dt>{reg.sectionLabel}</dt>
                  <dd>
                    {reg.requirementLabel}
                    <span class="reg-status-line">{reg.statusLabel}</span>
                    {event.registrationDeadline && (
                      <span class="reg-deadline-line">
                        {eventLabels.registrationDeadline}:{' '}
                        <time datetime={event.registrationDeadline}>
                          {formatDate(event.registrationDeadline)}
                        </time>
                      </span>
                    )}
                  </dd>
                </div>
              )}
            </dl>

            <div class="event-action-card__ctas">
              {reg.canRegister && (
                <a
                  class="button button-primary"
                  href={event.registrationUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {reg.actionLabel} <span aria-hidden="true">↗</span>
                </a>
              )}

              {event.onlineUrl && !reg.isPast && event.eventStatus !== 'cancelled' && (
                <a
                  class="button button-secondary"
                  href={event.onlineUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {eventLabels.joinOnline} <span aria-hidden="true">↗</span>
                </a>
              )}

              {calendarHref && (
                <a
                  class="button button-secondary"
                  href={calendarHref}
                  download={`${event.slug}.ics`}
                >
                  {eventLabels.addToCalendar}
                </a>
              )}

              {mapUrl && (
                <a
                  class="button button-secondary"
                  href={mapUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {eventLabels.openMap} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>

            {reg.canRegister && (
              <p class="event-action-card__notice">{eventLabels.externalRegistrationNotice}</p>
            )}
          </aside>
        </div>
      </div>
    </header>

    <div class="container event-sections">
      <div class="event-details-grid">
        <section class="event-description surface" aria-labelledby="event-about-heading">
          <h2 id="event-about-heading">{eventLabels.aboutEvent}</h2>
          {event.description && event.description.length > 0 && (
            <div class="prose">
              <PortableText value={event.description} components={portableTextComponents} />
            </div>
          )}

          {event.sourceUrl && (
            <aside class="source-note">
              <div>
                <strong>{eventLabels.originalSource}</strong>
                <p>
                  {eventLabels.lastVerified}:{' '}
                  <time datetime={event.lastVerifiedAt}>{formatDate(event.lastVerifiedAt)}</time>
                </p>
              </div>
              <a
                class="button button-secondary"
                href={event.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {eventLabels.originalSource} <span aria-hidden="true">↗</span>
              </a>
            </aside>
          )}
        </section>

        <div class="event-meta-column">
          {hasPracticalInfo && (
            <section class="info-card surface" aria-labelledby="practical-info-heading">
              <h2 id="practical-info-heading">{eventLabels.practicalInfo}</h2>
              <dl class="info-list">
                {spokenLanguages && (
                  <div>
                    <dt>{eventLabels.eventLanguages}</dt>
                    <dd>{spokenLanguages}</dd>
                  </div>
                )}
                {event.intendedAudience && (
                  <div>
                    <dt>{eventLabels.intendedAudience}</dt>
                    <dd>{event.intendedAudience}</dd>
                  </div>
                )}
                {event.accessibilityInformation && (
                  <div>
                    <dt>{eventLabels.accessibility}</dt>
                    <dd>{event.accessibilityInformation}</dd>
                  </div>
                )}
                {event.transportInformation && (
                  <div>
                    <dt>{eventLabels.transport}</dt>
                    <dd>{event.transportInformation}</dd>
                  </div>
                )}
              </dl>
            </section>
          )}

          <section class="info-card surface" aria-labelledby="organizer-card-heading">
            <h2 id="organizer-card-heading">{eventLabels.organizer}</h2>
            <dl class="info-list">
              <div>
                <dt>{eventLabels.organizer}</dt>
                <dd>
                  {event.organizerUrl ? (
                    <a href={event.organizerUrl} target="_blank" rel="noopener noreferrer">
                      {event.organizerName} <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    event.organizerName
                  )}
                </dd>
              </div>
              {(event.organizerEmail || event.organizerPhone) && (
                <div>
                  <dt>{eventLabels.contact}</dt>
                  <dd>
                    {event.organizerEmail && (
                      <a href={`mailto:${event.organizerEmail}`}>{event.organizerEmail}</a>
                    )}
                    {event.organizerEmail && event.organizerPhone && <br />}
                    {event.organizerPhone && (
                      <a href={`tel:${event.organizerPhone}`}>{event.organizerPhone}</a>
                    )}
                  </dd>
                </div>
              )}
              {!hasOrganizerContact && !event.sourceUrl && (
                <div>
                  <dt>{eventLabels.lastVerified}</dt>
                  <dd>
                    <time datetime={event.lastVerifiedAt}>{formatDate(event.lastVerifiedAt)}</time>
                  </dd>
                </div>
              )}
            </dl>
          </section>

          {activeTranslation && (
            <a class="translation-card surface" href={alternatePath} hreflang={activeTranslation.language}>
              <span>{eventLabels.translation}</span>
              <strong>{activeTranslation.title}</strong>
            </a>
          )}
        </div>
      </div>

      {publicMapLocation && (
        <section class="event-location-section surface" aria-labelledby="location-travel-heading">
          <div class="event-location-section__head">
            <h2 id="location-travel-heading">{eventLabels.locationAndTravel}</h2>
            {(event.venueName || address) && (
              <p class="event-location-section__address">
                {[event.venueName, address].filter(Boolean).join(' · ')}
              </p>
            )}
          </div>

          <div class:list={['event-location-grid', {'event-location-grid--with-travel': offerTravelHelp}]}>
            <LocationMap
              location={publicMapLocation}
              description={mapDescription}
              labels={labels.common.maps}
              title={additionalMapTitle}
              markerLabel={event.mapPresentation?.markerLabel || event.venueName || eventLabels.venue}
              markerIcon={event.mapPresentation?.markerIcon}
              markerShowLabel={event.mapPresentation?.markerShowLabel}
              caption={event.mapPresentation?.caption}
              editorialPath={event.mapPresentation?.editorialPath}
              mapStyle={event.mapPresentation?.mapStyle ?? 'city'}
              showNorwayLocator={event.mapPresentation?.showNorwayLocator}
              loadingBehavior="automatic"
              contextSidebar={false}
              language={language}
              showFullscreenControl={true}
            />

            {offerTravelHelp && (
              <div class="event-travel-box">
                <TravelHelp destination={travelDestination} language={language} defaultOpen={true} />
              </div>
            )}
          </div>
        </section>
      )}
    </div>
  </article>

  <SiteFooter slot="footer" language={language} />
</BaseLayout>

<style>
  .event-page {
    min-width: 0;
    background: var(--page-bg);
  }

  .event-stage {
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 92% 4%, rgb(198 42 31 / 0.08), transparent 22rem),
      linear-gradient(135deg, #f5f8fb, #ffffff 62%, #fff6f5);
  }

  .event-stage__inner {
    padding-block: clamp(1.75rem, 4vw, 3rem) clamp(2.25rem, 5vw, 3.5rem);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: var(--text-soft);
    font-size: 0.85rem;
  }

  .breadcrumbs a {
    color: var(--civic);
    font-weight: 650;
  }

  .event-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-block-start: 1.2rem;
  }

  .ev-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    background: var(--surface);
    color: var(--civic-deep);
    font-size: 0.78rem;
    font-weight: 720;
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .ev-pill--live {
    background: #dcfce7;
    color: #14532d;
    box-shadow: none;
  }

  .ev-pill--free {
    background: #ecfdf3;
    color: #027a48;
    box-shadow: none;
  }

  .ev-pill--past {
    background: #eef2f6;
    color: #475569;
    box-shadow: none;
  }

  .ev-pill--cancelled {
    background: #fde8e6;
    color: #9e281f;
    box-shadow: none;
  }

  .ev-pill--postponed,
  .ev-pill--rescheduled {
    background: #fff2cc;
    color: #6f5200;
    box-shadow: none;
  }

  .event-split {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(19rem, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    margin-block-start: 1.15rem;
  }

  .event-split__primary {
    min-width: 0;
  }

  .event-split__primary h1 {
    font-size: clamp(2rem, 4.2vw, 3.35rem);
    line-height: 1.12;
  }

  .event-split__primary .lead {
    margin-block-start: 0.9rem;
    max-width: 48rem;
  }

  .event-byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 1rem;
    color: var(--text-muted);
    font-size: 0.96rem;
  }

  .event-byline a,
  .event-byline strong {
    color: var(--civic-deep);
    font-weight: 720;
  }

  .event-poster {
    margin-block-start: 1.35rem;
  }

  .event-poster img {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    object-fit: cover;
    box-shadow: var(--shadow-soft);
  }

  .event-poster figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block-start: 0.55rem;
    color: var(--text-soft);
    font-size: 0.82rem;
  }

  .event-action-card {
    padding: clamp(1.25rem, 3vw, 1.65rem);
    border-block-start: 0.28rem solid var(--brand);
  }

  .event-action-card__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block-end: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .event-date-badge {
    display: grid;
    min-width: 4.5rem;
    padding: 0.55rem 0.6rem;
    place-items: center;
    border: 1px solid var(--border);
    border-block-start: 0.25rem solid var(--brand);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    color: var(--civic-deep);
    flex-shrink: 0;
  }

  .event-date-badge__month {
    color: var(--brand);
    font-size: 0.74rem;
    font-weight: 780;
    text-transform: uppercase;
  }

  html[lang='ne'] .event-date-badge__month {
    font-size: 0.8rem;
    text-transform: none;
  }

  .event-date-badge strong {
    font-size: 1.85rem;
    line-height: 1.05;
  }

  .event-date-badge__year {
    color: var(--text-soft);
    font-size: 0.74rem;
    font-weight: 700;
  }

  .event-action-card__date {
    color: var(--civic-deep);
    font-size: 1.05rem;
    font-weight: 760;
    line-height: 1.35;
  }

  .event-action-card__time {
    color: var(--text-muted);
    font-size: 0.94rem;
