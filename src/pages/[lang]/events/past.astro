---
import {sanityClient} from 'sanity:client'
import EventCard, {type EventCardData} from '../../../components/events/EventCard.astro'
import SiteFooter from '../../../components/SiteFooter.astro'
import SiteHeader from '../../../components/SiteHeader.astro'
import {isSectionEnabled} from '../../../config/languageSections'
import {getTranslations} from '../../../i18n'
import {isSupportedLanguage, type SupportedLanguage} from '../../../i18n/config'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import {latestOccurrence} from '../../../lib/eventPresentation'
import {PAST_EVENTS_BY_LANGUAGE_QUERY} from '../../../lib/sanity/queries'

export const prerender = false

const {lang} = Astro.params
if (!isSupportedLanguage(lang)) {
  return Astro.redirect('/ne/events/past/', 302)
}

const language: SupportedLanguage = lang
if (!isSectionEnabled(language, 'events')) {
  return Astro.redirect(`/${language}/`, 302)
}

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=60, stale-while-revalidate=300',
)

const labels = getTranslations(language)
const eventLabels = labels.events
const alternateLanguage: SupportedLanguage = language === 'ne' ? 'nb' : 'ne'

const fetchedEvents = await sanityClient.fetch<EventCardData[]>(
  PAST_EVENTS_BY_LANGUAGE_QUERY,
  {language},
)

const locale = language === 'ne' ? 'ne-NP' : 'nb-NO'
const eventTimeZone = 'Europe/Oslo'
const now = Date.now()
const currentEventYear = Number(
  new Intl.DateTimeFormat('en', {timeZone: eventTimeZone, year: 'numeric'}).format(new Date(now)),
)

const events = fetchedEvents
  .map((event) => latestOccurrence(event))
  .sort(
    (a, b) =>
      new Date(b.endDateTime || b.startDateTime).getTime() -
      new Date(a.endDateTime || a.startDateTime).getTime(),
  )
---

<BaseLayout
  language={language}
  title={`${eventLabels.pastHeading} | nepali.no`}
  description={eventLabels.pageDescription}
>
  <SiteHeader
    slot="header"
    language={language}
    alternatePath={`/${alternateLanguage}/events/past/`}
  />

  <div class="past-events-page">
    <header class="past-hero">
      <div class="container past-hero__inner">
        <div>
          <nav class="breadcrumbs" aria-label={eventLabels.pageTitle}>
            <a href={`/${language}/`}>{labels.navigation.home}</a>
            <span aria-hidden="true">/</span>
            <a href={`/${language}/events/`}>{eventLabels.pageTitle}</a>
          </nav>
          <h1>{eventLabels.pastHeading}</h1>
        </div>

        <div class="past-hero__actions">
          <a class="button button-primary" href={`/${language}/events/submit/`}>
            {eventLabels.submitEvent} <span aria-hidden="true">→</span>
          </a>
          <a class="button button-secondary" href={`/${language}/events/`}>
            ← {eventLabels.viewUpcomingEvents}
          </a>
        </div>
      </div>
    </header>

    <section class="section-sm" aria-labelledby="past-archive-heading">
      <div class="container">
        <div class="section-bar">
          <h2 id="past-archive-heading">{eventLabels.pastHeading}</h2>
          <p class="section-count">
            {eventLabels.eventCount.replace('{count}', String(events.length))}
          </p>
        </div>

        {events.length === 0 ? (
          <div class="empty-state surface">
            <span class="empty-state__rule" aria-hidden="true"></span>
            <h3>{eventLabels.emptyPastHeading}</h3>
            <p>{eventLabels.emptyPastMessage}</p>
          </div>
        ) : (
          <ol class="events-grid">
            {events.map((event) => (
              <li>
                <EventCard
                  event={event}
                  language={language}
                  eventLabels={eventLabels}
                  locale={locale}
                  timeZone={eventTimeZone}
                  currentYear={currentEventYear}
                  now={now}
                  pastCard={true}
                />
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>
  </div>

  <SiteFooter slot="footer" language={language} />
</BaseLayout>

<style>
  .past-events-page {
    background: var(--page-bg);
  }

  .past-hero {
    border-bottom: 1px solid var(--border);
    background: var(--surface-muted);
  }

  .past-hero__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    padding-block: clamp(2.25rem, 5vw, 4rem);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: var(--text-soft);
    font-size: 0.85rem;
  }

  .breadcrumbs a {
    color: var(--civic);
    font-weight: 650;
  }

  .past-hero h1 {
    margin-block-start: 0.5rem;
  }

  .past-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .section-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-block-end: 1.5rem;
    padding-block-end: 0.9rem;
    border-bottom: 2px solid var(--civic-deep);
  }

  .section-bar h2 {
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
  }

  .section-count {
    color: var(--text-soft);
    font-weight: 700;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 1.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .events-grid > li {
    min-width: 0;
  }

  .empty-state {
    padding: clamp(2.5rem, 7vw, 4.5rem);
    text-align: center;
  }

  .empty-state__rule {
    display: block;
    width: 3rem;
    height: 0.2rem;
    margin: 0 auto 1rem;
    background: var(--brand);
  }

  .empty-state p {
    margin-block-start: 0.55rem;
    color: var(--text-muted);
  }

  @media (max-width: 52rem) {
    .events-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
