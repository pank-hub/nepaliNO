---
// TEMPORARY Preview acceptance fixture for PR #112. Delete before merge, together with the
// Preview-only override in src/lib/entur/server/destination.ts.
export const prerender = false

import BaseLayout from '../../layouts/BaseLayout.astro'
import TravelHelp from '../../components/content/TravelHelp.astro'
import {PREVIEW_ACCEPTANCE_DESTINATION_ID} from '../../lib/entur/server/destination'

if (import.meta.env.VERCEL_ENV !== 'preview') return new Response(null, {status: 404})
---
<BaseLayout language="ne" title="Entur acceptance fixture" description="Temporary Preview acceptance fixture" noIndex>
  <div class="container" style="padding-block: 2rem">
    <h1>Entur acceptance fixture (temporary, Preview only)</h1>
    <p>
      This temporary page exists only on Vercel Preview deployments to exercise the real Entur
      endpoints against a fixed public destination (Oslo S). It must be removed before PR #112 is merged.
    </p>
    <TravelHelp destination={{type: 'directoryListing', id: PREVIEW_ACCEPTANCE_DESTINATION_ID}} language="ne" />

    <!-- TEMPORARY (PR #112): controlled rate-limit probe; remove before merge. -->
    <section data-temporary-rate-limit-probe style="margin-top: 2rem; border-top: 1px solid #ccc; padding-top: 1rem">
      <h2>Temporary controlled rate-limit test</h2>
      <p>
        Sends up to 21 sequential POST requests to /api/entur/origins with the query "Oslo S", only after
        you click, and stops at the first HTTP 429. It starts only 5-25 s into a clock minute so the burst
        cannot cross a 60-second rate-limit window boundary. Recovery is available once Retry-After has elapsed.
      </p>
      <button type="button" class="probe-button" data-probe="run">Run controlled origin rate-limit test</button>
      <button type="button" class="probe-button" data-probe="recover" disabled>Test recovery</button>
      <p data-probe="window-status" aria-live="polite"></p>
      <p data-probe="summary" aria-live="polite"></p>
      <ol data-probe="log"></ol>
      <p data-probe="first-429"></p>
      <p data-probe="retry-after"></p>
      <p data-probe="recovery-result" aria-live="polite"></p>
    </section>
  </div>
</BaseLayout>

<style>
  /* TEMPORARY (PR #112): visible buttons for the acceptance probe. */
  .probe-button {
    display: inline-block;
    margin: 0.25rem 0.5rem 0.25rem 0;
    padding: 0.6rem 1.1rem;
    border: 2px solid #1a4f8b;
    border-radius: 0.4rem;
    background: #1a4f8b;
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .probe-button:hover:not(:disabled) {
    background: #123a68;
  }
  .probe-button:focus-visible {
    outline: 3px solid #f5a623;
    outline-offset: 2px;
  }
  .probe-button:disabled {
    background: #e6e6e6;
    border-color: #999;
    color: #555;
    cursor: not-allowed;
  }
</style>

<script>
  // TEMPORARY (PR #112): wires the probe above; nothing runs until a button is clicked.
  import {mountRateLimitProbe} from '../../lib/entur/previewAcceptance/rateLimitProbe'

  const root = document.querySelector('[data-temporary-rate-limit-probe]')
  if (root) mountRateLimitProbe(root, (input, init) => fetch(input, init))
</script>
