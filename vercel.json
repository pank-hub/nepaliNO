{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/ne/info/topic/norwegian-language-and-integration(%20.*| .*)",
      "destination": "/ne/info/topic/norwegian-language-and-integration/",
      "permanent": true
    },
    {
      "source": "/ne/info/topic/digital-sewa-ra-online-suraksha(%20| )(/?)",
      "destination": "/ne/info/topic/digital-sewa-ra-online-suraksha/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/dev/(.*)",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]
    }
  ],
  "rewrites": [
    {
      "source": "/content",
      "destination": "/index.html"
    },
    {
      "source": "/content/",
      "destination": "/index.html"
    },
    {
      "source": "/content/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/event-moderation",
      "destination": "/index.html"
    },
    {
      "source": "/event-moderation/",
      "destination": "/index.html"
    },
    {
      "source": "/event-moderation/:path*",
      "destination": "/index.html"
    }
  ]
}
